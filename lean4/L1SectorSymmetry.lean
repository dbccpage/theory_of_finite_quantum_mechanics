import Mathlib.Data.Matrix.Basic
import Mathlib.Data.Matrix.Mul
import Mathlib.Data.Fin.VecNotation
import Mathlib.LinearAlgebra.Matrix.DotProduct
import Mathlib.Logic.Equiv.Basic
import Mathlib.Tactic.FinCases
import Mathlib.Tactic.Ring
import Mathlib.Tactic.Linarith
import Mathlib.Tactic.NormNum
import Mathlib.Algebra.BigOperators.Fin

/-!
# L1 Sector Symmetry Law (Target L1-IMP-SECTOR-SYMMETRY-LAW)

**AuthorityEffect:** None.

## Mathematical Content
Target Statement:
"Transitive sector symmetry of the quadratic readout: relabelling sectors by any
permutation in a set whose generated group acts transitively does not change the
readout. This is the second law under which the inner product is selected up to
scale; it is supplied, not derived from primitive difference, and sectors with
distinguished labels would break it (then the diagonal is constant only on orbits)."

## Outcome: Narrowed (the symmetry law itself is a hypothesis here, not weakened or derived)
The selection theorem below takes uniqueness of the inner product up to scale from
two supplied laws on the quadratic readout `qf G x = x ⬝ᵥ (G *ᵥ x)`:
1. `SectorAdditive G`: additivity on disjoint sector supports forces all off-diagonal
   entries of a symmetric Gram matrix to vanish (`G i j = 0` for `i ≠ j`).
2. `Invariant G σ` for all permutations in a set `S` whose generated group acts
   transitively on sectors forces all diagonal entries to be equal (`G i i = G j j`).

Together, these two laws select `G = c • 1` (where `c = G i₀ i₀`), so `qf G x = c * (x ⬝ᵥ x)`.
When sectors have distinguished labels that break transitivity:
- Invariance under `S` guarantees that the diagonal is constant on each orbit of `Generated S` (`diag_const_on_orbit`).
- But across distinct orbits, diagonal entries can differ arbitrarily. Countermodels on 2 and 3
  sectors (`diag12` on `Fin 2` and `G_dist3 = diag(1, 1, 2)` on `Fin 3`) show that
  distinguished sector labels break the selection of the inner product (`G ≠ c • 1`).
- Similarly, transitive symmetry without sector additivity (`unif12 = 1 + J`) allows cross-sector
  interference and fails scalar uniqueness.
-/

namespace L1SectorSymmetry

open Matrix

variable {n : ℕ}

/-! ### Carrier, quadratic readout, and sector additivity -/

/-- Bilinear pairing of Gram matrix `G`. -/
def pair (G : Matrix (Fin n) (Fin n) ℚ) (x y : Fin n → ℚ) : ℚ := x ⬝ᵥ (G *ᵥ y)

/-- Quadratic readout of Gram matrix `G`. -/
def qf (G : Matrix (Fin n) (Fin n) ℚ) (x : Fin n → ℚ) : ℚ := x ⬝ᵥ (G *ᵥ x)

theorem pair_self (G : Matrix (Fin n) (Fin n) ℚ) (x : Fin n → ℚ) : pair G x x = qf G x := rfl

/-- Disjoint support: no sector carries both `u` and `v`. -/
def DisjointSupport (u v : Fin n → ℚ) : Prop := ∀ k, u k = 0 ∨ v k = 0

/-- Sector additivity of quadratic readout on disjoint supports. -/
def SectorAdditive (G : Matrix (Fin n) (Fin n) ℚ) : Prop :=
  ∀ u v, DisjointSupport u v → qf G (u + v) = qf G u + qf G v

/-! ### Sector permutation action and group generation -/

/-- Coordinate permutation action on vectors: `(permute σ x) i = x (σ.symm i)`. -/
def permute (σ : Equiv.Perm (Fin n)) (x : Fin n → ℚ) : Fin n → ℚ := fun i => x (σ.symm i)

/-- Invariance of the quadratic readout under sector permutation `σ`. -/
def Invariant (G : Matrix (Fin n) (Fin n) ℚ) (σ : Equiv.Perm (Fin n)) : Prop :=
  ∀ x, qf G (permute σ x) = qf G x

/-- Set `S` of permutations acts transitively on sectors. -/
def TransitiveOn (S : Set (Equiv.Perm (Fin n))) : Prop :=
  ∀ i j : Fin n, i ≠ j → ∃ σ ∈ S, σ i = j

/-- Group generated by a set `S` of sector permutations. -/
inductive Generated (S : Set (Equiv.Perm (Fin n))) : Equiv.Perm (Fin n) → Prop
  | of {σ : Equiv.Perm (Fin n)} (h : σ ∈ S) : Generated S σ
  | one : Generated S 1
  | mul {σ τ : Equiv.Perm (Fin n)} (hσ : Generated S σ) (hτ : Generated S τ) : Generated S (σ * τ)
  | inv {σ : Equiv.Perm (Fin n)} (hσ : Generated S σ) : Generated S σ⁻¹

/-- Sectors `i` and `j` lie in the same orbit of the group generated by `S`. -/
def InSameOrbit (S : Set (Equiv.Perm (Fin n))) (i j : Fin n) : Prop :=
  ∃ σ : Equiv.Perm (Fin n), Generated S σ ∧ σ i = j

theorem permute_one (x : Fin n → ℚ) : permute (1 : Equiv.Perm (Fin n)) x = x := by
  funext i
  rfl

theorem permute_mul (σ τ : Equiv.Perm (Fin n)) (x : Fin n → ℚ) :
    permute (σ * τ) x = permute σ (permute τ x) := by
  funext i
  simp only [permute, Equiv.Perm.mul_def, Equiv.symm_trans_apply]

theorem permute_inv_left (σ : Equiv.Perm (Fin n)) (x : Fin n → ℚ) :
    permute σ⁻¹ (permute σ x) = x := by
  funext i
  simp only [permute, Equiv.Perm.inv_def, Equiv.symm_symm, Equiv.symm_apply_apply]

theorem permute_inv_right (σ : Equiv.Perm (Fin n)) (x : Fin n → ℚ) :
    permute σ (permute σ⁻¹ x) = x := by
  have := permute_inv_left σ⁻¹ x
  rwa [inv_inv] at this

theorem invariant_one (G : Matrix (Fin n) (Fin n) ℚ) : Invariant G 1 := fun x => by
  rw [permute_one]

theorem invariant_mul {G : Matrix (Fin n) (Fin n) ℚ} {σ τ : Equiv.Perm (Fin n)}
    (hσ : Invariant G σ) (hτ : Invariant G τ) : Invariant G (σ * τ) := fun x => by
  rw [permute_mul, hσ, hτ]

theorem invariant_inv {G : Matrix (Fin n) (Fin n) ℚ} {σ : Equiv.Perm (Fin n)}
    (hσ : Invariant G σ) : Invariant G σ⁻¹ := fun x => by
  have h := hσ (permute σ⁻¹ x)
  rw [permute_inv_right] at h
  exact h.symm

theorem invariant_of_generated {G : Matrix (Fin n) (Fin n) ℚ} {S : Set (Equiv.Perm (Fin n))}
    (hS : ∀ σ ∈ S, Invariant G σ) {σ : Equiv.Perm (Fin n)} (h : Generated S σ) : Invariant G σ := by
  induction h with
  | of hm => exact hS _ hm
  | one => exact invariant_one G
  | mul _ _ ih₁ ih₂ => exact invariant_mul ih₁ ih₂
  | inv _ ih => exact invariant_inv ih

/-! ### Unit vectors and diagonal readout -/

theorem qf_add_vec (G : Matrix (Fin n) (Fin n) ℚ) (u v : Fin n → ℚ) :
    qf G (u + v) = qf G u + pair G u v + pair G v u + qf G v := by
  simp only [qf, pair, mulVec_add, dotProduct_add, add_dotProduct]
  ring

theorem mulVec_single_one' (G : Matrix (Fin n) (Fin n) ℚ) (j : Fin n) :
    G *ᵥ Pi.single j 1 = fun i => G i j := by
  funext i
  simp [Matrix.mulVec, dotProduct_single]

theorem pair_single_single (G : Matrix (Fin n) (Fin n) ℚ) (i j : Fin n) :
    pair G (Pi.single i 1) (Pi.single j 1) = G i j := by
  rw [pair, mulVec_single_one', single_dotProduct, one_mul]

theorem qf_single (G : Matrix (Fin n) (Fin n) ℚ) (i : Fin n) : qf G (Pi.single i 1) = G i i :=
  pair_single_single G i i

theorem permute_single (σ : Equiv.Perm (Fin n)) (j : Fin n) :
    permute σ (Pi.single j (1 : ℚ)) = Pi.single (σ j) 1 := by
  funext i
  simp only [permute, Pi.single_apply, Equiv.symm_apply_eq]

theorem diag_eq_of_invariant {G : Matrix (Fin n) (Fin n) ℚ} {σ : Equiv.Perm (Fin n)}
    (h : Invariant G σ) (j : Fin n) : G (σ j) (σ j) = G j j := by
  have := h (Pi.single j 1)
  rwa [permute_single, qf_single, qf_single] at this

/-! ### Diagonal constancy on orbits vs across transitive sets -/

/-- When G is invariant under a set S of permutations, its diagonal entries are constant on each
orbit of the generated group. -/
theorem diag_const_on_orbit {G : Matrix (Fin n) (Fin n) ℚ} {S : Set (Equiv.Perm (Fin n))}
    (hS : ∀ σ ∈ S, Invariant G σ) {i j : Fin n} (horb : InSameOrbit S i j) :
    G i i = G j j := by
  rcases horb with ⟨σ, hσ, rfl⟩
  have hinv : Invariant G σ := invariant_of_generated hS hσ
  exact (diag_eq_of_invariant hinv i).symm

theorem inSameOrbit_of_transitive_generated {S : Set (Equiv.Perm (Fin n))}
    (hT : TransitiveOn (Generated S)) (i j : Fin n) : InSameOrbit S i j := by
  by_cases hij : i = j
  · subst hij
    exact ⟨1, Generated.one, rfl⟩
  · obtain ⟨σ, hσ, rfl⟩ := hT i j hij
    exact ⟨σ, hσ, rfl⟩

theorem transitive_generated_of_transitive {S : Set (Equiv.Perm (Fin n))}
    (hT : TransitiveOn S) : TransitiveOn (Generated S) := by
  intro i j hij
  obtain ⟨σ, hσ, hmap⟩ := hT i j hij
  exact ⟨σ, Generated.of hσ, hmap⟩

/-- If the group generated by `S` acts transitively, all diagonal entries of `G` are equal. -/
theorem diag_const_of_transitive_generated {G : Matrix (Fin n) (Fin n) ℚ} {S : Set (Equiv.Perm (Fin n))}
    (hS : ∀ σ ∈ S, Invariant G σ) (hT : TransitiveOn (Generated S)) (i j : Fin n) :
    G i i = G j j :=
  diag_const_on_orbit hS (inSameOrbit_of_transitive_generated hT i j)

/-- If `S` acts transitively, all diagonal entries of `G` are equal. -/
theorem diag_const_of_transitive {G : Matrix (Fin n) (Fin n) ℚ} {S : Set (Equiv.Perm (Fin n))}
    (hS : ∀ σ ∈ S, Invariant G σ) (hT : TransitiveOn S) (i j : Fin n) :
    G i i = G j j :=
  diag_const_of_transitive_generated hS (transitive_generated_of_transitive hT) i j

/-! ### Sector additivity forces an orthogonal sector basis -/

theorem disjoint_single_single {i j : Fin n} (h : i ≠ j) :
    DisjointSupport (Pi.single i (1 : ℚ)) (Pi.single j 1) := by
  intro k
  by_cases hk : k = i
  · right
    subst hk
    exact Pi.single_eq_of_ne h 1
  · left
    exact Pi.single_eq_of_ne hk 1

theorem offdiag_pair_sum_eq_zero {G : Matrix (Fin n) (Fin n) ℚ} (hG : SectorAdditive G)
    {i j : Fin n} (h : i ≠ j) : G i j + G j i = 0 := by
  have := hG _ _ (disjoint_single_single h)
  rw [qf_add_vec, pair_single_single, pair_single_single] at this
  linarith

theorem transpose_entry {G : Matrix (Fin n) (Fin n) ℚ} (hs : Gᵀ = G) (i j : Fin n) :
    G i j = G j i := by
  simpa [Matrix.transpose_apply] using congrFun (congrFun hs j) i

theorem offdiag_eq_zero {G : Matrix (Fin n) (Fin n) ℚ} (hs : Gᵀ = G) (hG : SectorAdditive G)
    {i j : Fin n} (h : i ≠ j) : G i j = 0 := by
  have h1 := offdiag_pair_sum_eq_zero hG h
  have h2 := transpose_entry hs i j
  linarith

/-! ### Selection of the inner product up to scale -/

/-- Main theorem (on generated group): symmetric, sector-additive, invariant under a set `S`
whose generated group acts transitively implies `G = c • 1`. -/
theorem eq_smul_one_generated {G : Matrix (Fin n) (Fin n) ℚ} {S : Set (Equiv.Perm (Fin n))}
    (hs : Gᵀ = G) (hA : SectorAdditive G) (hS : ∀ σ ∈ S, Invariant G σ)
    (hT : TransitiveOn (Generated S)) (i₀ : Fin n) :
    G = G i₀ i₀ • (1 : Matrix (Fin n) (Fin n) ℚ) := by
  ext i j
  by_cases h : i = j
  · subst h
    rw [Matrix.smul_apply, Matrix.one_apply_eq, smul_eq_mul, mul_one]
    exact diag_const_of_transitive_generated hS hT i i₀
  · rw [Matrix.smul_apply, Matrix.one_apply_ne h, smul_zero]
    exact offdiag_eq_zero hs hA h

/-- Main theorem: symmetric, sector-additive, invariant under a transitive set `S` of sector
permutations implies `G = c • 1`. -/
theorem eq_smul_one {G : Matrix (Fin n) (Fin n) ℚ} {S : Set (Equiv.Perm (Fin n))}
    (hs : Gᵀ = G) (hA : SectorAdditive G) (hS : ∀ σ ∈ S, Invariant G σ)
    (hT : TransitiveOn S) (i₀ : Fin n) :
    G = G i₀ i₀ • (1 : Matrix (Fin n) (Fin n) ℚ) :=
  eq_smul_one_generated hs hA hS (transitive_generated_of_transitive hT) i₀

theorem qf_smul (c : ℚ) (A : Matrix (Fin n) (Fin n) ℚ) (x : Fin n → ℚ) :
    qf (c • A) x = c * qf A x := by
  unfold qf
  rw [Matrix.smul_mulVec, dotProduct_smul, smul_eq_mul]

theorem qf_one (x : Fin n → ℚ) : qf (1 : Matrix (Fin n) (Fin n) ℚ) x = x ⬝ᵥ x := by
  unfold qf
  rw [Matrix.one_mulVec]

/-- The quadratic readout is selected up to scale as the standard Euclidean norm squared. -/
theorem qf_eq_scale_dot {G : Matrix (Fin n) (Fin n) ℚ} {S : Set (Equiv.Perm (Fin n))}
    (hs : Gᵀ = G) (hA : SectorAdditive G) (hS : ∀ σ ∈ S, Invariant G σ)
    (hT : TransitiveOn S) (i₀ : Fin n) (x : Fin n → ℚ) :
    qf G x = G i₀ i₀ * (x ⬝ᵥ x) := by
  have hG := eq_smul_one hs hA hS hT i₀
  calc qf G x = qf (G i₀ i₀ • (1 : Matrix (Fin n) (Fin n) ℚ)) x := by rw [← hG]
    _ = G i₀ i₀ * (x ⬝ᵥ x) := by rw [qf_smul, qf_one]

theorem pair_smul_one (c : ℚ) (x y : Fin n → ℚ) :
    pair (c • (1 : Matrix (Fin n) (Fin n) ℚ)) x y = c * (x ⬝ᵥ y) := by
  rw [pair, Matrix.smul_mulVec, Matrix.one_mulVec, dotProduct_smul, smul_eq_mul]

/-- The bilinear pairing is selected up to scale as the standard dot product. -/
theorem pair_eq_scale_dot {G : Matrix (Fin n) (Fin n) ℚ} {S : Set (Equiv.Perm (Fin n))}
    (hs : Gᵀ = G) (hA : SectorAdditive G) (hS : ∀ σ ∈ S, Invariant G σ)
    (hT : TransitiveOn S) (i₀ : Fin n) (x y : Fin n → ℚ) :
    pair G x y = G i₀ i₀ * (x ⬝ᵥ y) := by
  have hG := eq_smul_one hs hA hS hT i₀
  calc pair G x y = pair (G i₀ i₀ • (1 : Matrix (Fin n) (Fin n) ℚ)) x y := by rw [← hG]
    _ = G i₀ i₀ * (x ⬝ᵥ y) := pair_smul_one _ x y

/-- Any two such forms are proportional. -/
theorem unique_up_to_scale {G G' : Matrix (Fin n) (Fin n) ℚ} {S : Set (Equiv.Perm (Fin n))}
    (hs : Gᵀ = G) (hA : SectorAdditive G) (hS : ∀ σ ∈ S, Invariant G σ)
    (hs' : G'ᵀ = G') (hA' : SectorAdditive G') (hS' : ∀ σ ∈ S, Invariant G' σ)
    (hT : TransitiveOn S) (i₀ : Fin n) (h0 : G i₀ i₀ ≠ 0) :
    G' = (G' i₀ i₀ / G i₀ i₀) • G := by
  have hG := eq_smul_one hs hA hS hT i₀
  have hG' := eq_smul_one hs' hA' hS' hT i₀
  calc G' = G' i₀ i₀ • (1 : Matrix (Fin n) (Fin n) ℚ) := hG'
    _ = (G' i₀ i₀ / G i₀ i₀) • (G i₀ i₀ • (1 : Matrix (Fin n) (Fin n) ℚ)) := by
        rw [smul_smul, div_mul_cancel₀ _ h0]
    _ = (G' i₀ i₀ / G i₀ i₀) • G := by rw [← hG]

/-! ### Diagonal forms and sector additivity -/

theorem qf_diagonal (d : Fin n → ℚ) (x : Fin n → ℚ) :
    qf (Matrix.diagonal d) x = ∑ i, d i * x i ^ 2 := by
  simp only [qf, dotProduct, mulVec_diagonal]
  refine Finset.sum_congr rfl (fun i _ => ?_)
  ring

theorem pair_diagonal_eq_zero_of_disjoint (d : Fin n → ℚ) {u v : Fin n → ℚ}
    (h : DisjointSupport u v) : pair (Matrix.diagonal d) u v = 0 := by
  simp only [pair, dotProduct, mulVec_diagonal]
  refine Finset.sum_eq_zero (fun i _ => ?_)
  rcases h i with hu | hv
  · rw [hu, zero_mul]
  · rw [hv, mul_zero, mul_zero]

theorem diagonal_sectorAdditive (d : Fin n → ℚ) : SectorAdditive (Matrix.diagonal d) := by
  intro u v h
  rw [qf_add_vec, pair_diagonal_eq_zero_of_disjoint d h,
    pair_diagonal_eq_zero_of_disjoint d (fun k => (h k).symm)]
  ring

/-! ### Countermodel 1: Distinguished sector labels on Fin 2 break uniqueness -/

/-- `diag(1, 2)` on two sectors. -/
def diag12 : Matrix (Fin 2) (Fin 2) ℚ := Matrix.diagonal ![1, 2]

theorem diag12_transpose : diag12ᵀ = diag12 := Matrix.diagonal_transpose _

theorem diag12_sectorAdditive : SectorAdditive diag12 := diagonal_sectorAdditive _

/-- Trivial permutation set: sector labels 0 and 1 are distinguished, so no exchange is allowed. -/
def S_empty_2 : Set (Equiv.Perm (Fin 2)) := ∅

theorem generated_empty (σ : Equiv.Perm (Fin n)) (h : Generated ∅ σ) : σ = 1 := by
  induction h with
  | of hm => contradiction
  | one => rfl
  | mul _ _ ih₁ ih₂ => rw [ih₁, ih₂, mul_one]
  | inv _ ih => rw [ih, inv_one]

theorem orbit_empty_2 (i j : Fin 2) : InSameOrbit S_empty_2 i j ↔ i = j := by
  constructor
  · rintro ⟨σ, hσ, rfl⟩
    rw [generated_empty σ hσ]
    rfl
  · rintro rfl
    exact ⟨1, Generated.one, rfl⟩

/-- The diagonal is constant on each orbit (here, singleton orbits). -/
theorem diag12_const_on_orbits :
    ∀ i j : Fin 2, InSameOrbit S_empty_2 i j → diag12 i i = diag12 j j := by
  intro i j hij
  rw [orbit_empty_2] at hij
  rw [hij]

theorem diag12_not_scalar (c : ℚ) : diag12 ≠ c • (1 : Matrix (Fin 2) (Fin 2) ℚ) := by
  intro h
  have h0 := congrFun (congrFun h 0) 0
  have h1 := congrFun (congrFun h 1) 1
  simp [diag12] at h0 h1
  linarith

/-- When sector labels are distinguished, `diag(1, 2)` satisfies sector additivity, symmetry,
and invariance under the distinguished symmetry set, but fails to be a scalar multiple of identity. -/
theorem distinguished_labels_break_uniqueness_2 :
    SectorAdditive diag12 ∧ diag12ᵀ = diag12 ∧
    (∀ σ ∈ S_empty_2, Invariant diag12 σ) ∧
    (∀ c : ℚ, diag12 ≠ c • (1 : Matrix (Fin 2) (Fin 2) ℚ)) :=
  ⟨diag12_sectorAdditive, diag12_transpose, fun _ h => False.elim h, diag12_not_scalar⟩

/-! ### Countermodel 2: Distinguished sector label on Fin 3 (orbits {0,1} and {2}) -/

/-- `diag(1, 1, 2)` on three sectors: sectors 0 and 1 have equivalent labels, sector 2 is distinguished. -/
def G_dist3 : Matrix (Fin 3) (Fin 3) ℚ := Matrix.diagonal ![1, 1, 2]

theorem G_dist3_transpose : G_dist3ᵀ = G_dist3 := Matrix.diagonal_transpose _

theorem G_dist3_sectorAdditive : SectorAdditive G_dist3 := diagonal_sectorAdditive _

/-- The swap of sectors 0 and 1 in `Fin 3`. -/
def swap01_3 : Equiv.Perm (Fin 3) := Equiv.swap 0 1

def S_dist3 : Set (Equiv.Perm (Fin 3)) := {swap01_3}

theorem permute_swap01_3_0 (x : Fin 3 → ℚ) : permute swap01_3 x 0 = x 1 := by
  simp [permute, swap01_3, Equiv.symm_swap, Equiv.swap_apply_left]

theorem permute_swap01_3_1 (x : Fin 3 → ℚ) : permute swap01_3 x 1 = x 0 := by
  simp [permute, swap01_3, Equiv.symm_swap, Equiv.swap_apply_right]

theorem permute_swap01_3_2 (x : Fin 3 → ℚ) : permute swap01_3 x 2 = x 2 := by
  simp [permute, swap01_3, Equiv.symm_swap]
  have hne0 : (2 : Fin 3) ≠ 0 := by decide
  have hne1 : (2 : Fin 3) ≠ 1 := by decide
  rw [Equiv.swap_apply_of_ne_of_ne hne0 hne1]

theorem G_dist3_qf (x : Fin 3 → ℚ) :
    qf G_dist3 x = x 0 ^ 2 + x 1 ^ 2 + 2 * x 2 ^ 2 := by
  rw [G_dist3, qf_diagonal, Fin.sum_univ_three]
  simp

theorem G_dist3_invariant_swap01 : Invariant G_dist3 swap01_3 := by
  intro x
  rw [G_dist3_qf, G_dist3_qf, permute_swap01_3_0, permute_swap01_3_1, permute_swap01_3_2]
  ring

theorem G_dist3_invariant_S : ∀ σ ∈ S_dist3, Invariant G_dist3 σ := by
  intro σ hσ
  have h : σ = swap01_3 := hσ
  subst h
  exact G_dist3_invariant_swap01

theorem G_dist3_orbit_01 : InSameOrbit S_dist3 0 1 :=
  ⟨swap01_3, Generated.of rfl, Equiv.swap_apply_left 0 1⟩

theorem G_dist3_diag_01 : G_dist3 0 0 = G_dist3 1 1 := by
  simp [G_dist3]

theorem G_dist3_diag_02_ne : G_dist3 0 0 ≠ G_dist3 2 2 := by
  simp [G_dist3]

theorem G_dist3_not_scalar (c : ℚ) : G_dist3 ≠ c • (1 : Matrix (Fin 3) (Fin 3) ℚ) := by
  intro h
  have h0 := congrFun (congrFun h 0) 0
  have h2 := congrFun (congrFun h 2) 2
  simp [G_dist3] at h0 h2
  linarith

/-- On three sectors where sectors 0 and 1 are invariant under swap but sector 2 is distinguished:
the diagonal is constant on orbit {0, 1} (`G 0 0 = G 1 1`), but distinct from orbit {2}
(`G 0 0 ≠ G 2 2`), breaking uniqueness (`G ≠ c • 1`). -/
theorem distinguished_labels_break_uniqueness_3 :
    SectorAdditive G_dist3 ∧ G_dist3ᵀ = G_dist3 ∧
    (∀ σ ∈ S_dist3, Invariant G_dist3 σ) ∧
    G_dist3 0 0 = G_dist3 1 1 ∧
    G_dist3 0 0 ≠ G_dist3 2 2 ∧
    (∀ c : ℚ, G_dist3 ≠ c • (1 : Matrix (Fin 3) (Fin 3) ℚ)) :=
  ⟨G_dist3_sectorAdditive, G_dist3_transpose, G_dist3_invariant_S,
   G_dist3_diag_01, G_dist3_diag_02_ne, G_dist3_not_scalar⟩

/-! ### Countermodel 3: Transitive symmetry without sector additivity fails uniqueness -/

/-- `1 + (all ones)` on two sectors. -/
def unif12 : Matrix (Fin 2) (Fin 2) ℚ := 1 + Matrix.of (fun _ _ => (1 : ℚ))

theorem unif12_apply (i j : Fin 2) : unif12 i j = (if i = j then 1 else 0) + 1 := by
  simp [unif12, Matrix.add_apply, Matrix.one_apply]

theorem unif12_transpose : unif12ᵀ = unif12 := by
  ext i j
  rw [Matrix.transpose_apply, unif12_apply, unif12_apply]
  by_cases h : i = j
  · subst h
    rfl
  · simp [h, Ne.symm h]

theorem permute_swap_zero (x : Fin 2 → ℚ) : permute (Equiv.swap 0 1) x 0 = x 1 := by
  simp [permute, Equiv.symm_swap, Equiv.swap_apply_left]

theorem permute_swap_one (x : Fin 2 → ℚ) : permute (Equiv.swap 0 1) x 1 = x 0 := by
  simp [permute, Equiv.symm_swap, Equiv.swap_apply_right]

theorem qf_eq_sum_sum (A : Matrix (Fin n) (Fin n) ℚ) (x : Fin n → ℚ) :
    qf A x = ∑ i, ∑ j, A i j * x i * x j := by
  simp only [qf, dotProduct, mulVec, Finset.mul_sum]
  refine Finset.sum_congr rfl (fun i _ => ?_)
  refine Finset.sum_congr rfl (fun j _ => ?_)
  ring

theorem unif12_qf (x : Fin 2 → ℚ) :
    qf unif12 x = x 0 * x 0 + x 1 * x 1 + (x 0 + x 1) * (x 0 + x 1) := by
  rw [qf_eq_sum_sum, Fin.sum_univ_two, Fin.sum_univ_two, Fin.sum_univ_two]
  simp only [unif12_apply]
  norm_num
  ring

def S₂ : Set (Equiv.Perm (Fin 2)) := {Equiv.swap 0 1}

theorem S₂_transitive : TransitiveOn S₂ := by
  intro i j hij
  fin_cases i <;> fin_cases j
  · exact absurd rfl hij
  · exact ⟨Equiv.swap 0 1, rfl, Equiv.swap_apply_left 0 1⟩
  · exact ⟨Equiv.swap 0 1, rfl, Equiv.swap_apply_right 0 1⟩
  · exact absurd rfl hij

theorem unif12_invariant : ∀ σ ∈ S₂, Invariant unif12 σ := by
  intro σ hσ x
  have h : σ = Equiv.swap 0 1 := hσ
  subst h
  rw [unif12_qf, unif12_qf, permute_swap_zero, permute_swap_one]
  ring

theorem unif12_not_sectorAdditive : ¬ SectorAdditive unif12 := by
  intro h
  have := h _ _ (disjoint_single_single (show (0 : Fin 2) ≠ 1 by decide))
  rw [qf_add_vec, pair_single_single, pair_single_single, qf_single, qf_single] at this
  simp [unif12_apply] at this

theorem unif12_not_scalar (c : ℚ) : unif12 ≠ c • (1 : Matrix (Fin 2) (Fin 2) ℚ) := by
  intro h
  have h01 := congrFun (congrFun h 0) 1
  simp [unif12_apply] at h01

end L1SectorSymmetry

