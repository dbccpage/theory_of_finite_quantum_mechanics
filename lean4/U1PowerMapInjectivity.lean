import Mathlib.Tactic.Ring
import Mathlib.Tactic.Linarith
import Mathlib.Tactic.NormNum
import Mathlib.Data.Rat.Lemmas

/-!
# U(1) Power-Map Injectivity and Infinite Order of the Pythagorean Generator `(3/5, 4/5)`

This module establishes the exact arithmetic and group-theoretic properties of the powers
of the Gaussian integer `3 + 4i` and the corresponding rational unit-circle element
`u = (3/5, 4/5) ∈ S¹(ℚ)`:

1. **Gaussian Integer Power Recurrence (`gaussPow34`)**:
   Defines `(3 + 4i)^n` in `ℤ × ℤ` and proves the norm law
   `(gaussPow34 n).1 ^ 2 + (gaussPow34 n).2 ^ 2 = (5 : ℤ) ^ (2 * n) = ((5 : ℤ) ^ n) ^ 2`.
2. **Universal Mod-5 Idempotence Invariant**:
   In `ℤ[i] / 5ℤ[i]`, `(3 + 4i)^2 = -7 + 24i ≡ 3 + 4i (mod 5)`. By induction, for every
   `n ≥ 1`, `(gaussPow34 n).1 % 5 = 3` and `(gaussPow34 n).2 % 5 = 4`. Consequently, neither
   coordinate is ever divisible by `5` or equal to `0` for `n ≥ 1`.
3. **Addition Law and Power-Map Injectivity (`u345NatPow`, `u345IntPow`)**:
   Proves the homomorphism law `u345NatPow (m + n) = cmul (u345NatPow m) (u345NatPow n)`,
   the unit-circle invariant `(u345IntPow k).1 ^ 2 + (u345IntPow k).2 ^ 2 = 1`, and the
   injectivity of both `u345NatPow : ℕ → ℚ × ℚ` and `u345IntPow : ℤ → ℚ × ℚ`, certifying that
   the cyclic subgroup generated by `(3/5, 4/5)` in `S¹(ℚ)` is infinite and torsion-free.
-/

namespace U1Fable.PowerMapInjectivity

-- ============================================================================
-- § 1. Gaussian Integer Power Recurrence for (3 + 4i)^n
-- ============================================================================

/-- Exact integer coordinates of `(3 + 4i)^n` in `ℤ × ℤ`. -/
def gaussPow34 : ℕ → ℤ × ℤ
  | 0 => (1, 0)
  | n + 1 =>
    (3 * (gaussPow34 n).1 - 4 * (gaussPow34 n).2,
     4 * (gaussPow34 n).1 + 3 * (gaussPow34 n).2)

theorem gaussPow34_zero : gaussPow34 0 = (1, 0) := rfl

theorem gaussPow34_one : gaussPow34 1 = (3, 4) := rfl

theorem gaussPow34_two : gaussPow34 2 = (-7, 24) := rfl

theorem gaussPow34_three : gaussPow34 3 = (-117, 44) := rfl

/-- Squared-norm identity `re((3+4i)^n)^2 + im((3+4i)^n)^2 = (5^n)^2`. -/
theorem gaussPow34_norm_sq (n : ℕ) :
    (gaussPow34 n).1 ^ 2 + (gaussPow34 n).2 ^ 2 = ((5 : ℤ) ^ n) ^ 2 := by
  induction n with
  | zero => rfl
  | succ m ih =>
    calc
      (gaussPow34 (m + 1)).1 ^ 2 + (gaussPow34 (m + 1)).2 ^ 2
          = (3 * (gaussPow34 m).1 - 4 * (gaussPow34 m).2) ^ 2 +
            (4 * (gaussPow34 m).1 + 3 * (gaussPow34 m).2) ^ 2 := rfl
      _ = 25 * ((gaussPow34 m).1 ^ 2 + (gaussPow34 m).2 ^ 2) := by ring
      _ = 25 * ((5 : ℤ) ^ m) ^ 2 := by rw [ih]
      _ = ((5 : ℤ) ^ m * 5) ^ 2 := by ring
      _ = ((5 : ℤ) ^ (m + 1)) ^ 2 := by rw [pow_succ (5 : ℤ) m]

/-- Norm law `re((3+4i)^n)^2 + im((3+4i)^n)^2 = 5^(2n)`. -/
theorem gaussPow34_norm (n : ℕ) :
    (gaussPow34 n).1 ^ 2 + (gaussPow34 n).2 ^ 2 = (5 : ℤ) ^ (2 * n) := by
  rw [gaussPow34_norm_sq, mul_comm, pow_mul]

-- ============================================================================
-- § 2. Universal Mod-5 Idempotence Invariant for (3 + 4i)^n (n ≥ 1)
-- ============================================================================

/-- Universal mod-5 invariant: for every `n : ℕ`, `(3 + 4i)^(n + 1) ≡ 3 + 4i (mod 5)`. -/
theorem gaussPow34_succ_mod_five (n : ℕ) :
    (gaussPow34 (n + 1)).1 % 5 = 3 ∧ (gaussPow34 (n + 1)).2 % 5 = 4 := by
  induction n with
  | zero => decide
  | succ m ih =>
    rcases ih with ⟨ih1, ih2⟩
    change (3 * (gaussPow34 (m + 1)).1 - 4 * (gaussPow34 (m + 1)).2) % 5 = 3 ∧
      (4 * (gaussPow34 (m + 1)).1 + 3 * (gaussPow34 (m + 1)).2) % 5 = 4
    omega

/-- Mod-5 invariant stated for positive exponents `0 < n`. -/
theorem gaussPow34_mod_five_of_pos (n : ℕ) (hn : 0 < n) :
    (gaussPow34 n).1 % 5 = 3 ∧ (gaussPow34 n).2 % 5 = 4 := by
  cases n with
  | zero => omega
  | succ m => exact gaussPow34_succ_mod_five m

/-- For `n > 0`, the real part of `(3 + 4i)^n` is never zero. -/
theorem gaussPow34_re_ne_zero_of_pos (n : ℕ) (hn : 0 < n) :
    (gaussPow34 n).1 ≠ 0 := by
  have h := (gaussPow34_mod_five_of_pos n hn).1
  omega

/-- For `n > 0`, the imaginary part of `(3 + 4i)^n` is never zero. -/
theorem gaussPow34_im_ne_zero_of_pos (n : ℕ) (hn : 0 < n) :
    (gaussPow34 n).2 ≠ 0 := by
  have h := (gaussPow34_mod_five_of_pos n hn).2
  omega

/-- For `n > 0`, `5` never divides the real part of `(3 + 4i)^n`. -/
theorem gaussPow34_re_not_dvd_five_of_pos (n : ℕ) (hn : 0 < n) :
    ¬ ((5 : ℤ) ∣ (gaussPow34 n).1) := by
  have h := (gaussPow34_mod_five_of_pos n hn).1
  rintro ⟨k, hk⟩
  omega

/-- For `n > 0`, `5` never divides the imaginary part of `(3 + 4i)^n`. -/
theorem gaussPow34_im_not_dvd_five_of_pos (n : ℕ) (hn : 0 < n) :
    ¬ ((5 : ℤ) ∣ (gaussPow34 n).2) := by
  have h := (gaussPow34_mod_five_of_pos n hn).2
  rintro ⟨k, hk⟩
  omega

-- ============================================================================
-- § 3. Addition Law and Rational Circle Power Injectivity
-- ============================================================================

/-- Gaussian integer multiplication on `ℤ × ℤ`. -/
def gmul (z w : ℤ × ℤ) : ℤ × ℤ :=
  (z.1 * w.1 - z.2 * w.2, z.1 * w.2 + z.2 * w.1)

/-- Gaussian integer conjugation on `ℤ × ℤ`. -/
def gconj (z : ℤ × ℤ) : ℤ × ℤ :=
  (z.1, -z.2)

/-- Addition law for `gaussPow34`: `(3 + 4i)^(m + n) = (3 + 4i)^m * (3 + 4i)^n`. -/
theorem gaussPow34_add (m n : ℕ) :
    gaussPow34 (m + n) = gmul (gaussPow34 m) (gaussPow34 n) := by
  induction n with
  | zero =>
    ext <;> simp [gaussPow34, gmul]
  | succ k ih =>
    rw [Nat.add_succ]
    ext <;> simp only [gaussPow34, ih, gmul] <;> ring

/-- Natural-number powers of `u = (3/5, 4/5)` in `ℚ × ℚ`. -/
def u345NatPow (n : ℕ) : ℚ × ℚ :=
  ((gaussPow34 n).1 / (5 : ℚ) ^ n, (gaussPow34 n).2 / (5 : ℚ) ^ n)

/-- Integer powers of `u = (3/5, 4/5)` in `ℚ × ℚ`. -/
def u345IntPow : ℤ → ℚ × ℚ
  | Int.ofNat n => u345NatPow n
  | Int.negSucc n =>
    ((gaussPow34 (n + 1)).1 / (5 : ℚ) ^ (n + 1),
     -((gaussPow34 (n + 1)).2 / (5 : ℚ) ^ (n + 1)))

/-- Alias for `u345IntPow`. -/
def u345Pow (k : ℤ) : ℚ × ℚ := u345IntPow k

/-- Complex multiplication on `ℚ × ℚ`. -/
def cmul (z w : ℚ × ℚ) : ℚ × ℚ :=
  (z.1 * w.1 - z.2 * w.2, z.1 * w.2 + z.2 * w.1)

/-- Complex conjugation on `ℚ × ℚ`. -/
def cconj (z : ℚ × ℚ) : ℚ × ℚ :=
  (z.1, -z.2)

theorem cmul_assoc (a b c : ℚ × ℚ) :
    cmul (cmul a b) c = cmul a (cmul b c) := by
  ext <;> simp [cmul] <;> ring

theorem cmul_one_left (z : ℚ × ℚ) :
    cmul (1, 0) z = z := by
  ext <;> simp [cmul]

theorem cmul_one_right (z : ℚ × ℚ) :
    cmul z (1, 0) = z := by
  ext <;> simp [cmul]

theorem cconj_involutive (z : ℚ × ℚ) :
    cconj (cconj z) = z := by
  ext <;> simp [cconj]

theorem cmul_cconj_self_of_unit (z : ℚ × ℚ) (hz : z.1 ^ 2 + z.2 ^ 2 = 1) :
    cmul (cconj z) z = (1, 0) := by
  ext
  · calc
      (cmul (cconj z) z).1 = z.1 * z.1 - (-z.2) * z.2 := rfl
      _ = z.1 ^ 2 + z.2 ^ 2 := by ring
      _ = 1 := hz
  · calc
      (cmul (cconj z) z).2 = z.1 * z.2 + (-z.2) * z.1 := rfl
      _ = 0 := by ring

/-- Every natural power `u345NatPow n` lies on the rational unit circle `S¹(ℚ)`. -/
theorem u345NatPow_unit (n : ℕ) :
    (u345NatPow n).1 ^ 2 + (u345NatPow n).2 ^ 2 = 1 := by
  have h5 : (5 : ℚ) ^ n ≠ 0 := pow_ne_zero n (by norm_num)
  have h5sq : ((5 : ℚ) ^ n) ^ 2 ≠ 0 := pow_ne_zero 2 h5
  have hnorm : ((gaussPow34 n).1 : ℚ) ^ 2 + ((gaussPow34 n).2 : ℚ) ^ 2 = ((5 : ℚ) ^ n) ^ 2 := by
    exact_mod_cast gaussPow34_norm_sq n
  calc
    (u345NatPow n).1 ^ 2 + (u345NatPow n).2 ^ 2
        = (((gaussPow34 n).1 : ℚ) / (5 : ℚ) ^ n) ^ 2 +
          (((gaussPow34 n).2 : ℚ) / (5 : ℚ) ^ n) ^ 2 := rfl
    _ = (((gaussPow34 n).1 : ℚ) ^ 2 + ((gaussPow34 n).2 : ℚ) ^ 2) / ((5 : ℚ) ^ n) ^ 2 := by ring
    _ = ((5 : ℚ) ^ n) ^ 2 / ((5 : ℚ) ^ n) ^ 2 := by rw [hnorm]
    _ = 1 := div_self h5sq

/-- Every integer power `u345IntPow k` lies on the rational unit circle `S¹(ℚ)`. -/
theorem u345IntPow_unit (k : ℤ) :
    (u345IntPow k).1 ^ 2 + (u345IntPow k).2 ^ 2 = 1 := by
  cases k with
  | ofNat n => exact u345NatPow_unit n
  | negSucc n =>
    calc
      (u345IntPow (Int.negSucc n)).1 ^ 2 + (u345IntPow (Int.negSucc n)).2 ^ 2
          = (u345NatPow (n + 1)).1 ^ 2 + (-(u345NatPow (n + 1)).2) ^ 2 := rfl
      _ = (u345NatPow (n + 1)).1 ^ 2 + (u345NatPow (n + 1)).2 ^ 2 := by ring
      _ = 1 := u345NatPow_unit (n + 1)

/-- No positive natural power of `(3/5, 4/5)` equals the identity `(1, 0)`. -/
theorem u345NatPow_ne_one_of_pos (n : ℕ) (hn : 0 < n) :
    u345NatPow n ≠ (1, 0) := by
  intro h
  have h2 : (u345NatPow n).2 = 0 := congrArg Prod.snd h
  dsimp [u345NatPow] at h2
  have h5 : (5 : ℚ) ^ n ≠ 0 := pow_ne_zero n (by norm_num)
  have him_q : ((gaussPow34 n).2 : ℚ) = 0 := (div_eq_zero_iff.mp h2).resolve_right h5
  have him_z : (gaussPow34 n).2 = 0 := by exact_mod_cast him_q
  exact gaussPow34_im_ne_zero_of_pos n hn him_z

/-- Homomorphism law for natural powers: `u^(m + n) = u^m * u^n`. -/
theorem u345NatPow_add (m n : ℕ) :
    u345NatPow (m + n) = cmul (u345NatPow m) (u345NatPow n) := by
  have h1 : (gaussPow34 (m + n)).1 =
      (gaussPow34 m).1 * (gaussPow34 n).1 - (gaussPow34 m).2 * (gaussPow34 n).2 :=
    congrArg Prod.fst (gaussPow34_add m n)
  have h2 : (gaussPow34 (m + n)).2 =
      (gaussPow34 m).1 * (gaussPow34 n).2 + (gaussPow34 m).2 * (gaussPow34 n).1 :=
    congrArg Prod.snd (gaussPow34_add m n)
  ext <;>
    simp only [u345NatPow, cmul, h1, h2, pow_add, Int.cast_sub, Int.cast_add, Int.cast_mul] <;>
    ring

/-- Helper: if `m ≤ n` and `u345NatPow m = u345NatPow n`, then `m = n`. -/
theorem u345NatPow_eq_of_le {m n : ℕ} (hmn : m ≤ n) (h : u345NatPow m = u345NatPow n) :
    m = n := by
  obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hmn
  rcases Nat.eq_zero_or_pos d with rfl | hd
  · omega
  · exfalso
    have hmul : cmul (cconj (u345NatPow m)) (u345NatPow (m + d)) =
        cmul (cconj (u345NatPow m)) (u345NatPow m) := by
      rw [← h]
    rw [u345NatPow_add, ← cmul_assoc,
        cmul_cconj_self_of_unit (u345NatPow m) (u345NatPow_unit m),
        cmul_one_left] at hmul
    exact u345NatPow_ne_one_of_pos d hd hmul

/-- The natural-number power map `n ↦ (3/5 + 4/5 i)^n` is injective. -/
theorem u345NatPow_injective : Function.Injective u345NatPow := by
  intro m n h
  rcases le_total m n with hmn | hnm
  · exact u345NatPow_eq_of_le hmn h
  · exact (u345NatPow_eq_of_le hnm h.symm).symm

/-- Negative integer powers are complex conjugates of positive natural powers. -/
theorem u345IntPow_negSucc (n : ℕ) :
    u345IntPow (Int.negSucc n) = cconj (u345NatPow (n + 1)) := rfl

/-- Helper: a natural power and a negative integer power can never coincide. -/
theorem u345NatPow_ne_negSucc (m n : ℕ) :
    u345NatPow m ≠ u345IntPow (Int.negSucc n) := by
  intro h
  rw [u345IntPow_negSucc] at h
  have hmul : cmul (u345NatPow m) (u345NatPow (n + 1)) =
      cmul (cconj (u345NatPow (n + 1))) (u345NatPow (n + 1)) := by
    rw [← h]
  rw [← u345NatPow_add,
      cmul_cconj_self_of_unit (u345NatPow (n + 1)) (u345NatPow_unit (n + 1))] at hmul
  exact u345NatPow_ne_one_of_pos (m + (n + 1)) (by omega) hmul

/-- The full integer power map `k ↦ (3/5 + 4/5 i)^k` on `ℤ` is injective. -/
theorem u345IntPow_injective : Function.Injective u345IntPow := by
  intro k₁ k₂ h
  cases k₁ with
  | ofNat m =>
    cases k₂ with
    | ofNat n =>
      have hmn : m = n := u345NatPow_injective h
      subst hmn
      rfl
    | negSucc n =>
      exfalso
      exact u345NatPow_ne_negSucc m n h
  | negSucc m =>
    cases k₂ with
    | ofNat n =>
      exfalso
      exact u345NatPow_ne_negSucc n m h.symm
    | negSucc n =>
      rw [u345IntPow_negSucc, u345IntPow_negSucc] at h
      have hconj := congrArg cconj h
      rw [cconj_involutive, cconj_involutive] at hconj
      have hmn : m + 1 = n + 1 := u345NatPow_injective hconj
      omega

/-- The zeroth integer power is `(1, 0)`. -/
theorem u345IntPow_zero : u345IntPow 0 = (1, 0) := by
  ext <;> norm_num [u345IntPow, u345NatPow, gaussPow34]

/-- An integer power `u345IntPow k` equals `(1, 0)` if and only if `k = 0`. -/
theorem u345IntPow_eq_one_iff (k : ℤ) :
    u345IntPow k = (1, 0) ↔ k = 0 := by
  rw [← u345IntPow_zero]
  exact u345IntPow_injective.eq_iff

/-- Infinite-order theorem: the cyclic subgroup generated by `u = (3/5, 4/5)` in `S¹(ℚ)`
is torsion-free (`u^k ≠ (1, 0)` for all `k ≠ 0`) and has pairwise distinct elements. -/
theorem u345_infinite_order :
    Function.Injective u345IntPow ∧ ∀ k : ℤ, k ≠ 0 → u345IntPow k ≠ (1, 0) := by
  refine ⟨u345IntPow_injective, ?_⟩
  intro k hk h
  exact hk ((u345IntPow_eq_one_iff k).mp h)

end U1Fable.PowerMapInjectivity

