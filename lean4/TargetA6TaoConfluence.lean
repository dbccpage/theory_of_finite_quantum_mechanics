/-- Evaluate the cross-ratio of a given matrix M at submatrix s. -/
def submatrixCrossRatio (M : Fin 6 → Fin 6 → Root24) (s : Submatrix2Index) : Root24 :=
  crossRatio24 (M s.r0 s.c0) (M s.r0 s.c1) (M s.r1 s.c0) (M s.r1 s.c1)

/-- Compute the cross-ratio exponent mod 24 directly for S₆ at submatrix s. -/
def taoSubmatrixCrossRatioExp (s : Submatrix2Index) : Nat :=
  crossRatioExpNat (taoExp s.r0 s.c0) (taoExp s.r0 s.c1) (taoExp s.r1 s.c0) (taoExp s.r1 s.c1)

/-- List of all 225 computed cross-ratio exponents for S₆. -/
def computedTaoExponentsList : List Nat :=
  allSubmatricesList.map taoSubmatrixCrossRatioExp

