      haagerup_box_gap_real j ≤ basisCurvatureMass e (1 / 6) U) :
    ∀ U ∈ haagerup_basis_complex K_box, ¬ ∀ j i, ‖overlap e U i j‖ ^ 2 = 1 / 6 := by
  have hcover : ∀ U ∈ haagerup_basis_complex K_box, ∃ j ∈ (Finset.univ : Finset (Fin 64)), U ∈ haagerup_basis_patch K_box j := by
    intro U hU
    rcases Set.mem_iUnion.mp hU with ⟨j, hj⟩
    exact ⟨j, Finset.mem_univ j, hj⟩
  have hpos : ∀ j ∈ (Finset.univ : Finset (Fin 64)), 0 < haagerup_box_gap_real j :=
    fun j _ => haagerup_box_gap_real_pos j
  exact no_fourth_basis_in_cover (Finset.univ : Finset (Fin 64)) (haagerup_basis_patch K_box)
    (haagerup_basis_complex K_box) e (1 / 6) hcover
    haagerup_box_gap_real hbound_basis hpos

end KernelReflectionTaoHaagerup
end MUB

