  norm_num

/-- Lemma: a rational quotient of positive integers is positive in `ℚ`. -/
theorem rat_div_pos_of_pos {n : ℤ} {d : ℕ} (hn : 0 < n) (hd : 0 < d) :
    0 < (n : ℚ) / (d : ℚ) := by
  have hn_q : 0 < (n : ℚ) := Int.cast_pos.mpr hn
  have hd_q : 0 < (d : ℚ) := Nat.cast_pos.mpr hd
  exact div_pos hn_q hd_q

/-- Computable decision procedure: checks that every (numerator, denominator) pair has positive components. -/
def check_pairs (l : List (ℤ × ℕ)) : Bool :=
  l.all (fun (n, d) => 0 < n && 0 < d)

/-- Soundness theorem of the decision procedure: if `check_pairs l = true`, then every fraction is positive in `ℚ`. -/
theorem all_pos_of_check_pairs {l : List (ℤ × ℕ)} (h : check_pairs l = true)
    (pair : ℤ × ℕ) (hmem : pair ∈ l) :
    0 < (pair.1 : ℚ) / (pair.2 : ℚ) := by
  have h_all := List.all_eq_true.mp h
  have h_pair := h_all pair hmem
  simp only [Bool.and_eq_true, decide_eq_true_iff] at h_pair
  exact rat_div_pos_of_pos h_pair.1 h_pair.2

/-- **Kernel reflection execution for Tao S6**: the decision procedure evaluates to `true` by reflexivity. -/
theorem tao_pairs_all_pos_verified : check_pairs tao_pairs = true := by rfl

/-- **Kernel reflection execution for Haagerup H6**: the decision procedure evaluates to `true` by reflexivity. -/
theorem haagerup_pairs_all_pos_verified : check_pairs haagerup_pairs = true := by rfl

/-- Indexing function retrieving the certified rational gap for Tao box `j : Fin 64`. -/
def tao_box_gap (j : Fin 64) : ℚ :=
  let p := tao_pairs.get ⟨j.val, by rw [tao_pairs_length]; exact j.isLt⟩
  (p.1 : ℚ) / (p.2 : ℚ)

/-- Coercion of Tao box gap to `ℝ`. -/
noncomputable def tao_box_gap_real (j : Fin 64) : ℝ := (tao_box_gap j : ℝ)

/-- Every box gap in the Tao 64-box complex is strictly positive in `ℚ`. -/
theorem tao_box_gap_pos (j : Fin 64) : 0 < tao_box_gap j := by
  unfold tao_box_gap
  exact all_pos_of_check_pairs tao_pairs_all_pos_verified _ (List.get_mem tao_pairs _)

/-- Every box gap in the Tao 64-box complex is strictly positive in `ℝ`. -/
theorem tao_box_gap_real_pos (j : Fin 64) : 0 < tao_box_gap_real j := by
  unfold tao_box_gap_real
  exact Rat.cast_pos.mpr (tao_box_gap_pos j)

/-- Indexing function retrieving the certified rational gap for Haagerup box `j : Fin 64`. -/
def haagerup_box_gap (j : Fin 64) : ℚ :=
  let p := haagerup_pairs.get ⟨j.val, by rw [haagerup_pairs_length]; exact j.isLt⟩
  (p.1 : ℚ) / (p.2 : ℚ)

/-- Coercion of Haagerup box gap to `ℝ`. -/
noncomputable def haagerup_box_gap_real (j : Fin 64) : ℝ := (haagerup_box_gap j : ℝ)

/-- Every box gap in the Haagerup 64-box complex is strictly positive in `ℚ`. -/
theorem haagerup_box_gap_pos (j : Fin 64) : 0 < haagerup_box_gap j := by
  unfold haagerup_box_gap
  exact all_pos_of_check_pairs haagerup_pairs_all_pos_verified _ (List.get_mem haagerup_pairs _)

/-- Every box gap in the Haagerup 64-box complex is strictly positive in `ℝ`. -/
theorem haagerup_box_gap_real_pos (j : Fin 64) : 0 < haagerup_box_gap_real j := by
  unfold haagerup_box_gap_real
  exact Rat.cast_pos.mpr (haagerup_box_gap_pos j)

/-- Formal Lean 4 reflection of the Tao S6 certificate for the 64-box complex. -/
structure TaoComplexCertificate {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]
    (e : Fin 18 → E) (K_box : Fin 64 → Set E) where
  schema_version : String := tao_schema_version
  seed_name : String := "tao_s6"
  region_desc : String := tao_region_desc
  box_count : ℕ := num_tao_boxes
  complete_flag : Bool := true
  bound_certified : ∀ (j : Fin 64) (v : E), v ∈ K_box j → (tao_box_gap_real j) ≤ curvatureMass e (1 / 6) v

/-- Alias matching survey blueprint nomenclature. -/
abbrev TaoCoverCertificate {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]
    (e : Fin 18 → E) (K_box : Fin 64 → Set E) := TaoComplexCertificate e K_box

/-- Formal Lean 4 reflection of the Haagerup H6 certificate for the 64-box complex. -/
structure HaagerupComplexCertificate {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]
    (e : Fin 18 → E) (K_box : Fin 64 → Set E) where
  schema_version : String := haagerup_schema_version
  seed_label : String := "haagerup_h6_szollosi_b6_point0"
  region_desc : String := haagerup_region_desc
  box_count : ℕ := num_haagerup_boxes
  complete_flag : Bool := true
  bound_certified : ∀ (j : Fin 64) (v : E), v ∈ K_box j → (haagerup_box_gap_real j) ≤ curvatureMass e (1 / 6) v

/-- Alias matching survey blueprint nomenclature. -/
abbrev HaagerupCoverCertificate {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]
    (e : Fin 18 → E) (K_box : Fin 64 → Set E) := HaagerupComplexCertificate e K_box

/-- **Curvature mass positivity across the entire Tao S6 64-box complex.**
    Witnessed via `MUB.ExtensionCurvatureObstruction.finite_cover_no_feasible`:
    the certified lower bounds on each of the 64 contiguous patches force the curvature mass
    `Φ(v)` to be strictly positive on every vector in the union complex `⋃ j, K_box j`. -/
theorem tao_complex_curvature_mass_pos {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℂ E] (e : Fin 18 → E) (K_box : Fin 64 → Set E)
    (cert : TaoComplexCertificate e K_box) :
    ∀ v ∈ (⋃ j : Fin 64, K_box j), 0 < curvatureMass e (1 / 6) v := by
  intro v hv
  have hcover : ∀ w ∈ (⋃ j : Fin 64, K_box j), ∃ j ∈ (Finset.univ : Finset (Fin 64)), w ∈ K_box j := by
    intro w hw
    rcases Set.mem_iUnion.mp hw with ⟨j, hj⟩
    exact ⟨j, Finset.mem_univ j, hj⟩
  have hbound : ∀ j ∈ (Finset.univ : Finset (Fin 64)), ∀ w ∈ K_box j,
      tao_box_gap_real j ≤ curvatureMass e (1 / 6) w :=
    fun j _ w hw => cert.bound_certified j w hw
  have hpos : ∀ j ∈ (Finset.univ : Finset (Fin 64)), 0 < tao_box_gap_real j :=
    fun j _ => tao_box_gap_real_pos j
  exact finite_cover_no_feasible (Finset.univ : Finset (Fin 64)) K_box
    (curvatureMass e (1 / 6)) (⋃ j : Fin 64, K_box j) hcover
    tao_box_gap_real hbound hpos v hv

/-- **No mutually unbiased vector across the entire Tao S6 64-box complex.**
    Witnessed via `MUB.FiniteVectorCover.no_mu_vector_in_cover`:
    no vector in the 64-box contiguous complex satisfies `‖⟪e i, v⟫‖² = 1/6` for all `i`. -/
theorem tao_complex_no_mu_vector {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℂ E] (e : Fin 18 → E) (K_box : Fin 64 → Set E)
    (cert : TaoComplexCertificate e K_box) :
    ∀ v ∈ (⋃ j : Fin 64, K_box j), ¬ ∀ i, ‖⟪e i, v⟫_ℂ‖ ^ 2 = 1 / 6 := by
  have hcover : ∀ w ∈ (⋃ j : Fin 64, K_box j), ∃ j ∈ (Finset.univ : Finset (Fin 64)), w ∈ K_box j := by
    intro w hw
    rcases Set.mem_iUnion.mp hw with ⟨j, hj⟩
    exact ⟨j, Finset.mem_univ j, hj⟩
  have hbound : ∀ j ∈ (Finset.univ : Finset (Fin 64)), ∀ w ∈ K_box j,
      tao_box_gap_real j ≤ curvatureMass e (1 / 6) w :=
    fun j _ w hw => cert.bound_certified j w hw
  have hpos : ∀ j ∈ (Finset.univ : Finset (Fin 64)), 0 < tao_box_gap_real j :=
    fun j _ => tao_box_gap_real_pos j
  exact no_mu_vector_in_cover (Finset.univ : Finset (Fin 64)) K_box
    (⋃ j : Fin 64, K_box j) e (1 / 6) hcover
    tao_box_gap_real hbound hpos

/-- Direct derivation of the Tao complex vector no-go combining
    `tao_complex_curvature_mass_pos` and `curvatureMass_eq_zero_iff`. -/
theorem tao_complex_no_mu_vector_alt {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℂ E] (e : Fin 18 → E) (K_box : Fin 64 → Set E)
    (cert : TaoComplexCertificate e K_box) :
    ∀ v ∈ (⋃ j : Fin 64, K_box j), ¬ ∀ i, ‖⟪e i, v⟫_ℂ‖ ^ 2 = 1 / 6 := by
  intro v hv hMU
  have hpos : 0 < curvatureMass e (1 / 6) v :=
    tao_complex_curvature_mass_pos e K_box cert v hv
  rw [(curvatureMass_eq_zero_iff e (1 / 6) v).mpr hMU] at hpos
  exact lt_irrefl 0 hpos

/-- Induced basis patches for candidate fourth bases whose first column belongs to Tao box `j`. -/
def tao_basis_patch (K_box : Fin 64 → Set (Fin 6 → ℂ)) (j : Fin 64) :
    Set (Matrix.unitaryGroup (Fin 6) ℂ) :=
  { U | (fun k => (U : Matrix (Fin 6) (Fin 6) ℂ) k 0) ∈ K_box j }

/-- Complex of candidate fourth bases whose first column belongs to the Tao 64-box complex. -/
def tao_basis_complex (K_box : Fin 64 → Set (Fin 6 → ℂ)) :
    Set (Matrix.unitaryGroup (Fin 6) ℂ) :=
  ⋃ j : Fin 64, tao_basis_patch K_box j

/-- **Direct connection to `MUB.FiniteBasisCover.no_fourth_basis_in_cover` and `finite_cover_no_feasible`:**
    No candidate fourth basis in `tao_basis_complex K_box` is mutually unbiased to the seed triple `e`. -/
theorem tao_complex_no_fourth_basis_in_cover
    (e : Fin 18 → (Fin 6 → ℂ)) (K_box : Fin 64 → Set (Fin 6 → ℂ))
    (hbound_basis : ∀ j ∈ (Finset.univ : Finset (Fin 64)), ∀ U ∈ tao_basis_patch K_box j,
      tao_box_gap_real j ≤ basisCurvatureMass e (1 / 6) U) :
    ∀ U ∈ tao_basis_complex K_box, ¬ ∀ j i, ‖overlap e U i j‖ ^ 2 = 1 / 6 := by
  have hcover : ∀ U ∈ tao_basis_complex K_box, ∃ j ∈ (Finset.univ : Finset (Fin 64)), U ∈ tao_basis_patch K_box j := by
    intro U hU
    rcases Set.mem_iUnion.mp hU with ⟨j, hj⟩
    exact ⟨j, Finset.mem_univ j, hj⟩
  have hpos : ∀ j ∈ (Finset.univ : Finset (Fin 64)), 0 < tao_box_gap_real j :=
    fun j _ => tao_box_gap_real_pos j
  exact no_fourth_basis_in_cover (Finset.univ : Finset (Fin 64)) (tao_basis_patch K_box)
    (tao_basis_complex K_box) e (1 / 6) hcover
    tao_box_gap_real hbound_basis hpos

