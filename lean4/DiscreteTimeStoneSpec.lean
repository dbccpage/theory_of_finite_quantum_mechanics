/-!
# Discrete time versus ℚ-parameter time: the carrier-level Stone specification

DAG node: `FQ-GAP-STONE-CONTINUOUS-TIME`.
AuthorityEffect: None.

The finite theory has no topology on its carrier, so "continuous time" in the sense of
Stone's theorem (a strongly continuous one-parameter unitary group `t ↦ U(t)` with a
self-adjoint generator) is an external import.  This module records, at the level of the
carrier (matrices over `ℚ`), exactly what is *specified* and exactly what is *derived*.

## Specified (generic over a group `G`)

* `QParamGroup G`: a `ℚ`-parameter group `U : ℚ → G` with `U 0 = 1` and
  `U (s + t) = U s * U t`.  With no topology available this is the strongest finite
  notion of "continuous time": the parameter ranges over `ℚ`, not over `ℝ`.
* `discreteEvolution u : ℤ → G`, `k ↦ u ^ k`: discrete time is the `ℤ`-action generated
  by a single step `u`.
* The restriction theorems `U_natMul`, `U_neg`, `U_int`, `U_eq_discreteEvolution`:
  every `ℚ`-parameter group restricts on `ℤ ⊆ ℚ` to the discrete evolution of its unit
  step `U 1`.
* The necessity theorem `roots_of_all_orders`: if a `ℚ`-parameter group passes through
  `u = U 1`, then `u` has an `m`-th root in `G` for every `m ≥ 1` (namely `U (1/m)`).
* Generator non-uniqueness `sq_root_neg`, `half_step_not_unique`: in any ring that is a
  `ℚ`-module (e.g. `Matrix (Fin n) (Fin n) ℚ`), a non-zero square root `v` of a step `u`
  is never the only one (`-v` is another).  "Generator selection" is therefore a choice,
  not a derivation, even when half-steps exist.

## Derived (the exact obstruction over `ℚ`, `2 × 2`)

* `R345 = !![3/5, -4/5; 4/5, 3/5]` is an orthogonal rational rotation of determinant `1`
  (`R345_orthogonal`, `R345_det`), and its discrete evolution `k ↦ R345 ^ k` stays
  orthogonal for every `k` (`R345_pow_orthogonal`).
* `no_rational_half_step`: no rational `2 × 2` matrix `V` satisfies `V * V = R345`.
  (Any such `V` commutes with `R345`, hence has the form `!![p, -r; r, p]`; then
  `p² - r² = 3/5` and `2pr = 4/5` force `p² = 4/5`, which is not a rational square because
  the denominator of `4/5` is `5` and `5` is not a perfect square.)
* `no_qparam_group_through_R345`: consequently no `ℚ`-parameter group of invertible
  rational `2 × 2` matrices (`(Matrix (Fin 2) (Fin 2) ℚ)ˣ`) has `R345` as its unit step.
  Continuous time through this rotation requires extending the carrier, e.g. by `√5`
  (the half-angle of the `(3, 4, 5)` rotation has `cos = 2/√5`).

These carrier-level statements complement the scalar results already in the repository:
`U1PythagoreanObstruction.u345_no_rat_circle_sqrt`,
`U1PythagoreanObstruction.no_rat_add_to_rat_circle_hom_u345`, and
`U1PowerMapInjectivity.u345_infinite_order`.  Those files are not imported here; this module
is self-contained.

## Not proved here (open obligation)

The general theorem "every `ℚ`-parameter group of matrices over `ℚ(i)` is trivial" is NOT
proved in this module.  It needs unique factorisation in `ℤ[i]` (divisibility of every
order forces each entry to be a unit) and is recorded as an open obligation for the node.
-/

namespace BornFinite.DiscreteTime

open scoped Matrix

/-! ## A. Specification -/

section Spec

variable {G : Type*} [Group G]

/-- A `ℚ`-parameter group in `G`: "continuous time" with rational parameter.  No topology
is assumed, because none is available on the finite carrier. -/
structure QParamGroup (G : Type*) [Group G] where
  /-- The evolution map `t ↦ U t`. -/
  U : ℚ → G
  /-- Time zero is the identity. -/
  map_zero : U 0 = 1
  /-- The one-parameter group law. -/
  map_add : ∀ s t : ℚ, U (s + t) = U s * U t

/-- Discrete evolution: the `ℤ`-action generated by one step `u`. -/
def discreteEvolution (u : G) : ℤ → G := fun k => u ^ k

theorem discreteEvolution_add (u : G) (j k : ℤ) :
    discreteEvolution u (j + k) = discreteEvolution u j * discreteEvolution u k :=
  zpow_add u j k

theorem discreteEvolution_zero (u : G) : discreteEvolution u 0 = 1 :=
  zpow_zero u

theorem discreteEvolution_one (u : G) : discreteEvolution u 1 = u :=
  zpow_one u

theorem discreteEvolution_neg (u : G) (k : ℤ) :
    discreteEvolution u (-k) = (discreteEvolution u k)⁻¹ :=
  zpow_neg u k

namespace QParamGroup

/-- `U (n * t) = (U t) ^ n` for natural `n`. -/
theorem U_natMul (Φ : QParamGroup G) (n : ℕ) (t : ℚ) : Φ.U (n * t) = Φ.U t ^ n := by
  induction n with
  | zero => simp [Φ.map_zero]
  | succ n ih => rw [Nat.cast_succ, add_mul, one_mul, Φ.map_add, ih, pow_succ]

/-- `U (-t) = (U t)⁻¹`. -/
theorem U_neg (Φ : QParamGroup G) (t : ℚ) : Φ.U (-t) = (Φ.U t)⁻¹ :=
  eq_inv_of_mul_eq_one_left (by rw [← Φ.map_add, neg_add_cancel, Φ.map_zero])

/-- On integer times the `ℚ`-parameter group is the `ℤ`-power of its unit step. -/
theorem U_int (Φ : QParamGroup G) (k : ℤ) : Φ.U k = Φ.U 1 ^ k := by
  cases k with
  | ofNat n => rw [Int.ofNat_eq_natCast, Int.cast_natCast, zpow_natCast, ← U_natMul, mul_one]
  | negSucc n => rw [Int.cast_negSucc, zpow_negSucc, U_neg, ← U_natMul, mul_one]

/-- A `ℚ`-parameter group restricts to the discrete evolution of its unit step. -/
theorem U_eq_discreteEvolution (Φ : QParamGroup G) :
    ∀ k : ℤ, Φ.U k = discreteEvolution (Φ.U 1) k :=
  fun k => U_int Φ k

/-- The `1/m`-step is an `m`-th root of the unit step. -/
theorem U_inv_nat (Φ : QParamGroup G) (m : ℕ) (hm : 0 < m) : Φ.U (1 / m) ^ m = Φ.U 1 := by
  have hm' : (m : ℚ) ≠ 0 := by exact_mod_cast hm.ne'
  rw [← U_natMul, mul_one_div_cancel hm']

/-- Necessity: a continuous-time (`ℚ`-parameter) extension of a discrete step requires
roots of every order in the carrier. -/
theorem roots_of_all_orders (Φ : QParamGroup G) (m : ℕ) (hm : 0 < m) :
    ∃ v : G, v ^ m = Φ.U 1 :=
  ⟨Φ.U (1 / m), U_inv_nat Φ m hm⟩

end QParamGroup

end Spec

/-! ### Generator selection is a choice -/

section Generator

/-- If `v` is a square root of `u`, so is `-v`. -/
theorem sq_root_neg {R : Type*} [Ring R] {v u : R} (h : v * v = u) : (-v) * (-v) = u := by
  rw [neg_mul_neg, h]

/-- In a `ℚ`-module, a non-zero vector is not its own negative. -/
theorem neg_ne_self_of_ne_zero {R : Type*} [AddCommGroup R] [Module ℚ R] {v : R}
    (hv : v ≠ 0) : -v ≠ v := by
  intro h
  apply hv
  have h2 : (2 : ℚ) • v = 0 := by
    rw [two_smul]
    have h3 := neg_add_cancel v
    rwa [h] at h3
  calc v = ((2 : ℚ)⁻¹ * 2) • v := by
        rw [inv_mul_cancel₀ (by norm_num : (2 : ℚ) ≠ 0), one_smul]
    _ = (2 : ℚ)⁻¹ • ((2 : ℚ) • v) := by rw [smul_smul]
    _ = 0 := by rw [h2, smul_zero]

/-- Half-steps are never unique: a non-zero square root of a step always has a companion. -/
theorem half_step_not_unique {R : Type*} [Ring R] [Module ℚ R] {v u : R} (h : v * v = u)
    (hv : v ≠ 0) : ∃ w : R, w * w = u ∧ w ≠ v :=
  ⟨-v, sq_root_neg h, neg_ne_self_of_ne_zero hv⟩

/-- The same statement specialised to rational `n × n` matrices. -/
theorem matrix_half_step_not_unique (n : ℕ) {V U : Matrix (Fin n) (Fin n) ℚ}
    (h : V * V = U) (hV : V ≠ 0) : ∃ W : Matrix (Fin n) (Fin n) ℚ, W * W = U ∧ W ≠ V :=
  half_step_not_unique h hV

end Generator

/-! ## B. The exact obstruction at the matrix level -/

section Obstruction

/-- The Pythagorean `(3, 4, 5)` rotation as a rational `2 × 2` matrix. -/
def R345 : Matrix (Fin 2) (Fin 2) ℚ := !![3 / 5, -4 / 5; 4 / 5, 3 / 5]

theorem R345_transpose : R345ᵀ = !![3 / 5, 4 / 5; -4 / 5, 3 / 5] := by
  ext i j
  fin_cases i <;> fin_cases j <;> rfl

/-- `R345` is orthogonal. -/
theorem R345_orthogonal : R345ᵀ * R345 = 1 := by
  rw [R345_transpose, R345, Matrix.mul_fin_two, Matrix.one_fin_two]
  norm_num

/-- `R345` has determinant `1`. -/
theorem R345_det : R345.det = 1 := by
  rw [R345, Matrix.det_fin_two_of]
  norm_num

/-- Positive side: the discrete evolution `k ↦ R345 ^ k` stays orthogonal. -/
theorem R345_pow_orthogonal (k : ℕ) : (R345 ^ k)ᵀ * (R345 ^ k) = 1 := by
  induction k with
  | zero => rw [pow_zero, Matrix.transpose_one, Matrix.one_mul]
  | succ k ih =>
    rw [pow_succ, Matrix.transpose_mul, Matrix.mul_assoc, ← Matrix.mul_assoc (R345 ^ k)ᵀ, ih,
      Matrix.one_mul, R345_orthogonal]

/-- The denominator of `4/5`. -/
theorem four_fifths_den : (4 / 5 : ℚ).den = 5 := by
  have h : (((4 : ℤ) / (5 : ℤ) : ℚ).den : ℤ) = 5 :=
    Rat.den_div_eq_of_coprime (by norm_num) (by decide)
  have h' : ((4 : ℤ) / (5 : ℤ) : ℚ) = 4 / 5 := by norm_num
  rw [h'] at h
  exact_mod_cast h

/-- `5` is not a perfect square. -/
theorem nat_mul_self_ne_five (d : ℕ) : d * d ≠ 5 := by
  intro h
  have hd : d ≤ 2 := by nlinarith
  interval_cases d <;> norm_num at h

/-- `4/5` is not a rational square (its denominator `5` is not a perfect square). -/
theorem four_fifths_not_rat_square : ¬ ∃ q : ℚ, q * q = 4 / 5 := by
  rintro ⟨q, hq⟩
  have h := Rat.mul_self_den q
  rw [hq, four_fifths_den] at h
  exact nat_mul_self_ne_five q.den h.symm

/-- Main theorem: `R345` has no rational half-step. -/
theorem no_rational_half_step : ¬ ∃ V : Matrix (Fin 2) (Fin 2) ℚ, V * V = R345 := by
  rintro ⟨V, hV⟩
  -- `V` commutes with its own square.
  have hcomm : V * R345 = R345 * V := by
    rw [← hV, Matrix.mul_assoc]
  have e00 := congrFun (congrFun hV 0) 0
  have e10 := congrFun (congrFun hV 1) 0
  have c00 := congrFun (congrFun hcomm 0) 0
  have c01 := congrFun (congrFun hcomm 0) 1
  simp [Matrix.mul_apply, Fin.sum_univ_two, R345] at e00 e10 c00 c01
  -- Commutation forces `V = !![p, -r; r, p]`.
  have hq : V 0 1 = -V 1 0 := by linarith
  have hs : V 1 1 = V 0 0 := by linarith
  -- The square then reads `p² - r² = 3/5`, `p r = 2/5`.
  have h1 : V 0 0 * V 0 0 - V 1 0 * V 1 0 = 3 / 5 := by
    linear_combination e00 - V 1 0 * hq
  have h2 : V 0 0 * V 1 0 = 2 / 5 := by
    linear_combination (e10 - V 1 0 * hs) / 2
  -- Hence `(p² - 4/5)(p² + 1/5) = 0`.
  have h3 : (V 0 0 * V 0 0 - 4 / 5) * (V 0 0 * V 0 0 + 1 / 5) = 0 := by
    linear_combination (V 0 0 * V 0 0) * h1 + (V 0 0 * V 1 0 + 2 / 5) * h2
  rcases mul_eq_zero.mp h3 with h4 | h4
  · exact four_fifths_not_rat_square ⟨V 0 0, by linarith⟩
  · have h5 := mul_self_nonneg (V 0 0)
    linarith

/-- Corollary tying A and B: no `ℚ`-parameter group of invertible rational `2 × 2`
matrices has the Pythagorean rotation as its unit step. -/
theorem no_qparam_group_through_R345 :
    ¬ ∃ Φ : QParamGroup (Matrix (Fin 2) (Fin 2) ℚ)ˣ,
      (Φ.U 1 : Matrix (Fin 2) (Fin 2) ℚ) = R345 := by
  rintro ⟨Φ, hΦ⟩
  obtain ⟨v, hv⟩ := Φ.roots_of_all_orders 2 (by norm_num)
  apply no_rational_half_step
  refine ⟨(v : Matrix (Fin 2) (Fin 2) ℚ), ?_⟩
  rw [← hΦ, ← hv, Units.val_pow_eq_pow_val, sq]

end Obstruction

end BornFinite.DiscreteTime

