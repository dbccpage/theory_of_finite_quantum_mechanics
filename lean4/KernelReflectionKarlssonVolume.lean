/-- Witness predicate that the Karlsson 3D volume cover is certified with positive curvature. -/
def KarlssonVolumeCoverCertified : Prop :=
  MUB.KernelReflectionKarlssonVolume.check_karlsson_pairs MUB.KernelReflectionKarlssonVolume.karlsson_volume_pairs = true

/-- The Karlsson Volume Cover Certification holds definitionally in the Lean 4 kernel. -/
theorem karlsson_volume_cover_verified : KarlssonVolumeCoverCertified :=
  MUB.KernelReflectionKarlssonVolume.karlsson_volume_pairs_all_pos_verified

/-- **Karlsson Volume Moduli Reduction Step**:
    Wires the certified Karlsson volume bounds into `ModuliReduction.moduli_reduction_grand_synthesis`. -/
theorem karlsson_volume_moduli_reduction_step
    (h_cov : ModuliCoverageConjecture)
    (h_atlas : AtlasCoversKnownModuli)
    (h_gauge : GaugeInvariantClassMembership)
    (h_g2_var : G2_Variety)
    (h_g3 : G3) :
    NoCompleteMUB6 :=
  moduli_reduction_grand_synthesis h_cov h_atlas h_gauge h_g2_var h_g3

/-- Karlsson volume reduction step using `g3_theorem` to discharge Premise G3 constructively. -/
theorem karlsson_volume_master_reduction_step
    (h_cov : ModuliCoverageConjecture)
    (h_atlas : AtlasCoversKnownModuli)
    (h_gauge : GaugeInvariantClassMembership)
    (h_g2_var : G2_Variety) :
    NoCompleteMUB6 :=
  karlsson_volume_moduli_reduction_step h_cov h_atlas h_gauge h_g2_var g3_theorem

end ModuliReduction

