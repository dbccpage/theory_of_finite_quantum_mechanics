/-!
# Typed generative histories and universal contextual compression

The opaque presentation mark `<>` supplies no internal constructor.  Once a
typed generating signature is explicitly admitted, `Path` is its free history
carrier.  A family of endpoint-typed questions then determines the greatest
two-sided path congruence that preserves every question in every compatible
context.

This file does not choose the signature or the questions, prove that the
quotient is finite, or turn signed occurrence data back into ordered histories.
It uses Lean core only.
-/

namespace WitnessedDifference.GenerativeHistoryCompression

universe u v w r s

set_option linter.checkUnivs false

/-- Explicit objects and typed one-step generators. -/
structure Signature where
  Obj : Type u
  Gen : Obj → Obj → Type v

/-- Finite well-typed histories freely generated by a typed graph. -/
inductive GeneratedPath (Obj : Type u) (Gen : Obj → Obj → Type v) :
    Obj → Obj → Type (max u v) where
  | nil (x : Obj) : GeneratedPath Obj Gen x x
  | cons {x y z : Obj} (edge : Gen x y)
      (tail : GeneratedPath Obj Gen y z) : GeneratedPath Obj Gen x z

/-- Paths in a packaged generating signature. -/
abbrev Path (S : Signature) := GeneratedPath S.Obj S.Gen

/-- Concatenation of compatible histories. -/
def Path.comp {S : Signature} {x y z : S.Obj} :
    Path S x y → Path S y z → Path S x z
  | .nil _, q => q
  | .cons edge tail, q => .cons edge (Path.comp tail q)

theorem Path.nil_comp {S : Signature} {x y : S.Obj} (p : Path S x y) :
    Path.comp (.nil x) p = p := rfl

theorem Path.comp_nil {S : Signature} {x y : S.Obj} (p : Path S x y) :
    Path.comp p (.nil y) = p := by
  induction p with
  | nil => rfl
  | cons edge tail ih => simp [Path.comp, ih]

theorem Path.comp_assoc {S : Signature} {a b c d : S.Obj}
    (p : Path S a b) (q : Path S b c) (r : Path S c d) :
    Path.comp (Path.comp p q) r = Path.comp p (Path.comp q r) := by
  induction p with
  | nil => rfl
  | cons edge tail ih => simp [Path.comp, ih]

/-- Deterministic partial replay of an event list, head first. -/
def replay {State : Type u} {Event : Type v}
    (step : State → Event → Option State) : List Event → State → Option State
  | [], state => some state
  | event :: events, state =>
      match step state event with
      | none => none
      | some next => replay step events next

/-- Every accepted transition becomes one typed generator. -/
def transitionSignature {State : Type u} {Event : Type v}
    (step : State → Event → Option State) : Signature where
  Obj := State
  Gen := fun source target => {event : Event // step source event = some target}

/-- Forget the endpoint proofs while retaining the ordered event history. -/
def transitionEvents {State : Type u} {Event : Type v}
    {step : State → Event → Option State} {source target : State} :
    Path (transitionSignature step) source target → List Event
  | .nil _ => []
  | .cons event tail => event.val :: transitionEvents tail

/-- A typed transition history replays to its indexed target. -/
theorem replay_transitionEvents {State : Type u} {Event : Type v}
    {step : State → Event → Option State} {source target : State}
    (path : Path (transitionSignature step) source target) :
    replay step (transitionEvents path) source = some target := by
  induction path with
  | nil => rfl
  | cons event tail ih =>
      simp only [transitionEvents, replay, event.property, ih]

/-- Event extraction turns typed composition into list append. -/
theorem transitionEvents_comp {State : Type u} {Event : Type v}
    {step : State → Event → Option State} {a b c : State}
    (p : Path (transitionSignature step) a b)
    (q : Path (transitionSignature step) b c) :
    transitionEvents (Path.comp p q) = transitionEvents p ++ transitionEvents q := by
  induction p with
  | nil => rfl
  | cons event tail ih => simp [Path.comp, transitionEvents, ih]

/-- A target composition system in which a generating signature can be read. -/
structure Interpretation (S : Signature) where
  Hom : S.Obj → S.Obj → Type s
  ident : (x : S.Obj) → Hom x x
  compose : {x y z : S.Obj} → Hom x y → Hom y z → Hom x z
  generator : {x y : S.Obj} → S.Gen x y → Hom x y
  leftIdentity : ∀ {x y} (f : Hom x y), compose (ident x) f = f
  rightIdentity : ∀ {x y} (f : Hom x y), compose f (ident y) = f
  associative : ∀ {a b c d} (f : Hom a b) (g : Hom b c) (h : Hom c d),
    compose (compose f g) h = compose f (compose g h)

/-- The canonical interpretation of a generated history. -/
def Path.fold {S : Signature} (I : Interpretation S) {x y : S.Obj} :
    Path S x y → I.Hom x y
  | .nil x => I.ident x
  | .cons edge tail => I.compose (I.generator edge) (Path.fold I tail)

/-- The canonical interpretation preserves history concatenation. -/
theorem Path.fold_comp {S : Signature} (I : Interpretation S)
    {x y z : S.Obj} (p : Path S x y) (q : Path S y z) :
    Path.fold I (Path.comp p q) = I.compose (Path.fold I p) (Path.fold I q) := by
  induction p with
  | nil => exact (I.leftIdentity (Path.fold I q)).symm
  | cons edge tail ih =>
      simp only [Path.comp, Path.fold, ih]
      exact (I.associative (I.generator edge) (Path.fold I tail) (Path.fold I q)).symm

/-- Any interpretation satisfying the generator recursion is the canonical fold. -/
theorem Path.fold_unique {S : Signature} (I : Interpretation S)
    (F : {x y : S.Obj} → Path S x y → I.Hom x y)
    (onNil : ∀ x, F (.nil x) = I.ident x)
    (onCons : ∀ {x y z} (edge : S.Gen x y) (tail : Path S y z),
      F (.cons edge tail) = I.compose (I.generator edge) (F tail))
    {x y : S.Obj} (p : Path S x y) : F p = Path.fold I p := by
  induction p with
  | nil x => exact onNil x
  | cons edge tail ih => simp only [onCons, Path.fold, ih]

/-- A typed family of questions and their answer types. -/
structure QuestionTheory (S : Signature) where
  Question : S.Obj → S.Obj → Type w
  Answer : {x y : S.Obj} → Question x y → Type r
  ask : {x y : S.Obj} → (q : Question x y) → Path S x y → Answer q

/-- Two parallel histories are equivalent when no declared question in any
compatible prefix/suffix context distinguishes them. -/
def ContextEq {S : Signature} (T : QuestionTheory S) {x y : S.Obj}
    (p p' : Path S x y) : Prop :=
  ∀ {a b : S.Obj} (u : Path S a x) (v : Path S y b) (q : T.Question a b),
    T.ask q (Path.comp (Path.comp u p) v) =
      T.ask q (Path.comp (Path.comp u p') v)

theorem contextEq_refl {S : Signature} (T : QuestionTheory S)
    {x y : S.Obj} (p : Path S x y) : ContextEq T p p := by
  intro _ _ _ _ _
  rfl

theorem contextEq_symm {S : Signature} {T : QuestionTheory S}
    {x y : S.Obj} {p p' : Path S x y} (h : ContextEq T p p') :
    ContextEq T p' p := by
  intro a b u v q
  exact (h u v q).symm

theorem contextEq_trans {S : Signature} {T : QuestionTheory S}
    {x y : S.Obj} {p p' p'' : Path S x y}
    (h₁ : ContextEq T p p') (h₂ : ContextEq T p' p'') :
    ContextEq T p p'' := by
  intro a b u v q
  exact (h₁ u v q).trans (h₂ u v q)

/-- The empty prefix and suffix recover preservation of the current question. -/
theorem contextEq_preserves_question {S : Signature} {T : QuestionTheory S}
    {x y : S.Obj} {p p' : Path S x y} (h : ContextEq T p p')
    (q : T.Question x y) : T.ask q p = T.ask q p' := by
  simpa only [Path.nil_comp, Path.comp_nil] using h (.nil x) (.nil y) q

/-- Contextual equivalence is stable under every compatible prefix. -/
theorem contextEq_prefix {S : Signature} {T : QuestionTheory S}
    {a x y : S.Obj} {p p' : Path S x y} (u : Path S a x)
    (h : ContextEq T p p') :
    ContextEq T (Path.comp u p) (Path.comp u p') := by
  intro c b left right q
  simpa only [Path.comp_assoc] using h (Path.comp left u) right q

/-- Contextual equivalence is stable under every compatible suffix. -/
theorem contextEq_suffix {S : Signature} {T : QuestionTheory S}
    {x y b : S.Obj} {p p' : Path S x y} (v : Path S y b)
    (h : ContextEq T p p') :
    ContextEq T (Path.comp p v) (Path.comp p' v) := by
  intro a c left right q
  simpa only [Path.comp_assoc] using h left (Path.comp v right) q

/-- Greatestness: every two-sided compatible relation that preserves all
current questions is contained in contextual equivalence.  The candidate need
not already be an equivalence relation. -/
theorem greatest_question_preserving_congruence
    {S : Signature} (T : QuestionTheory S)
    (R : {x y : S.Obj} → Path S x y → Path S x y → Prop)
    (preserves : ∀ {x y} {p p' : Path S x y}, R p p' →
      ∀ q : T.Question x y, T.ask q p = T.ask q p')
    (prefixClosed : ∀ {a x y} (u : Path S a x) {p p' : Path S x y},
      R p p' → R (Path.comp u p) (Path.comp u p'))
    (suffixClosed : ∀ {x y b} {p p' : Path S x y},
      R p p' → (v : Path S y b) → R (Path.comp p v) (Path.comp p' v)) :
    ∀ {x y} {p p' : Path S x y}, R p p' → ContextEq T p p' := by
  intro x y p p' h a b u v q
  exact preserves (suffixClosed (prefixClosed u h) v) q

/-- The contextual equivalence on each typed hom-set. -/
def contextSetoid {S : Signature} (T : QuestionTheory S) (x y : S.Obj) :
    Setoid (Path S x y) where
  r := ContextEq T
  iseqv := {
    refl := contextEq_refl T
    symm := contextEq_symm
    trans := contextEq_trans
  }

/-- The question-preserving compressed hom-set. -/
abbrev Compressed {S : Signature} (T : QuestionTheory S) (x y : S.Obj) :=
  Quotient (contextSetoid T x y)

/-- Identity in the compressed history category. -/
def compressedId {S : Signature} (T : QuestionTheory S) (x : S.Obj) :
    Compressed T x x := Quotient.mk (contextSetoid T x x) (.nil x)

/-- Composition descends to contextual-equivalence classes. -/
def compressedComp {S : Signature} {T : QuestionTheory S} {x y z : S.Obj} :
    Compressed T x y → Compressed T y z → Compressed T x z :=
  Quotient.lift₂
    (fun p q => Quotient.mk (contextSetoid T x z) (Path.comp p q))
    (by
      intro p q p' q' hp hq
      apply Quotient.sound
      exact contextEq_trans (contextEq_suffix q hp) (contextEq_prefix p' hq))

theorem compressed_left_identity {S : Signature} (T : QuestionTheory S)
    {x y : S.Obj} (p : Compressed T x y) :
    compressedComp (compressedId T x) p = p := by
  refine Quotient.inductionOn p ?_
  intro path
  rfl

theorem compressed_right_identity {S : Signature} (T : QuestionTheory S)
    {x y : S.Obj} (p : Compressed T x y) :
    compressedComp p (compressedId T y) = p := by
  refine Quotient.inductionOn p ?_
  intro path
  change Quotient.mk (contextSetoid T x y) (Path.comp path (.nil y)) =
    Quotient.mk (contextSetoid T x y) path
  rw [Path.comp_nil]

theorem compressed_associative {S : Signature} (T : QuestionTheory S)
    {a b c d : S.Obj} (p : Compressed T a b) (q : Compressed T b c)
    (r : Compressed T c d) :
    compressedComp (compressedComp p q) r =
      compressedComp p (compressedComp q r) := by
  refine Quotient.inductionOn p ?_
  intro pathP
  refine Quotient.inductionOn q ?_
  intro pathQ
  refine Quotient.inductionOn r ?_
  intro pathR
  change Quotient.mk (contextSetoid T a d)
      (Path.comp (Path.comp pathP pathQ) pathR) =
    Quotient.mk (contextSetoid T a d)
      (Path.comp pathP (Path.comp pathQ pathR))
  rw [Path.comp_assoc]

theorem contextEq_iff_equal_compressed_classes
    {S : Signature} (T : QuestionTheory S) {x y : S.Obj}
    (p p' : Path S x y) :
    ContextEq T p p' ↔
      Quotient.mk (contextSetoid T x y) p = Quotient.mk (contextSetoid T x y) p' := by
  constructor
  · intro h
    apply Quotient.sound
    exact h
  · intro h
    exact Quotient.exact h

/-- Every declared question descends to the compressed hom-set. -/
def compressedAsk {S : Signature} (T : QuestionTheory S) {x y : S.Obj}
    (q : T.Question x y) : Compressed T x y → T.Answer q :=
  Quotient.lift (T.ask q) (fun _ _ h => contextEq_preserves_question h q)

/-- The quotient retains the original answer exactly. -/
theorem compressedAsk_mk {S : Signature} (T : QuestionTheory S)
    {x y : S.Obj} (q : T.Question x y) (p : Path S x y) :
    compressedAsk T q (Quotient.mk (contextSetoid T x y) p) = T.ask q p := rfl

/-- Boundary of a typed history, evaluated at one vertex.  This is the
boundary of its signed edge-occurrence chain without choosing coordinates. -/
def Path.vertexBoundary {S : Signature} [DecidableEq S.Obj]
    {x y : S.Obj} : Path S x y → S.Obj → Int
  | .nil _, _ => 0
  | @GeneratedPath.cons _ _ a b c _ tail, vertex =>
      (if vertex = b then 1 else 0) - (if vertex = a then 1 else 0) +
        Path.vertexBoundary tail vertex

/-- Edge boundaries telescope: only the endpoints survive. -/
theorem Path.vertexBoundary_telescopes {S : Signature} [DecidableEq S.Obj]
    {x y : S.Obj} (p : Path S x y) (vertex : S.Obj) :
    Path.vertexBoundary p vertex =
      (if vertex = y then 1 else 0) - (if vertex = x then 1 else 0) := by
  induction p with
  | nil => simp [Path.vertexBoundary]
  | cons edge tail ih =>
      simp only [Path.vertexBoundary, ih]
      omega

/-- A proposed comparison between parallel histories has zero boundary. -/
theorem parallel_comparison_boundary_zero
    {S : Signature} [DecidableEq S.Obj] {x y : S.Obj}
    (p q : Path S x y) (vertex : S.Obj) :
    Path.vertexBoundary q vertex - Path.vertexBoundary p vertex = 0 := by
  rw [Path.vertexBoundary_telescopes, Path.vertexBoundary_telescopes]
  omega

end WitnessedDifference.GenerativeHistoryCompression

