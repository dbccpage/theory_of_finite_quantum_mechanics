import Imported.HigherCategoryTheory.Monoidal

namespace HigherCategoryTheory

universe u v

/-- A filtered system presenting an object X as a colimit of stages. -/
structure FilteredSystem {Obj : Type u} (cat : Category Obj) (X : Obj) where
  Stage : Type u
  stageObj : Stage → Obj
  stageInclusion : ∀ (s : Stage), cat.Hom (stageObj s) X
  non_trivial : Nonempty Stage

/-- Compactness predicate on an object C in a category:
    C is compact if mapping out of C preserves filtered colimits.
    Every morphism from C into an object X presented by a filtered system
    factors through some stage in the system. -/
structure IsCompactObject {Obj : Type u} (cat : Category Obj) (C : Obj) : Prop where
  factors_through_system : ∀ (X : Obj) (sys : FilteredSystem cat X) (f : cat.Hom C X),
    ∃ (s : sys.Stage) (factor : cat.Hom C (sys.stageObj s)),
      cat.comp factor (sys.stageInclusion s) = f

/-- A Compactly Generated Category consists of a category with a designated class
    of compact objects such that every object is generated by compact objects. -/
structure CompactlyGeneratedCategory (Obj : Type u) extends Category Obj where
  isCompact : Obj → Prop
  compact_are_compact : ∀ (C : Obj), isCompact C → IsCompactObject toCategory C

  -- Generation axiom: every object admits an approximation from a compact object
  approximation_from_compact : ∀ (X : Obj),
    ∃ (C : Obj) (_f : Hom C X), isCompact C

/-- Theorem: If an object C is compact, any morphism f : C ⟶ X into a filtered
    system factors through some stage. -/
theorem compact_factorization {Obj : Type u} (cat : Category Obj) (C : Obj)
    (hC : IsCompactObject cat C) (X : Obj) (sys : FilteredSystem cat X) (f : cat.Hom C X) :
    ∃ (s : sys.Stage) (factor : cat.Hom C (sys.stageObj s)),
      cat.comp factor (sys.stageInclusion s) = f :=
  hC.factors_through_system X sys f

/-- The canonical one-stage presentation of an object X by itself. -/
def identitySystem {Obj : Type u} (cat : Category Obj) (X : Obj) : FilteredSystem cat X where
  Stage := PUnit
  stageObj := fun _ => X
  stageInclusion := fun _ => cat.id X
  non_trivial := ⟨PUnit.unit⟩

/-- The identity morphism on a compact object factors through the canonical identity system. -/
theorem compact_id_factorization {Obj : Type u} (cat : Category Obj) (C : Obj)
    (hC : IsCompactObject cat C) :
    ∃ (s : PUnit) (factor : cat.Hom C ((identitySystem cat C).stageObj s)),
      cat.comp factor ((identitySystem cat C).stageInclusion s) = cat.id C :=
  hC.factors_through_system C (identitySystem cat C) (cat.id C)

end HigherCategoryTheory

