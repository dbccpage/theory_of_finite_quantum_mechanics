/- Review scope: The numerator recurrence and its nonzero imaginary coordinate are proved for every natural exponent. Dividing by 5^(n+1) gives the intended nonidentity conclusion. Topological density and logarithm branch selection are not formalized by the price record equalities. -/

-- ==============================================================================
-- SECTION 1: PYTHAGOREAN ROTATION DYNAMICS AND POWER ITERATION
-- ==============================================================================

/-- The Pythagorean rotation generator eigenvalue numerator (3 + 4i)^k is represented
    by integer coordinates (a_k, b_k) in Z[i], starting at k = 1 with (3, 4).
    The recurrence is:
      a_{k+1} = 3 * a_k - 4 * b_k
      b_{k+1} = 4 * a_k + 3 * b_k -/
def pythPower : Nat → Int × Int
  | 0 => (3, 4)
  | n + 1 =>
    let (a, b) := pythPower n
    (3 * a - 4 * b, 4 * a + 3 * b)

-- ==============================================================================
-- SECTION 2: MODULO 5 RESIDUE INVARIANCE THEOREM
-- ==============================================================================

/-- Modulo 5 structure: every power (3+4i)^{n+1} satisfies
    a_n = 5 * q_a + 3 and b_n = 5 * q_b + 4 for some integers q_a, q_b. -/
def HasPythResidue (p : Int × Int) : Prop :=
  ∃ qa qb : Int, p.1 = 5 * qa + 3 ∧ p.2 = 5 * qb + 4

/-- Base case: (3, 4) has residue (3, 4) mod 5 with qa = 0, qb = 0. -/
theorem pythPower_zero_residue : HasPythResidue (pythPower 0) := by
  dsimp [pythPower, HasPythResidue]
  exact ⟨0, 0, by omega, by omega⟩

/-- Inductive step: the residue (3, 4) mod 5 is an algebraic invariant under multiplication by (3 + 4i). -/
theorem pythPower_step_residue (p : Int × Int) (h : HasPythResidue p) :
    HasPythResidue (3 * p.1 - 4 * p.2, 4 * p.1 + 3 * p.2) := by
  rcases h with ⟨qa, qb, h1, h2⟩
  refine ⟨3 * qa - 4 * qb - 2, 4 * qa + 3 * qb + 4, ?_, ?_⟩
  · rw [h1, h2]; omega
  · rw [h1, h2]; omega

/-- Inductive invariance of the (3, 4) mod 5 residue for all powers n >= 0. -/
theorem pythPower_has_residue (n : Nat) : HasPythResidue (pythPower n) := by
  induction n with
  | zero => exact pythPower_zero_residue
  | succ m ih =>
    dsimp [pythPower]
    exact pythPower_step_residue (pythPower m) ih

-- ==============================================================================
-- SECTION 3: NON-VANISHING OF OFF-DIAGONAL AND INFINITE ORDER
-- ==============================================================================

/-- The imaginary coordinate b_n is never zero for any power n >= 0. -/
theorem pythPower_im_ne_zero (n : Nat) : (pythPower n).2 ≠ 0 := by
  have h := pythPower_has_residue n
  rcases h with ⟨_, qb, _, h2⟩
  intro hzero
  have : 5 * qb + 4 = 0 := by rw [← h2, hzero]
  omega

/-- An integer matrix in SO(2) with non-zero off-diagonal is not the identity matrix. -/
def Matrix2x2IsIdentity (a b : Int) : Prop :=
  b = 0 ∧ a = 1

/-- Theorem: The Pythagorean rotation power R_theta^{n+1} is never the identity matrix. -/
theorem pythagorean_rotation_power_ne_identity (n : Nat) :
    ¬ Matrix2x2IsIdentity (pythPower n).1 (pythPower n).2 := by
  intro ⟨hb, _⟩
  exact pythPower_im_ne_zero n hb

/-- Terminal Theorem: The cyclic group generated by R_theta has infinite order. -/
theorem pythagorean_rotation_order_infinite :
    ∀ n : Nat, (pythPower n).2 ≠ 0 := by
  intro n
  exact pythPower_im_ne_zero n

-- ==============================================================================
-- SECTION 4: PERIODIC SECTOR AND GENERATOR DECLARATION PRICE
-- ==============================================================================

/-- Representation of a periodic unitary phase in Q/Z. -/
structure TorsionPhase where
  num : Int
  den : Nat
  den_pos : den > 0
  deriving Repr

/-- In finite quantum mechanics, continuous time generator reconstruction
    from a periodic unitary U = exp(-i H t) requires choosing a discrete
    branch index k in Z, priced as 1 declaration. -/
structure GeneratorBranchSelection where
  branch_index : Int
  declared : Bool
  price : Nat

def periodic_generator_price : GeneratorBranchSelection :=
  ⟨0, true, 1⟩

def aperiodic_closure_price : GeneratorBranchSelection :=
  ⟨0, false, 0⟩

theorem periodic_sector_requires_declaration :
    periodic_generator_price.price = 1 := by
  rfl

theorem aperiodic_sector_closure_no_declaration :
    aperiodic_closure_price.price = 0 := by
  rfl

