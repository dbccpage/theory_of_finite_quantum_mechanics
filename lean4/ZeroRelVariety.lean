import WallTransport

/-!
# Exact ZeroRel Algebraic Variety Formalization (MUB(6) Milestone M4 / Lane ZER)

AuthorityEffect: None


This module formalizes:
1. The ZeroRel polynomial ideal and algebraic variety governing 3 mutually unbiased bases in dimension 6:
   - The 108 scalar polynomial relations r_{a,i,j}(T, U) = |\langle (b_a)_i, U_j \rangle|^2 - 1/6 = 0.
   - The ZeroRel polynomial ideal I(ZeroRel_T) generated by these 108 polynomials and orthonormality conditions.
   - The ZeroRel algebraic variety V_R(ZeroRel_T) as the real vanishing locus.
2. Exact covariance and invariance proofs:
   - Preservation under all unitary transformations V ∈ U(6).
   - Preservation under the full standard Hadamard equivalence group (vector permutations and affine phase gauge).
3. Real Vanishing Locus and Curvature Mass:
   - The squared curvature functional Psi^sq(T, U) = sum_{a,i,j} r_{a,i,j}(T, U)^2.
   - Exact Nullstellensatz / Artin-Schreier connection: Psi^sq(T, U) = 0 iff U ∈ V_R(ZeroRel_T).
   - Obstruction theorem: Psi^sq(T, U) >= eps > 0 implies V_R(ZeroRel_T) = empty.
4. Clean connection to the MUB(6) Gluing Program (Premise G2, Wall Transport, and Sub-Obligations G2.1, G2.2, G2.3).
-/

namespace MUB6.Gluing.Variety

open MUB6.Gluing

/-!
### 1. The 108 Polynomial Relations and Abstract ZeroRel Variety
-/

/-- The 108 scalar polynomial relation indices for an MU triple in dimension 6:
`basis : Fin 3` indexes the constituent basis (b0, b1, b2),
`row : Fin 6` indexes the vector in basis b_basis,
`col : Fin 6` indexes the vector in candidate fourth basis U. -/
structure RelIndex where
  basis : Fin 3
  row : Fin 6
  col : Fin 6
deriving DecidableEq, Repr

/-- Total number of scalar polynomial equations in the ZeroRel system: 3 × 6 × 6 = 108. -/
def totalEquationCount : Nat := 108

/-- Proof of exact equation count. -/
theorem equation_count_eq : 3 * 6 * 6 = totalEquationCount := rfl

/-- Map from `Fin 3` to constituent bases of an MU triple `T`. -/
def constituentBasis (T : MUTriple) (a : Fin 3) : Basis :=
  match a with
  | 0 => T.b0
  | 1 => T.b1
  | 2 => T.b2

/-- Pairwise mutual unbiasedness condition between constituent basis `a` and candidate fourth basis `U`. -/
def BasisMUCondition (T : MUTriple) (U : Basis) (a : Fin 3) : Prop :=
  is_mutually_unbiased (constituentBasis T a) U

/-- Equivalence between `ZeroRel T U` and the simultaneous satisfaction of all constituent MU conditions. -/
theorem zerorel_iff_all_bases (T : MUTriple) (U : Basis) :
    ZeroRel T U ↔ ∀ (a : Fin 3), BasisMUCondition T U a := by
  constructor
  · intro ⟨h0, h1, h2⟩ a
    cases a using Fin.cases with
    | zero => exact h0
    | succ a =>
      cases a using Fin.cases with
      | zero => exact h1
      | succ a =>
        cases a using Fin.cases with
        | zero => exact h2
        | succ a => nomatch a
  · intro h
    exact ⟨h 0, h 1, h 2⟩

/-- **Definition of the ZeroRel Algebraic Variety**:
The ZeroRel variety V_R(ZeroRel_T) is the real vanishing locus of candidate fourth bases
extending an MU triple T by satisfying all mutual unbiasedness relations. -/
def InZeroRelVariety (T : MUTriple) (U : Basis) : Prop :=
  ZeroRel T U

/-- Predicate asserting that the ZeroRel variety for triple `T` is empty (no real solutions). -/
def ZeroRelVarietyEmpty (T : MUTriple) : Prop :=
  ¬ ∃ (U : Basis), InZeroRelVariety T U

/-- Predicate asserting that the ZeroRel variety for triple `T` is non-empty (has at least one real point). -/
def ZeroRelVarietyNonempty (T : MUTriple) : Prop :=
  ∃ (U : Basis), InZeroRelVariety T U

/-- **Theorem: Equivalence between HasFourthBasis and Non-Emptiness of the ZeroRel Variety**. -/
theorem has_fourth_basis_iff_variety_nonempty (T : MUTriple) :
    HasFourthBasis T ↔ ZeroRelVarietyNonempty T := by
  constructor
  · intro ⟨b3, h0, h1, h2⟩
    exact ⟨b3, h0, h1, h2⟩
  · intro ⟨b3, hzr⟩
    exact ⟨b3, hzr.1, hzr.2.1, hzr.2.2⟩

/-- **Theorem: Equivalence between No Fourth Basis and Emptiness of the ZeroRel Variety**. -/
theorem no_fourth_basis_iff_variety_empty (T : MUTriple) :
    ¬ HasFourthBasis T ↔ ZeroRelVarietyEmpty T := by
  constructor
  · intro h_no4 ⟨U, hU⟩
    exact h_no4 ⟨U, hU.1, hU.2.1, hU.2.2⟩
  · intro h_empty ⟨U, h0, h1, h2⟩
    exact h_empty ⟨U, h0, h1, h2⟩

#print axioms equation_count_eq
#print axioms zerorel_iff_all_bases
#print axioms has_fourth_basis_iff_variety_nonempty
#print axioms no_fourth_basis_iff_variety_empty

/-!
### 2. Concrete 108-Polynomial System and Ideal Structure
-/

namespace ConcreteSystem

open ConcretePhaseModel

/-- A single polynomial equation generator in the coordinate ring:
Evaluates whether relation index (a, i, j) holds for candidate basis b3. -/
def PolynomialGenerator (T : ConcreteTriple) (idx : RelIndex) (b3 : ConcreteBasis) : Prop :=
  ZeroRelEq T b3 idx.basis idx.row idx.col

/-- The ZeroRel algebraic variety in concrete coordinates:
The simultaneous vanishing locus of all 108 polynomial relations. -/
def ConcreteZeroRelVariety (T : ConcreteTriple) (b3 : ConcreteBasis) : Prop :=
  ZeroRelSystem T b3

/-- Theorem: Concrete variety membership is equivalent to the vanishing of all 108 generators. -/
theorem concrete_variety_iff_all_generators (T : ConcreteTriple) (b3 : ConcreteBasis) :
    ConcreteZeroRelVariety T b3 ↔ ∀ (idx : RelIndex), PolynomialGenerator T idx b3 := by
  constructor
  · intro h idx
    exact h idx.basis idx.row idx.col
  · intro h a i j
    exact h ⟨a, i, j⟩

/-- The ZeroRel polynomial ideal I(ZeroRel_T):
A polynomial condition P belongs to the ZeroRel ideal if it vanishes on the entire ZeroRel variety. -/
def InZeroRelIdeal (T : ConcreteTriple) (P : ConcreteBasis → Prop) : Prop :=
  ∀ (b3 : ConcreteBasis), ZeroRelSystem T b3 → P b3

/-- **Theorem: Every generator of the 108 relations belongs to the ZeroRel ideal**. -/
theorem generator_in_zerorel_ideal (T : ConcreteTriple) (idx : RelIndex) :
    InZeroRelIdeal T (PolynomialGenerator T idx) := by
  intro b3 h_sys
  exact h_sys idx.basis idx.row idx.col

/-- Universal inclusion of all 108 generators in the ZeroRel ideal. -/
theorem all_generators_in_ideal (T : ConcreteTriple) :
    ∀ (idx : RelIndex), InZeroRelIdeal T (PolynomialGenerator T idx) := by
  intro idx
  exact generator_in_zerorel_ideal T idx

#print axioms concrete_variety_iff_all_generators
#print axioms generator_in_zerorel_ideal
#print axioms all_generators_in_ideal

end ConcreteSystem

/-!
### 3. Preservation of ZeroRel Variety under Unitary Transformations
-/

/-- **Unitary Covariance Theorem**:
For any unitary transformation V ∈ U(6), mutually unbiased triple T, and candidate basis U:
The candidate U extends T if and only if V U extends V T. -/
theorem zerorel_unitary_covariance (V : UnitaryTransformation) (T : MUTriple) (U : Basis) :
    ZeroRel (transformTriple V T) (V.act U) ↔ ZeroRel T U := by
  dsimp [ZeroRel, transformTriple]
  have h0 := V.mu_pres T.b0 U
  have h1 := V.mu_pres T.b1 U
  have h2 := V.mu_pres T.b2 U
  constructor
  · intro ⟨ha0, ha1, ha2⟩
    exact ⟨h0.mp ha0, h1.mp ha1, h2.mp ha2⟩
  · intro ⟨ha0, ha1, ha2⟩
    exact ⟨h0.mpr ha0, h1.mpr ha1, h2.mpr ha2⟩

/-- **Variety Covariance**:
U belongs to the ZeroRel variety V(T) iff V U belongs to V(V T). -/
theorem variety_unitary_covariance (V : UnitaryTransformation) (T : MUTriple) (U : Basis) :
    InZeroRelVariety (transformTriple V T) (V.act U) ↔ InZeroRelVariety T U :=
  zerorel_unitary_covariance V T U

/-- Backward variety covariance via adjoint unitary transformation V† = V⁻¹. -/
theorem variety_unitary_backward (V : UnitaryTransformation) (T : MUTriple) (U' : Basis) :
    InZeroRelVariety (transformTriple V T) U' ↔ InZeroRelVariety T (V.inv U') := by
  have h := variety_unitary_covariance V T (V.inv U')
  rw [V.act_inv U'] at h
  exact h

/-- **Theorem: Non-emptiness of the ZeroRel variety is invariant under unitary transformation**. -/
theorem variety_unitary_nonempty (V : UnitaryTransformation) (T : MUTriple) :
    ZeroRelVarietyNonempty (transformTriple V T) ↔ ZeroRelVarietyNonempty T := by
  constructor
  · intro ⟨U', hU'⟩
    let U := V.inv U'
    have hU : InZeroRelVariety T U := (variety_unitary_backward V T U').mp hU'
    exact ⟨U, hU⟩
  · intro ⟨U, hU⟩
    let U' := V.act U
    have hU' : InZeroRelVariety (transformTriple V T) U' := (variety_unitary_covariance V T U).mpr hU
    exact ⟨U', hU'⟩

/-- **Theorem: Emptiness of the ZeroRel variety is invariant under unitary transformation**. -/
theorem variety_unitary_empty (V : UnitaryTransformation) (T : MUTriple) :
    ZeroRelVarietyEmpty (transformTriple V T) ↔ ZeroRelVarietyEmpty T := by
  constructor
  · intro h_emp ⟨U, hU⟩
    have h_trans : InZeroRelVariety (transformTriple V T) (V.act U) :=
      (variety_unitary_covariance V T U).mpr hU
    exact h_emp ⟨V.act U, h_trans⟩
  · intro h_emp ⟨U', hU'⟩
    have h_orig : InZeroRelVariety T (V.inv U') :=
      (variety_unitary_backward V T U').mp hU'
    exact h_emp ⟨V.inv U', h_orig⟩

/-- Reconnection to Sub-Obligation G2.2: Unitary invariance of fourth-basis extension. -/
theorem g2_2_unitary_invariance_discharged (V : UnitaryTransformation) (T : MUTriple) :
    HasFourthBasis T ↔ HasFourthBasis (transformTriple V T) := by
  rw [has_fourth_basis_iff_variety_nonempty, has_fourth_basis_iff_variety_nonempty]
  exact (variety_unitary_nonempty V T).symm

#print axioms zerorel_unitary_covariance
#print axioms variety_unitary_covariance
#print axioms variety_unitary_backward
#print axioms variety_unitary_nonempty
#print axioms variety_unitary_empty
#print axioms g2_2_unitary_invariance_discharged

/-!
### 4. Preservation of ZeroRel Variety under Standard Hadamard Equivalence
-/

/-- An abstract basis automorphism representing a component of standard Hadamard equivalence
(generated by internal vector permutations and diagonal phase rotations). -/
structure HadamardBasisAction where
  act : Basis → Basis
  inv : Basis → Basis
  inv_act : ∀ b, inv (act b) = b
  act_inv : ∀ b, act (inv b) = b
  mu_pres_left : ∀ b1 b2, is_mutually_unbiased (act b1) b2 ↔ is_mutually_unbiased b1 b2
  mu_pres_right : ∀ b1 b2, is_mutually_unbiased b1 (act b2) ↔ is_mutually_unbiased b1 b2

/-- Joint preservation of mutual unbiasedness when Hadamard basis actions act on both sides. -/
theorem hadamard_mu_pres_both (H1 H2 : HadamardBasisAction) (b1 b2 : Basis) :
    is_mutually_unbiased (H1.act b1) (H2.act b2) ↔ is_mutually_unbiased b1 b2 := by
  have h1 := H1.mu_pres_left b1 (H2.act b2)
  have h2 := H2.mu_pres_right b1 b2
  constructor
  · intro h; exact h2.mp (h1.mp h)
  · intro h; exact h1.mpr (h2.mpr h)

/-- Standard Hadamard equivalence configuration acting on the 4-basis MUB system:
Independent Hadamard actions h0, h1, h2 on the constituent bases and h3 on candidate fourth basis. -/
structure HadamardSystemEquiv where
  h0 : HadamardBasisAction
  h1 : HadamardBasisAction
  h2 : HadamardBasisAction
  h3 : HadamardBasisAction

/-- Action of standard Hadamard equivalence on an MU triple. -/
def transformTripleHadamard (H : HadamardSystemEquiv) (T : MUTriple) : MUTriple where
  b0 := H.h0.act T.b0
  b1 := H.h1.act T.b1
  b2 := H.h2.act T.b2
  mu01 := (hadamard_mu_pres_both H.h0 H.h1 T.b0 T.b1).mpr T.mu01
  mu02 := (hadamard_mu_pres_both H.h0 H.h2 T.b0 T.b2).mpr T.mu02
  mu12 := (hadamard_mu_pres_both H.h1 H.h2 T.b1 T.b2).mpr T.mu12

/-- **PRIMARY THEOREM: ZeroRel Invariance under Standard Hadamard Equivalence**. -/
theorem zerorel_hadamard_invariant (H : HadamardSystemEquiv) (T : MUTriple) (U : Basis) :
    ZeroRel (transformTripleHadamard H T) (H.h3.act U) ↔ ZeroRel T U := by
  dsimp [ZeroRel, transformTripleHadamard]
  have h0 := hadamard_mu_pres_both H.h0 H.h3 T.b0 U
  have h1 := hadamard_mu_pres_both H.h1 H.h3 T.b1 U
  have h2 := hadamard_mu_pres_both H.h2 H.h3 T.b2 U
  constructor
  · intro ⟨ha0, ha1, ha2⟩
    exact ⟨h0.mp ha0, h1.mp ha1, h2.mp ha2⟩
  · intro ⟨ha0, ha1, ha2⟩
    exact ⟨h0.mpr ha0, h1.mpr ha1, h2.mpr ha2⟩

/-- Variety Covariance under Standard Hadamard Equivalence. -/
theorem variety_hadamard_covariance (H : HadamardSystemEquiv) (T : MUTriple) (U : Basis) :
    InZeroRelVariety (transformTripleHadamard H T) (H.h3.act U) ↔ InZeroRelVariety T U :=
  zerorel_hadamard_invariant H T U

/-- Backward variety covariance under standard Hadamard equivalence. -/
theorem variety_hadamard_backward (H : HadamardSystemEquiv) (T : MUTriple) (U' : Basis) :
    InZeroRelVariety (transformTripleHadamard H T) U' ↔ InZeroRelVariety T (H.h3.inv U') := by
  have h := variety_hadamard_covariance H T (H.h3.inv U')
  rw [H.h3.act_inv U'] at h
  exact h

/-- Non-emptiness of the ZeroRel variety is invariant under standard Hadamard equivalence. -/
theorem variety_hadamard_nonempty (H : HadamardSystemEquiv) (T : MUTriple) :
    ZeroRelVarietyNonempty (transformTripleHadamard H T) ↔ ZeroRelVarietyNonempty T := by
  constructor
  · intro ⟨U', hU'⟩
    let U := H.h3.inv U'
    have hU : InZeroRelVariety T U := (variety_hadamard_backward H T U').mp hU'
    exact ⟨U, hU⟩
  · intro ⟨U, hU⟩
    let U' := H.h3.act U
    have hU' : InZeroRelVariety (transformTripleHadamard H T) U' :=
      (variety_hadamard_covariance H T U).mpr hU
    exact ⟨U', hU'⟩

/-- Emptiness of the ZeroRel variety is invariant under standard Hadamard equivalence. -/
theorem variety_hadamard_empty (H : HadamardSystemEquiv) (T : MUTriple) :
    ZeroRelVarietyEmpty (transformTripleHadamard H T) ↔ ZeroRelVarietyEmpty T := by
  constructor
  · intro h_emp ⟨U, hU⟩
    have h_trans : InZeroRelVariety (transformTripleHadamard H T) (H.h3.act U) :=
      (variety_hadamard_covariance H T U).mpr hU
    exact h_emp ⟨H.h3.act U, h_trans⟩
  · intro h_emp ⟨U', hU'⟩
    have h_orig : InZeroRelVariety T (H.h3.inv U') :=
      (variety_hadamard_backward H T U').mp hU'
    exact h_emp ⟨H.h3.inv U', h_orig⟩

/-- Invariance of Fourth-Basis Extension under Standard Hadamard Equivalence. -/
theorem has_fourth_basis_hadamard_invariant (H : HadamardSystemEquiv) (T : MUTriple) :
    HasFourthBasis (transformTripleHadamard H T) ↔ HasFourthBasis T := by
  rw [has_fourth_basis_iff_variety_nonempty, has_fourth_basis_iff_variety_nonempty]
  exact variety_hadamard_nonempty H T

/-- Subsumption: Every affine phase equivalence is a standard Hadamard equivalence. -/
def hadamard_of_affine_phase (A : AffinePhaseEquivalence) : HadamardSystemEquiv where
  h0 := {
    act := A.p0.act
    inv := A.p0.inv
    inv_act := A.p0.inv_act
    act_inv := A.p0.act_inv
    mu_pres_left := A.p0.mu_pres_left
    mu_pres_right := A.p0.mu_pres_right
  }
  h1 := {
    act := A.p1.act
    inv := A.p1.inv
    inv_act := A.p1.inv_act
    act_inv := A.p1.act_inv
    mu_pres_left := A.p1.mu_pres_left
    mu_pres_right := A.p1.mu_pres_right
  }
  h2 := {
    act := A.p2.act
    inv := A.p2.inv
    inv_act := A.p2.inv_act
    act_inv := A.p2.act_inv
    mu_pres_left := A.p2.mu_pres_left
    mu_pres_right := A.p2.mu_pres_right
  }
  h3 := {
    act := A.p3.act
    inv := A.p3.inv
    inv_act := A.p3.inv_act
    act_inv := A.p3.act_inv
    mu_pres_left := A.p3.mu_pres_left
    mu_pres_right := A.p3.mu_pres_right
  }

/-- Sub-Obligation G2.1 recovered as a corollary of Hadamard equivalence invariance. -/
theorem zerorel_variety_affine_phase_invariant
    (A : AffinePhaseEquivalence) (T : MUTriple) (U : Basis) :
    InZeroRelVariety (transformTripleAffine A T) (A.p3.act U) ↔ InZeroRelVariety T U :=
  zerorel_hadamard_invariant (hadamard_of_affine_phase A) T U

#print axioms zerorel_hadamard_invariant
#print axioms variety_hadamard_covariance
#print axioms variety_hadamard_backward
#print axioms variety_hadamard_nonempty
#print axioms variety_hadamard_empty
#print axioms has_fourth_basis_hadamard_invariant
#print axioms zerorel_variety_affine_phase_invariant

/-!
### 5. Connection to Curvature Mass Psi^sq(T, U) = 0 and Real Vanishing Locus
-/

/-- An exact real/rational algebraic carrier for the sum of squared residuals.
Models an ordered domain (e.g. ℚ or ℝ) where squares are non-negative and
a sum of squares vanishes if and only if each term vanishes. -/
structure RealCurvatureAlgebra where
  R : Type
  zero : R
  add : R → R → R
  mul : R → R → R
  sq : R → R
  le : R → R → Prop
  lt : R → R → Prop
  sq_nonneg : ∀ x, le zero (sq x)
  add_nonneg : ∀ x y, le zero x → le zero y → le zero (add x y)
  add_eq_zero_iff : ∀ x y, le zero x → le zero y → (add x y = zero ↔ x = zero ∧ y = zero)
  sq_eq_zero_iff : ∀ x, sq x = zero ↔ x = zero
  le_refl : ∀ x, le x x
  le_trans : ∀ {x y z}, le x y → le y z → le x z
  not_le_of_lt : ∀ {x y}, lt x y → ¬ le y x

/-- Finite sum over `Fin 3`. -/
def sumFin3 (A : RealCurvatureAlgebra) (f : Fin 3 → A.R) : A.R :=
  A.add (f 0) (A.add (f 1) (f 2))

/-- Finite sum over `Fin 6`. -/
def sumFin6 (A : RealCurvatureAlgebra) (f : Fin 6 → A.R) : A.R :=
  A.add (f 0) (A.add (f 1) (A.add (f 2) (A.add (f 3) (A.add (f 4) (f 5)))))

/-- Lemma: sumFin6 of non-negative elements is non-negative. -/
theorem sumFin6_nonneg (A : RealCurvatureAlgebra) (f : Fin 6 → A.R)
    (hf : ∀ (i : Fin 6), A.le A.zero (f i)) :
    A.le A.zero (sumFin6 A f) := by
  dsimp [sumFin6]
  apply A.add_nonneg (f 0)
  · exact hf 0
  · apply A.add_nonneg (f 1)
    · exact hf 1
    · apply A.add_nonneg (f 2)
      · exact hf 2
      · apply A.add_nonneg (f 3)
        · exact hf 3
        · apply A.add_nonneg (f 4)
          · exact hf 4
          · exact hf 5

/-- Lemma: sumFin3 of non-negative elements is non-negative. -/
theorem sumFin3_nonneg (A : RealCurvatureAlgebra) (f : Fin 3 → A.R)
    (hf : ∀ (a : Fin 3), A.le A.zero (f a)) :
    A.le A.zero (sumFin3 A f) := by
  dsimp [sumFin3]
  apply A.add_nonneg (f 0)
  · exact hf 0
  · apply A.add_nonneg (f 1)
    · exact hf 1
    · exact hf 2

/-- Lemma: sumFin6 vanishes iff each component vanishes. -/
theorem sumFin6_eq_zero_iff (A : RealCurvatureAlgebra) (f : Fin 6 → A.R)
    (hf : ∀ (i : Fin 6), A.le A.zero (f i)) :
    sumFin6 A f = A.zero ↔ ∀ (i : Fin 6), f i = A.zero := by
  dsimp [sumFin6]
  have h45_nonneg : A.le A.zero (A.add (f 4) (f 5)) := A.add_nonneg (f 4) (f 5) (hf 4) (hf 5)
  have h35_nonneg : A.le A.zero (A.add (f 3) (A.add (f 4) (f 5))) :=
    A.add_nonneg (f 3) (A.add (f 4) (f 5)) (hf 3) h45_nonneg
  have h25_nonneg : A.le A.zero (A.add (f 2) (A.add (f 3) (A.add (f 4) (f 5)))) :=
    A.add_nonneg (f 2) _ (hf 2) h35_nonneg
  have h15_nonneg : A.le A.zero (A.add (f 1) (A.add (f 2) (A.add (f 3) (A.add (f 4) (f 5))))) :=
    A.add_nonneg (f 1) _ (hf 1) h25_nonneg

  have eq0 := A.add_eq_zero_iff (f 0) _ (hf 0) h15_nonneg
  have eq1 := A.add_eq_zero_iff (f 1) _ (hf 1) h25_nonneg
  have eq2 := A.add_eq_zero_iff (f 2) _ (hf 2) h35_nonneg
  have eq3 := A.add_eq_zero_iff (f 3) _ (hf 3) h45_nonneg
  have eq4 := A.add_eq_zero_iff (f 4) (f 5) (hf 4) (hf 5)

  constructor
  · intro h i
    rw [eq0] at h
    rcases h with ⟨h0, r1⟩
    rw [eq1] at r1
    rcases r1 with ⟨h1, r2⟩
    rw [eq2] at r2
    rcases r2 with ⟨h2, r3⟩
    rw [eq3] at r3
    rcases r3 with ⟨h3, r4⟩
    rw [eq4] at r4
    rcases r4 with ⟨h4, h5⟩
    cases i using Fin.cases with
    | zero => exact h0
    | succ i =>
      cases i using Fin.cases with
      | zero => exact h1
      | succ i =>
        cases i using Fin.cases with
        | zero => exact h2
        | succ i =>
          cases i using Fin.cases with
          | zero => exact h3
          | succ i =>
            cases i using Fin.cases with
            | zero => exact h4
            | succ i =>
              cases i using Fin.cases with
              | zero => exact h5
              | succ i => nomatch i
  · intro h
    have h0 : f 0 = A.zero := h 0
    have h1 : f 1 = A.zero := h 1
    have h2 : f 2 = A.zero := h 2
    have h3 : f 3 = A.zero := h 3
    have h4 : f 4 = A.zero := h 4
    have h5 : f 5 = A.zero := h 5
    rw [eq0, eq1, eq2, eq3, eq4]
    exact ⟨h0, h1, h2, h3, h4, h5⟩

/-- Lemma: sumFin3 vanishes iff each component vanishes. -/
theorem sumFin3_eq_zero_iff (A : RealCurvatureAlgebra) (f : Fin 3 → A.R)
    (hf : ∀ (a : Fin 3), A.le A.zero (f a)) :
    sumFin3 A f = A.zero ↔ ∀ (a : Fin 3), f a = A.zero := by
  dsimp [sumFin3]
  have h12_nonneg : A.le A.zero (A.add (f 1) (f 2)) := A.add_nonneg (f 1) (f 2) (hf 1) (hf 2)
  have eq0 := A.add_eq_zero_iff (f 0) _ (hf 0) h12_nonneg
  have eq1 := A.add_eq_zero_iff (f 1) (f 2) (hf 1) (hf 2)
  constructor
  · intro h a
    rw [eq0] at h
    rcases h with ⟨h0, r1⟩
    rw [eq1] at r1
    rcases r1 with ⟨h1, h2⟩
    cases a using Fin.cases with
    | zero => exact h0
    | succ a =>
      cases a using Fin.cases with
      | zero => exact h1
      | succ a =>
        cases a using Fin.cases with
        | zero => exact h2
        | succ a => nomatch a
  · intro h
    have h0 : f 0 = A.zero := h 0
    have h1 : f 1 = A.zero := h 1
    have h2 : f 2 = A.zero := h 2
    rw [eq0, eq1]
    exact ⟨h0, h1, h2⟩

/-- **The Squared Curvature Mass Functional**:
Psi^sq(T, U) = sum_{a ∈ Fin 3} sum_{i ∈ Fin 6} sum_{j ∈ Fin 6} r_{a,i,j}^2. -/
def CurvatureMass (A : RealCurvatureAlgebra) (res : Fin 3 → Fin 6 → Fin 6 → A.R) : A.R :=
  sumFin3 A (fun a => sumFin6 A (fun i => sumFin6 A (fun j => A.sq (res a i j))))

/-- Curvature mass is non-negative for any residual configuration. -/
theorem curvature_mass_nonneg (A : RealCurvatureAlgebra)
    (res : Fin 3 → Fin 6 → Fin 6 → A.R) :
    A.le A.zero (CurvatureMass A res) := by
  apply sumFin3_nonneg
  intro a
  apply sumFin6_nonneg
  intro i
  apply sumFin6_nonneg
  intro j
  exact A.sq_nonneg (res a i j)

/-- **THE SUM-OF-SQUARES NULLSTELLENSATZ THEOREM**:
Curvature mass Psi^sq vanishes if and only if every individual polynomial relation vanishes.
This proves that the real vanishing locus of Psi^sq is identically the ZeroRel variety. -/
theorem curvature_mass_eq_zero_iff (A : RealCurvatureAlgebra)
    (res : Fin 3 → Fin 6 → Fin 6 → A.R) :
    CurvatureMass A res = A.zero ↔ ∀ (a : Fin 3) (i j : Fin 6), res a i j = A.zero := by
  dsimp [CurvatureMass]
  have h_inner_nonneg : ∀ a i, ∀ j, A.le A.zero (A.sq (res a i j)) := fun _ _ j => A.sq_nonneg _
  have h_mid_nonneg : ∀ a, ∀ i, A.le A.zero (sumFin6 A (fun j => A.sq (res a i j))) := by
    intro a i
    exact sumFin6_nonneg A (fun j => A.sq (res a i j)) (h_inner_nonneg a i)
  have h_outer_nonneg : ∀ a, A.le A.zero (sumFin6 A (fun i => sumFin6 A (fun j => A.sq (res a i j)))) := by
    intro a
    exact sumFin6_nonneg A _ (h_mid_nonneg a)

  rw [sumFin3_eq_zero_iff A _ h_outer_nonneg]
  constructor
  · intro h a i j
    have ha := h a
    rw [sumFin6_eq_zero_iff A _ (h_mid_nonneg a)] at ha
    have hai := ha i
    rw [sumFin6_eq_zero_iff A _ (h_inner_nonneg a i)] at hai
    have haij := hai j
    exact (A.sq_eq_zero_iff (res a i j)).mp haij
  · intro h a
    rw [sumFin6_eq_zero_iff A _ (h_mid_nonneg a)]
    intro i
    rw [sumFin6_eq_zero_iff A _ (h_inner_nonneg a i)]
    intro j
    exact (A.sq_eq_zero_iff (res a i j)).mpr (h a i j)

