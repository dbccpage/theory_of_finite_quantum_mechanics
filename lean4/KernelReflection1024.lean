/-- Proof that the pairs list contains exactly 1,024 boxes. -/
theorem scaled_pairs_length : scaled_pairs.length = 1024 := by rfl

/-- Exact integer numerator of the global minimum gap across all 1,024 boxes. -/
def scaled_min_gap_num : ℤ := 357917569737583422117771668093255196321921057462368463615510369429199

/-- Exact natural number denominator of the global minimum gap across all 1,024 boxes. -/
def scaled_min_gap_den : ℕ := 542341589937409217995412206165142378351243510401692581914214400000000

/-- Global minimum gap across all 1,024 boxes as a rational number `ℚ`. -/
def scaled_min_gap_rat : ℚ :=
  (357917569737583422117771668093255196321921057462368463615510369429199 : ℚ) / (542341589937409217995412206165142378351243510401692581914214400000000 : ℚ)

/-- The global minimum gap coerced to `ℝ`. -/
noncomputable def scaled_min_gap_real : ℝ := (scaled_min_gap_rat : ℝ)

/-- Verified rational arithmetic: global minimum gap is strictly positive in `ℚ`. -/
theorem scaled_min_gap_rat_pos : 0 < scaled_min_gap_rat := by
  unfold scaled_min_gap_rat
  norm_num

/-- Global minimum gap is strictly positive in `ℝ`. -/
theorem scaled_min_gap_real_pos : 0 < scaled_min_gap_real := by
  unfold scaled_min_gap_real scaled_min_gap_rat
  norm_num

/-- Lemma: a rational quotient of positive integers is positive in `ℚ`. -/
theorem rat_div_pos_of_pos {n : ℤ} {d : ℕ} (hn : 0 < n) (hd : 0 < d) :
    0 < (n : ℚ) / (d : ℚ) := by
  have hn_q : 0 < (n : ℚ) := Int.cast_pos.mpr hn
  have hd_q : 0 < (d : ℚ) := Nat.cast_pos.mpr hd
  exact div_pos hn_q hd_q

/-- Computable decision procedure: checks that every (numerator, denominator) pair has positive components. -/
def check_pairs (l : List (ℤ × ℕ)) : Bool :=
  l.all (fun (n, d) => 0 < n && 0 < d)

/-- Soundness theorem of the decision procedure: if `check_pairs l = true`, then every fraction is positive in `ℚ`. -/
theorem all_pos_of_check_pairs {l : List (ℤ × ℕ)} (h : check_pairs l = true)
    (pair : ℤ × ℕ) (hmem : pair ∈ l) :
    0 < (pair.1 : ℚ) / (pair.2 : ℚ) := by
  have h_all := List.all_eq_true.mp h
  have h_pair := h_all pair hmem
  simp only [Bool.and_eq_true, decide_eq_true_iff] at h_pair
  exact rat_div_pos_of_pos h_pair.1 h_pair.2

/-- **Kernel reflection execution**: the decision procedure evaluates to `true` by reflexivity. -/
theorem scaled_pairs_all_pos_verified : check_pairs scaled_pairs = true := by rfl

/-- Indexing function retrieving the certified rational gap for box `j : Fin 1024`. -/
def scaled_box_gap (j : Fin 1024) : ℚ :=
  let p := scaled_pairs.get ⟨j.val, by rw [scaled_pairs_length]; exact j.isLt⟩
  (p.1 : ℚ) / (p.2 : ℚ)

/-- Coercion of box gap to `ℝ`. -/
noncomputable def scaled_box_gap_real (j : Fin 1024) : ℝ := (scaled_box_gap j : ℝ)

/-- Every box gap in the 1,024-box complex is strictly positive in `ℚ`. -/
theorem scaled_box_gap_pos (j : Fin 1024) : 0 < scaled_box_gap j := by
  unfold scaled_box_gap
  exact all_pos_of_check_pairs scaled_pairs_all_pos_verified _ (List.get_mem scaled_pairs _)

/-- Every box gap in the 1,024-box complex is strictly positive in `ℝ`. -/
theorem scaled_box_gap_real_pos (j : Fin 1024) : 0 < scaled_box_gap_real j := by
  unfold scaled_box_gap_real
  exact Rat.cast_pos.mpr (scaled_box_gap_pos j)

/-- Formal Lean 4 reflection of the Rust/Python scaled certificate for the 1,024-box complex. -/
structure Scaled1024ComplexCertificate {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]
    (e : Fin 18 → E) (K_box : Fin 1024 → Set E) where
  schema_version : String := scaled_schema_version
  seed_dx : ℤ := seed_dx
  seed_dy : ℤ := seed_dy
  region_desc : String := scaled_region_desc
  box_count : ℕ := num_boxes
  complete_flag : Bool := true
  bound_certified : ∀ (j : Fin 1024) (v : E), v ∈ K_box j → (scaled_box_gap_real j) ≤ curvatureMass e (1 / 6) v

/-- **Curvature mass positivity across the entire 1,024-box complex.**
    Witnessed via `MUB.ExtensionCurvatureObstruction.finite_cover_no_feasible`:
    the certified lower bounds on each of the 1,024 contiguous patches force the curvature mass
    `Φ(v)` to be strictly positive on every vector in the union complex `⋃ j, K_box j`. -/
theorem scaled_1024_complex_curvature_mass_pos {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℂ E] (e : Fin 18 → E) (K_box : Fin 1024 → Set E)
    (cert : Scaled1024ComplexCertificate e K_box) :
    ∀ v ∈ (⋃ j : Fin 1024, K_box j), 0 < curvatureMass e (1 / 6) v := by
  intro v hv
  have hcover : ∀ w ∈ (⋃ j : Fin 1024, K_box j), ∃ j ∈ (Finset.univ : Finset (Fin 1024)), w ∈ K_box j := by
    intro w hw
    rcases Set.mem_iUnion.mp hw with ⟨j, hj⟩
    exact ⟨j, Finset.mem_univ j, hj⟩
  have hbound : ∀ j ∈ (Finset.univ : Finset (Fin 1024)), ∀ w ∈ K_box j,
      scaled_box_gap_real j ≤ curvatureMass e (1 / 6) w :=
    fun j _ w hw => cert.bound_certified j w hw
  have hpos : ∀ j ∈ (Finset.univ : Finset (Fin 1024)), 0 < scaled_box_gap_real j :=
    fun j _ => scaled_box_gap_real_pos j
  exact finite_cover_no_feasible (Finset.univ : Finset (Fin 1024)) K_box
    (curvatureMass e (1 / 6)) (⋃ j : Fin 1024, K_box j) hcover
    scaled_box_gap_real hbound hpos v hv

/-- **No mutually unbiased vector across the entire 1,024-box complex.**
    Witnessed via `MUB.FiniteVectorCover.no_mu_vector_in_cover`:
    no vector in the 1,024-box contiguous complex satisfies `‖⟪e i, v⟫‖² = 1/6` for all `i`. -/
theorem scaled_1024_complex_no_mu_vector {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℂ E] (e : Fin 18 → E) (K_box : Fin 1024 → Set E)
    (cert : Scaled1024ComplexCertificate e K_box) :
    ∀ v ∈ (⋃ j : Fin 1024, K_box j), ¬ ∀ i, ‖⟪e i, v⟫_ℂ‖ ^ 2 = 1 / 6 := by
  have hcover : ∀ w ∈ (⋃ j : Fin 1024, K_box j), ∃ j ∈ (Finset.univ : Finset (Fin 1024)), w ∈ K_box j := by
    intro w hw
    rcases Set.mem_iUnion.mp hw with ⟨j, hj⟩
    exact ⟨j, Finset.mem_univ j, hj⟩
  have hbound : ∀ j ∈ (Finset.univ : Finset (Fin 1024)), ∀ w ∈ K_box j,
      scaled_box_gap_real j ≤ curvatureMass e (1 / 6) w :=
    fun j _ w hw => cert.bound_certified j w hw
  have hpos : ∀ j ∈ (Finset.univ : Finset (Fin 1024)), 0 < scaled_box_gap_real j :=
    fun j _ => scaled_box_gap_real_pos j
  exact no_mu_vector_in_cover (Finset.univ : Finset (Fin 1024)) K_box
    (⋃ j : Fin 1024, K_box j) e (1 / 6) hcover
    scaled_box_gap_real hbound hpos

/-- Direct derivation of the scaled complex vector no-go combining
    `scaled_1024_complex_curvature_mass_pos` and `curvatureMass_eq_zero_iff`. -/
theorem scaled_1024_complex_no_mu_vector_alt {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℂ E] (e : Fin 18 → E) (K_box : Fin 1024 → Set E)
    (cert : Scaled1024ComplexCertificate e K_box) :
    ∀ v ∈ (⋃ j : Fin 1024, K_box j), ¬ ∀ i, ‖⟪e i, v⟫_ℂ‖ ^ 2 = 1 / 6 := by
  intro v hv hMU
  have hpos : 0 < curvatureMass e (1 / 6) v :=
    scaled_1024_complex_curvature_mass_pos e K_box cert v hv
  rw [(curvatureMass_eq_zero_iff e (1 / 6) v).mpr hMU] at hpos
  exact lt_irrefl 0 hpos

/-- Induced basis patches for candidate fourth bases whose first column belongs to box `j`. -/
def basis_patch (K_box : Fin 1024 → Set (Fin 6 → ℂ)) (j : Fin 1024) :
    Set (Matrix.unitaryGroup (Fin 6) ℂ) :=
  { U | (fun k => (U : Matrix (Fin 6) (Fin 6) ℂ) k 0) ∈ K_box j }

/-- Complex of candidate fourth bases whose first column belongs to the 1,024-box complex. -/
def basis_complex (K_box : Fin 1024 → Set (Fin 6 → ℂ)) :
    Set (Matrix.unitaryGroup (Fin 6) ℂ) :=
  ⋃ j : Fin 1024, basis_patch K_box j

/-- **Direct connection to `MUB.FiniteBasisCover.no_fourth_basis_in_cover` and `finite_cover_no_feasible`:**
    No candidate fourth basis in `basis_complex K_box` is mutually unbiased to the seed triple `e`. -/
theorem scaled_1024_complex_no_fourth_basis_in_cover
    (e : Fin 18 → (Fin 6 → ℂ)) (K_box : Fin 1024 → Set (Fin 6 → ℂ))
    (hbound_basis : ∀ j ∈ (Finset.univ : Finset (Fin 1024)), ∀ U ∈ basis_patch K_box j,
      scaled_box_gap_real j ≤ basisCurvatureMass e (1 / 6) U) :
    ∀ U ∈ basis_complex K_box, ¬ ∀ j i, ‖overlap e U i j‖ ^ 2 = 1 / 6 := by
  have hcover : ∀ U ∈ basis_complex K_box, ∃ j ∈ (Finset.univ : Finset (Fin 1024)), U ∈ basis_patch K_box j := by
    intro U hU
    rcases Set.mem_iUnion.mp hU with ⟨j, hj⟩
    exact ⟨j, Finset.mem_univ j, hj⟩
  have hpos : ∀ j ∈ (Finset.univ : Finset (Fin 1024)), 0 < scaled_box_gap_real j :=
    fun j _ => scaled_box_gap_real_pos j
  exact no_fourth_basis_in_cover (Finset.univ : Finset (Fin 1024)) (basis_patch K_box)
    (basis_complex K_box) e (1 / 6) hcover
    scaled_box_gap_real hbound_basis hpos

