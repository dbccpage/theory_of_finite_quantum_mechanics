+    fn morph_map(&self, f: &Morph<Node, Node>, x: &Color) -> Option<Color> {
+        // Only one non-id morphism: A → B
+        if f.from == Node::A && f.to == Node::B {
+            match x {
+                Color::Red | Color::Blue => Some(Color::Green),
+                _ => None,
+            }
+        } else {
+            None // No other morphisms defined
+        }
+    }
