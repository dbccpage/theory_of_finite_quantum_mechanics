+                ),
+            ));
+        } else if morphisms_to_terminal.len() > 1 {
+            violations.push(limit_violation(
+                LimitValidation::UniversalProperty,
+                ValidationLocation::Object(object.clone()),
+                format!(
+                    "Multiple morphisms {:?} from {} to terminal object {}",
