+        .as_deref()
+        .ok_or_else(|| problem(RewriteInvariant::GlobularBoundary, &cell.name))?;
+    let target = cell
+        .target
+        .as_deref()
+        .ok_or_else(|| problem(RewriteInvariant::GlobularBoundary, &cell.name))?;
