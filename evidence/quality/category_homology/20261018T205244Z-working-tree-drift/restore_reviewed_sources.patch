+
+    // Associativity law: h(T(h)(x)) = h(join(x)) for x: T<T<A>>
+    fn associativity_law(&self) -> bool
+    where
+        A: Clone + Eq,
+        M::T<A>: Clone,
+        M::T<M::T<A>>: Clone,
+    {
