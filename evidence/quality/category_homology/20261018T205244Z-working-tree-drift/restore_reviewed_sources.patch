+fn check_paths(sys: &InfinityRewriteSystem) -> Vec<RewriteError> {
+    sys.paths
+        .iter()
+        .filter(|p| sys.path_boundary(p).is_none())
+        .map(|p| problem(RewriteInvariant::Path, &p.name))
+        .collect()
