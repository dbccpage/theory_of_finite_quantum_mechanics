+pub struct ColorFunctor;
+
+impl SetValuedFunctor<BaseCategory<Node>> for ColorFunctor {
+    type Element = Color;
+
+    fn obj_map(&self, c: &Node) -> Vec<Color> {
+        match c {
+            Node::A => vec![Color::Red, Color::Blue],
+            Node::B => vec![Color::Green],
+        }
+    }
