+type RuleIndex<'a> = BTreeMap<&'a str, &'a RewriteRule>;
+
+fn check_cell(
+    sys: &InfinityRewriteSystem,
+    rules: &RuleIndex<'_>,
+    key: &str,
+    cell: &RewriteCell,
+) -> Result<(), RewriteError> {
+    if key != cell.name {
+        return Err(problem(RewriteInvariant::CellKey, key));
+    }
+    match cell.level {
+        0 => check_term(cell),
+        1 => check_edge(sys, rules, cell),
+        2 => check_two_cell(sys, cell),
+        _ => check_higher_cell(sys, cell),
+    }
