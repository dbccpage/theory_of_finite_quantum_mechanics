{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SourceBoundContractV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "AuthorityEffect", "artifact", "contract_urn", "status", "target", "profile", "purpose", "subject_role", "compilation", "declaration_index", "declaration_index_scope", "requirements", "admission_policy", "resource_boundary", "authority_ceiling", "open_obligations", "evidence"],
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reference": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"$ref": "#/$defs/text"}, "sha256": {"$ref": "#/$defs/digest"}}
    }
  },
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "AuthorityEffect": {"const": "None"},
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "language"],
      "properties": {
        "path": {"type": "string", "pattern": "^code/rust/src/(holonomy|homology|homotopy_type_theory|lie_theory|linear_algebra|local_green_global_red_lggr)/.+$"},
        "sha256": {"$ref": "#/$defs/digest"},
        "language": {"enum": ["Rust", "Other"]}
      }
    },
    "contract_urn": {"type": "string", "pattern": "^urn:tfqm:contract:.+$"},
    "status": {"$ref": "#/$defs/text"},
    "target": {"const": "L4A"},
    "profile": {"enum": ["Exact", "Quantized", "Numerical", "Symbolic / Formal", "Non-Numeric"]},
    "purpose": {"$ref": "#/$defs/text"},
    "subject_role": {"$ref": "#/$defs/text"},
    "compilation": {
      "type": "object", "additionalProperties": false,
      "required": ["disabled_by_cfg_any", "test_or_support_file"],
      "properties": {"disabled_by_cfg_any": {"type": "boolean"}, "test_or_support_file": {"type": "boolean"}}
    },
    "declaration_index": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "name", "line", "declaration_line"],
        "properties": {
          "kind": {"enum": ["fn", "struct", "enum", "trait", "type", "const", "mod"]},
          "name": {"$ref": "#/$defs/text"}, "line": {"type": "integer", "minimum": 1},
          "declaration_line": {"$ref": "#/$defs/text"}
        }
      }
    },
    "declaration_index_scope": {"$ref": "#/$defs/text"},
    "requirements": {
      "type": "array", "minItems": 5, "maxItems": 5,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "requirement"],
        "properties": {"id": {"enum": ["G1", "G2", "G3", "G4", "G5"]}, "requirement": {"$ref": "#/$defs/text"}}
      },
      "allOf": [
        {"contains": {"properties": {"id": {"const": "G1"}}}},
        {"contains": {"properties": {"id": {"const": "G2"}}}},
        {"contains": {"properties": {"id": {"const": "G3"}}}},
        {"contains": {"properties": {"id": {"const": "G4"}}}},
        {"contains": {"properties": {"id": {"const": "G5"}}}}
      ]
    },
    "admission_policy": {"$ref": "#/$defs/text"},
    "resource_boundary": {"$ref": "#/$defs/text"},
    "authority_ceiling": {"$ref": "#/$defs/text"},
    "open_obligations": {"type": "array", "items": {"$ref": "#/$defs/text"}},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/reference"}},
    "manifest": {"type": "object"},
    "reviewed_specification": {"type": "object", "minProperties": 1}
  }
}
