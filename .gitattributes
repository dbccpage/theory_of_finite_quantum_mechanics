# Preserve LF line endings across platforms for source files and mechanization
*.lean text eol=lf
*.rs text eol=lf
*.py text eol=lf

# Keep the exact bytes bound by category/homology source and evidence receipts.
code/rust/src/category_theory/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
code/rust/src/homology/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
code/rust/quality/category_homology/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
evidence/quality/category_homology/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
