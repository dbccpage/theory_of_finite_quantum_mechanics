  "groups": {
    "admit": {
      "requirement": "Own a degree2or3 lexicographic table of exactly4or8 native integer signs. Native group coordinates are0or1. Invalid types/lower bounds are input refusals; upper degree/coordinate/sequence budgets are resource refusals.",
      "tests": [
        "test_exact_degrees_signs_and_shapes",
        "test_operation_degree_and_operand_refusals",
        "test_admission_precedes_dependent_operations"
      ]
    },
    "evaluate": {
      "requirement": "Snapshot the table and preserve lexicographic point indexing. Multiply equal-degree tables pointwise with exact signs. Normalization means +1 whenever any coordinate is zero.",
      "tests": [
        "test_generated_point_order_products_and_owned_snapshots",
        "test_all_degree_two_boundaries_against_boolean_oracle",
        "test_all_degree_three_cochains_and_pentagon_points"
      ]
    },
    "boundary": {
      "requirement": "Compute the degree2coboundary and degree3pentagon with trivial action and Z2coordinate addition. Sign inverses equal themselves.",
      "tests": [
        "test_all_degree_two_boundaries_against_boolean_oracle",
        "test_all_degree_three_cochains_and_pentagon_points",
        "test_rephasing_and_generator_sign_for_all_two_cochains"
      ]
    },
    "audit": {
      "requirement": "Preserve the original sixteen pentagons and sixteen candidate2cochains, including two normalized cochains and the surviving negative generator. A supplied candidate is accepted exactly when its finite certificate passes. Record26actual successful calls per default run.",
      "tests": [
        "test_all_candidates_and_actual_case_count",
        "test_rephasing_and_generator_sign_for_all_two_cochains",
        "test_quiet_import_and_original_cli"
      ]
    },
    "lifecycle": {
      "requirement": "Keep owned values immutable, imports quiet and case counters fresh. Public fallible queries return Outcome; constructors/internal workers raise typed Violation. CLI refusals are nonzero; unexpected exceptions and cancellation propagate.",
      "tests": [
        "test_generated_point_order_products_and_owned_snapshots",
        "test_failure_translation_and_unexpected_exceptions",
        "test_quiet_import_and_original_cli",
        "test_all_candidates_and_actual_case_count",
        "test_admission_precedes_dependent_operations"
      ]
    }
  },
