    "checks/independent/auth-rice-theorem-import.py": {
      "role": "Finite semantics aggregate with validated immutable behavior tables, stable behavioral quotients and checked descent of Boolean code predicates",
      "profile": "Exact",
      "origin": "lean4/ComputabilityRiceTheoremImport.lean",
      "cost": "At most 64 code rows and 32 carrier points; at most 2048 small integer entries. Admission and identity comparisons cost O(c*n). Stable grouping uses expected O(c*n) tuple hashing and O(c*n) storage, with a bounded O(c*c*n) worst case for hash collisions. Property descent costs O(c) after grouping. No infinite-language quantification or evaluation is implemented.",
      "groups": [
        {
          "requirement": "Admit a nonempty rectangular total behavior table over its own finite carrier, rejecting bool/float/out-of-range values and oversize dimensions; snapshot nested rows.",
          "symbols": [
            "FiniteBehaviorCarrier",
            "FiniteBehaviorCarrier.__post_init__",
            "FiniteBehaviorCarrier.behavior"
          ],
          "tests": [
            "AuthorityCheckerTests.test_behavior_constructor_and_property_refusals",
            "AuthorityCheckerTests.test_behavior_snapshot_and_maximum_table"
          ],
          "requirement_id": "TFQM-AUTH-REVIEW-AUTH-RICE-THEOREM-IMPORT-1"
        },
        {
          "requirement": "Compute identity predicates and a complete disjoint behavior partition in first-code order; descend a Boolean predicate exactly when constant on every class, returning typed refusal otherwise.",
          "symbols": [
            "FiniteBehaviorCarrier.identity_bits",
            "FiniteBehaviorCarrier.equivalence_classes",
            "FiniteBehaviorCarrier.factor_property",
            "FiniteBehaviorCarrier._factor_property"
          ],
          "tests": [
            "AuthorityCheckerTests.test_generated_behavior_equivalence_and_descent",
            "AuthorityCheckerTests.test_behavior_partition_and_all_three_code_predicates",
            "AuthorityCheckerTests.test_behavior_constructor_and_property_refusals"
          ],
          "requirement_id": "TFQM-AUTH-REVIEW-AUTH-RICE-THEOREM-IMPORT-2"
        },
        {
          "requirement": "Preserve the original three-code/two-point behavior and separate identity from syntactic code-zero predicates, with validated wrapper indices.",
          "symbols": [
            "beh",
            "id_bit",
            "code_zero"
          ],
          "tests": [
            "AuthorityCheckerTests.test_behavior_partition_and_all_three_code_predicates",
