    "checks/independent/authf-carrier-admission-gate.py": {
      "role": "Source-bound direct-candidate ceiling verifier with schema/identity admission, immutable status value object, bounded JSON lifecycle and Railway verification",
      "profile": "Non-Numeric",
      "origin": "lean4/CarrierAdmissionGate.lean",
      "cost": "Reads at most 1 MiB plus one overflow byte exactly once and scans O(bytes) with constant scanner state. JSON is bounded to 128 nested containers before parsing; candidate selection visits at most 64 entries. File handles close before record verification. SHA-256 binds the same bytes parsed, not a later file reread.",
      "groups": [
