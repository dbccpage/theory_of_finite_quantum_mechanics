          ],
          "requirement_id": "TFQM-LINEON-REVIEW-CHECK-TFQ-1219-FSP-HINGE-LINEON-SIGN-CLAIM-1"
        },
        {
          "requirement": "Validate and snapshot unit trajectories before observation. Swapped ordered endpoints and equal nonzero lengths are required for an exchange witness. Preserve legacy (bool,index) result: prefer first site meeting, otherwise first left-to-right edge start; no exchange is (False,-1). Simultaneous unit hops permit edge crossings and are broader than the Lean relative-step<=1 site theorem.",
          "symbols": [
            "validate_unit_trajectory",
            "verify_discrete_ivt_collision_site"
          ],
          "tests": [
