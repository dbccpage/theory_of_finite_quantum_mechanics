        },
        {
          "requirement": "Validate both GaussianMatrix2 operands before inversion, use exact shared operations and return commutator trace. Singular or resource-exceeding operations refuse through the shared boundary. No inference from noncommutation to negative trace or from type alone to SU(2) membership.",
          "symbols": [
            "compute_commutator_holonomy_trace"
          ],
          "tests": [
            "LineonCheckerTests.test_commutator_against_symbolic_matrix_oracle",
