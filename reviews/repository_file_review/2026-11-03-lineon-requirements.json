          ],
          "requirement_id": "TFQM-LINEON-REVIEW-CHECK-TFQ-1219-FSP-HINGE-LINEON-SIGN-CLAIM-5"
        },
        {
          "requirement": "Compose fixed path, matrix, trace-map and Y-junction cases through Cases. The default 77 unique obligations count each conjunction once. The Y exchange sign is supplied convention, no general fermionic weight result. Keep truthful JSON/nonzero CLI, invocation ownership, typed resources and cancellation.",
          "symbols": [
