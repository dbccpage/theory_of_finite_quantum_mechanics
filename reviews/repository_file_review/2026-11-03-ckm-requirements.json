          "requirement_id": "TFQM-CKM-REVIEW-DFM-CKM-PHYSICS-FENCE-1"
        },
        {
          "requirement": "Require actual GaussianRational values at every quartet position before accessing methods; zero is permitted in quartets. Rephasing labels and gauges require nonzero values. Compute a*b*conj(c)*conj(d) exactly using the reviewed bounded Gaussian value.",
          "symbols": [
            "_gaussian",
            "quartet",
            "_gauges"
          ],
          "tests": [
            "CkmCheckerTests.test_quartets_against_complex_oracle",
