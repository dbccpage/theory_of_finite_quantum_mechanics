    "checks/independent/dfm-ckm-physics-fence.py": {
      "role": "Bounded exact Gaussian-rephasing verification application with owned nonzero-table aggregate, constructive gauge witnesses, typed operations and accounted CLI failures",
      "origin": "lean4/DressingFieldCkmPhysicsFence.lean",
      "profile": "Exact",
      "cost": "Each table dimension1..64, at most4096 cells. Admission, normalization, action and witness are O(height*width) with a fixed number of bounded Gaussian operations per cell. Stored Gaussian components and each returned polynomial value have<=4096-bit numerator/denominator; shared Gaussian norm/inverse intermediates have their separately corrected fixed-operation bounds, and conservative refusals may precede cancellation. Sign enumeration requires dimensions1..6 and product<=6 before enumeration:<=64 tables,4096 pairs,128 gauge assignments per table. Default11381 obligations include2376 sign actions and4388 pair decisions.",
      "groups": [
        {
          "requirement": "Admit exact rational parameters excluding bool/float/subclass coercion, enforce4096-bit input/output bounds and evaluate the three rational polynomials on signed/fractional inputs without interpreting them as measured physical counts.",
          "symbols": [
            "exact_rational",
            "cycle_count",
            "constraint_count",
            "cp_count"
          ],
          "tests": [
