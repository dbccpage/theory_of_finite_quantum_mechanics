    "checks/independent/ct-local-mediator-entanglement-import.py": {
      "role": "Exact symbolic and finite pure-state verification application with typed per-run recorders, normalized bounded Gaussian-phase concurrence, independently replayed rank cases and explicit mediator-claim boundaries",
      "origin": "lean4/ConstructorTheoryMediatorEntanglement.lean",
      "profile": "Exact",
      "cost": "Symbolic expressions have fixed2x2 dimensions and fixed variable sets, with no caller-supplied expressions. The deterministic rank family has300 matrices with dimensions<=5 and entries generated from -3..3, including rank-one products. Phase input components<=4096 bits; derived norm/defect/normalizer/denominator/result admitted to4096 bits. Intermediate Gaussian norm components are bounded by fixed operations on those inputs, with no unbounded iterative algebra. Default318 attempted require calls in seven groups; false obligations stop the run.",
      "groups": [
        {
          "requirement": "Use an explicit Cases recorder or create one for a direct group invocation. Reject foreign recorder objects. Count actual require calls, preserve typed mathematical failure and cancellation, and print318 obligations across seven groups on the default successful run.",
          "symbols": [
