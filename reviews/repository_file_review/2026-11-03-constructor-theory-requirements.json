        },
        {
          "requirement": "Check fixed symbolic determinant multiplicativity and the nonzero/zero M00 charts, pure product determinant preservation and row-major Kronecker vectorisation. A supplied product-vector branch is a pair of local maps; it does not establish a mediator model or general LOCC behavior.",
          "symbols": [
            "check_symbolic_local_action_determinant",
            "check_product_state_zero_determinant",
            "check_product_branch_preservation",
            "check_kron_vectorisation_matches_AMBT"
