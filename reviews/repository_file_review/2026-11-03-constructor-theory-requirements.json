          ],
          "requirement_id": "TFQM-CT-REVIEW-CT-LOCAL-MEDIATOR-ENTANGLEMENT-IMPORT-2"
        },
        {
          "requirement": "Use the correct norm for the general two-qubit phase family and its exact Pythagorean unit phase. The reusable API admits Gaussian-rational input, bounds derived values and returns exact normalized concurrence rather than a clipped number or an unnormalized determinant expression.",
          "symbols": [
            "check_phase_family_determinant_and_concurrence",
            "check_exact_pythagorean_concurrence",
            "normalized_concurrence_squared"
          ],
          "tests": [
            "ConstructorTheoryTests.test_concurrence_against_complex_matrix_normalization",
