        },
        {
          "requirement": "Validate recorded factors, fixture purity, all interval lengths and the 340/40 equality-deficit partition, disconnected mutual information and supplied Hilbert dimensions. The fixture is hand-encoded, not derived tensor contraction.",
          "symbols": [
            "check_renyi_factors",
            "check_interval_census",
            "check_mutual_information_and_codimension"
          ],
          "tests": [
            "AdsCheckerTests.test_runtime_counts_and_repeatable_reports",
            "AdsCheckerTests.test_fixture_mismatch_refusals"
          ],
          "requirement_id": "TFQM-ADS-REVIEW-ADS-HAPPY-TOY-NOT-DUALITY-GAP-2"
        },
        {
          "requirement": "Each complete invocation owns three Cases aggregates and publishes only counted successful obligations; check failure exits nonzero with typed evidence.",
