    "checks/independent/ads-happy-toy-not-duality-gap.py": {
      "role": "Finite entropy-census checker composing validated exact Renyi operations with pure-state admission, finite graph/entropy interfaces and invocation-local accounting",
      "profile": "Exact",
      "origin": "lean4/AdsHappyToyNotDualityGap.lean",
      "cost": "Rational inputs are 4096-bit bounded. Renyi operations are fixed-degree exact arithmetic; 499 check calls include all 380 proper boundary intervals. Graph cuts enumerate 64 assignments on six internal vertices; entropy ranks use at most 20 rows of 40 bits. The supplied commuting rank-20 fixture is validated by the source-bound shared support.",
      "groups": [
        {
          "requirement": "Admit positive rational Renyi order and nonnegative entropy, retain negative defects below order one and compute exact flat/CFT factors.",
