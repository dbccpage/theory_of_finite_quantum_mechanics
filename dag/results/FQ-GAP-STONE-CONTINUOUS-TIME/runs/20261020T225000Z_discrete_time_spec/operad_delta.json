    {
      "id": "DT-05",
      "name": "No rational half-step, hence no Q-parameter group through R345",
      "inputs": "Any rational 2 x 2 matrix V with V*V = R345; any Q-parameter group of invertible rational 2 x 2 matrices",
      "output_or_relation": "V commutes with R345, so V = [[p,-r],[r,p]] with p^2 = 4/5, which is not a rational square (den 5); therefore no Q-parameter group has R345 as its unit step",
      "status": "KERNEL_CHECKED_TYPED_OPERATION",
