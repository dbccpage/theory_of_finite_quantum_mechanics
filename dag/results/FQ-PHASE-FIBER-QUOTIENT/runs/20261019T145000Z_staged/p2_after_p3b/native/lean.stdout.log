QuantumMechanics.PromptPhaseScope.d2_no_quadratic :
  ¬∃ a b c, ∀ (x y : ℚ), x ≠ 0 ∨ y ≠ 0 → a * x * x + 2 * b * x * y + c * y * y = binaryRay x y * (x * x + y * y)
QuantumMechanics.PromptPhaseScope.d2_frame_sum (x y u v : ℚ) (hxy : x ≠ 0 ∨ y ≠ 0) (huv : u ≠ 0 ∨ v ≠ 0)
  (horth : x * u + y * v = 0) : binaryRay x y + binaryRay u v = 1
QuantumMechanics.PromptPhaseScope.d2_scale (x y k : ℚ) (hk : k ≠ 0) : binaryRay (k * x) (k * y) = binaryRay x y
QuantumMechanics.PromptPhaseScope.interference_no_descent :
  ¬∃ f, ∀ (v : Vec GaussInt Bool), readout v = f (phaseBlind v)
QuantumMechanics.PromptPhaseScope.interference_mass_doubles :
  totalWeight enumBool (mix psi1) = 2 * totalWeight enumBool psi1 ∧
    totalWeight enumBool (mix psi2) = 2 * totalWeight enumBool psi2
QuantumMechanics.PromptPhaseScope.zero_integer_row_characterization (M : BornRedundancy.Mat2) :
  BornRedundancy.DescentCompatible M ↔ BornRedundancy.RowSparse M
QuantumMechanics.PromptPhaseScope.fiber_relative : ZeroRel (phasePD Bool) psi1 psi2 ∧ psi1 ≠ psi2
QuantumMechanics.PromptPhaseScope.fiber_global {Q : Type} (v : Vec GaussInt Q) :
  ZeroRel (phasePD Q) (fun x => GaussInt.gi.gmul (v x)) v
QuantumMechanics.PromptPhaseScope.fiber_equivalence {Q : Type} (u v : Vec GaussInt Q) :
  ZeroRel (phasePD Q) u v ↔ phaseBlind u = phaseBlind v
