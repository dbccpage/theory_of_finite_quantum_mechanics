QuantumMechanics.PromptPhaseScope.d2_no_quadratic :
  ¬∃ a b c,
      ∀ (x y : ℚ),
        x ≠ 0 ∨ y ≠ 0 →
          a * x * x + 2 * b * x * y + c * y * y = FiniteQm.GleasonRationalPlane.binaryRay x y * (x * x + y * y)
QuantumMechanics.PromptPhaseScope.d2_frame_sum (x y u v : ℚ) (hxy : x ≠ 0 ∨ y ≠ 0) (huv : u ≠ 0 ∨ v ≠ 0)
  (horth : x * u + y * v = 0) :
  FiniteQm.GleasonRationalPlane.binaryRay x y + FiniteQm.GleasonRationalPlane.binaryRay u v = 1
QuantumMechanics.PromptPhaseScope.d2_scale (x y k : ℚ) (hk : k ≠ 0) :
  FiniteQm.GleasonRationalPlane.binaryRay (k * x) (k * y) = FiniteQm.GleasonRationalPlane.binaryRay x y
QuantumMechanics.PromptPhaseScope.interference_no_descent :
  ¬∃ f,
      ∀ (v : FableHilbertWalk20260819.H004.Vec FableHilbertWalk20260819.HWKernel.GaussInt Bool),
        FableHilbertWalk20260819.H010.readout v = f (FableHilbertWalk20260819.H008.phaseBlind v)
QuantumMechanics.PromptPhaseScope.interference_mass_doubles :
  FableHilbertWalk20260819.H008.totalWeight FableHilbertWalk20260819.HWKernel.enumBool
        (FableHilbertWalk20260819.H010.mix FableHilbertWalk20260819.H008.psi1) =
      2 *
        FableHilbertWalk20260819.H008.totalWeight FableHilbertWalk20260819.HWKernel.enumBool
          FableHilbertWalk20260819.H008.psi1 ∧
    FableHilbertWalk20260819.H008.totalWeight FableHilbertWalk20260819.HWKernel.enumBool
        (FableHilbertWalk20260819.H010.mix FableHilbertWalk20260819.H008.psi2) =
      2 *
        FableHilbertWalk20260819.H008.totalWeight FableHilbertWalk20260819.HWKernel.enumBool
          FableHilbertWalk20260819.H008.psi2
QuantumMechanics.PromptPhaseScope.zero_integer_row_characterization (M : BornRedundancy.Mat2) :
  BornRedundancy.DescentCompatible M ↔ BornRedundancy.RowSparse M
QuantumMechanics.PromptPhaseScope.fiber_relative :
  GrokPdNight20260814.Core.ZeroRel (FableHilbertWalk20260819.H009.phasePD Bool) FableHilbertWalk20260819.H008.psi1
      FableHilbertWalk20260819.H008.psi2 ∧
    FableHilbertWalk20260819.H008.psi1 ≠ FableHilbertWalk20260819.H008.psi2
QuantumMechanics.PromptPhaseScope.fiber_global {Q : Type}
  (v : FableHilbertWalk20260819.H004.Vec FableHilbertWalk20260819.HWKernel.GaussInt Q) :
  GrokPdNight20260814.Core.ZeroRel (FableHilbertWalk20260819.H009.phasePD Q)
    (fun x => FableHilbertWalk20260819.HWKernel.GaussInt.gi.gmul (v x)) v
QuantumMechanics.PromptPhaseScope.fiber_equivalence {Q : Type}
  (u v : FableHilbertWalk20260819.H004.Vec FableHilbertWalk20260819.HWKernel.GaussInt Q) :
  GrokPdNight20260814.Core.ZeroRel (FableHilbertWalk20260819.H009.phasePD Q) u v ↔
    FableHilbertWalk20260819.H008.phaseBlind u = FableHilbertWalk20260819.H008.phaseBlind v
