namespace PR500Review
open BornFinite BornFinite.GaussianFrames BornFinite.GaussianTomography BornFinite.GleasonBridge
-- A concrete satisfiable model of both hypotheses; this is not general Born-form continuity.
theorem uniform_input_nonvacuous :
    ∃ f : GVec → ℚ, IsFrameFunction f ∧ IsUniformlyRayContinuous f := by
  refine ⟨fun _ => 1 / 3, ?_, ?_⟩
  · intro u v w hfr
    norm_num
  · intro ε hε
    refine ⟨1, by norm_num, ?_⟩
    intro u v hu hv hdist
    simpa using hε
-- Lock the literal statement: no added pole, boundedness, sign or extension premise.
example {f : GVec → ℚ} (hf : IsFrameFunction f) (hc : IsUniformlyRayContinuous f) :
    ∀ v, v.NonZero → f v = quadRay (tomographyForm f) v :=
  born_of_uniformlyRayContinuous hf hc
-- The nonnegative specialization yields a positive numerator on rational vectors.
theorem rational_numerator_nonneg {f : GVec → ℚ} (hf : IsNonnegFrameFunction f)
    (hc : IsUniformlyRayContinuous f) {v : GVec} (hv : v.NonZero) :
    0 ≤ quadNum (tomographyForm f) v := by
  have h := hf.2 v hv
  rw [born_of_uniformlyRayContinuous hf.1 hc v hv, quadRay] at h
  have hm := mul_nonneg h (le_of_lt (normSqVec_pos_of_nonZero hv))
  simpa only [div_mul_cancel₀ _ (ne_of_gt (normSqVec_pos_of_nonZero hv))] using hm
end PR500Review
