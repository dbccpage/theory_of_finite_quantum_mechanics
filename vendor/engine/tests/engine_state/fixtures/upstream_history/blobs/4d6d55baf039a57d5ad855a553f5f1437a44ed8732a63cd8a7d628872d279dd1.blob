#[derive(Debug, Clone, PartialEq, Eq, Error)]
pub enum Gtoc6Error {
    #[error("the packet differs from the frozen S06-003 packet")]
    PacketDrift,
    #[error("the frozen packet boundary changed")]
    PacketBoundaryChanged,
    #[error("the receipt does not bind to the frozen packet")]
    ReceiptBindingMismatch,
    #[error("verification attempted to expand authority")]
    AuthorityExpanded,
    #[error("missing frozen artifact: {0}")]
    MissingArtifact(String),
    #[error("the frozen artifact set changed")]
    ArtifactSetMismatch,
    #[error("artifact length mismatch: {0}")]
    ArtifactLengthMismatch(String),
    #[error("artifact hash mismatch: {0}")]
    ArtifactHashMismatch(String),
    #[error("invalid predecessor artifact: {0}")]
    InvalidPredecessor(String),
    #[error("defect count mismatch: expected {expected}, found {found}")]
    DefectCountMismatch { expected: usize, found: usize },
    #[error("defect attribution mismatch: {0}")]
    DefectAttributionMismatch(String),
    #[error("duplicate defect id: {0}")]
    DuplicateDefectId(String),
    #[error("duplicate subclaim id: {0}")]
    DuplicateSubclaimId(String),
    #[error("subclaim count mismatch for {defect_id}: expected {expected}, found {found}")]
    SubclaimCountMismatch {
        defect_id: String,
        expected: usize,
        found: usize,
    },
    #[error("subclaim attribution mismatch: {0}")]
    SubclaimAttributionMismatch(String),
    #[error("diagnostic evidence mismatch: {0}")]
    DiagnosticEvidenceMismatch(String),
    #[error("diagnostic resolved to Invalid: {0}")]
    InvalidDiagnostic(String),
    #[error(
        "subclaim terminal mismatch for {subclaim_id}: expected {expected:?}, found {found:?}"
    )]
    SubclaimTerminalMismatch {
        subclaim_id: String,
        expected: GtocTerminal,
        found: GtocTerminal,
    },
    #[error("subclaim residual mismatch: {0}")]
    SubclaimResidualMismatch(String),
    #[error("defect terminal mismatch for {defect_id}: expected {expected:?}, found {found:?}")]
    DefectTerminalMismatch {
        defect_id: String,
        expected: GtocTerminal,
        found: GtocTerminal,
    },
    #[error("defect residual mismatch: {0}")]
    DefectResidualMismatch(String),
    #[error("duplicate residual id: {0}")]
    DuplicateResidualId(String),
    #[error("the residual ledger differs from recomputed diagnostics")]
    ResidualLedgerMismatch,
    #[error("aggregate terminal mismatch: expected {expected:?}, found {found:?}")]
    AggregateTerminalMismatch {
        expected: GtocTerminal,
        found: GtocTerminal,
    },
    #[error("aggregation truth row failed: {0}")]
    AggregationTruthMismatch(String),
    #[error("cannot aggregate an empty terminal set")]
    EmptyTerminalSet,
    #[error("empty required field: {0}")]
    EmptyField(String),
    #[error("JSON operation failed: {0}")]
    Json(String),
    #[error("JSON input is invalid: {0}")]
    Decode(String),
    #[error("{0} is not canonical JSONL")]
    NonCanonicalJson(String),
}

impl Gtoc6Error {
    pub fn terminal_route(&self) -> GtocTerminal {
        match self {
            Self::MissingArtifact(_) | Self::Json(_) => GtocTerminal::InfrastructureFailure,
            Self::AuthorityExpanded => GtocTerminal::Refused,
            _ => GtocTerminal::Invalid,
        }
    }
}

pub fn canonical_s06_003_packet_v1() -> Gtoc6DefectTerminalizationPacketV1 {
    let source_manifest = S06_003_SOURCE_MANIFEST
        .iter()
        .map(|(path, sha256, bytes)| FrozenGtoc6SourceV1 {
            path: (*path).to_owned(),
            sha256: (*sha256).to_owned(),
            bytes: *bytes,
        })
        .collect::<Vec<_>>();
    let input_artifacts = S06_003_INPUT_ARTIFACTS
        .iter()
        .map(|(path, sha256, bytes)| Gtoc6ArtifactBindingV1 {
            path: (*path).to_owned(),
            sha256: (*sha256).to_owned(),
            bytes: *bytes,
        })
        .collect::<Vec<_>>();
    let observer = FrozenGtoc6ObserverV1 {
        observer_id: S06_003_EVALUATOR_ID.to_owned(),
        source_manifest_sha256: sha256_json_v1(&source_manifest)
            .expect("frozen source manifest must serialize"),
        visible_artifact_sha256: input_artifacts
            .iter()
            .map(|artifact| artifact.sha256.clone())
            .collect(),
        hidden_context_classes: vec![
            "authorized_local_result_constructor".to_owned(),
            "dynamic_defect_registry".to_owned(),
            "human_promotion_state".to_owned(),
            "model_context".to_owned(),
            "production_credentials".to_owned(),
            "s14_005_gtoc5_construction_receipt".to_owned(),
        ],
        model_context_available: false,
        promotion_constructor_available: false,
        authorized_local_result_constructor_available: false,
        authority_effect: AuthorityEffect::None,
    };
    let observer_sha256 =
        sha256_json_v1(&observer).expect("frozen observer must serialize deterministically");
    Gtoc6DefectTerminalizationPacketV1 {
        schema_version: GTOC6_PACKET_SCHEMA_VERSION.to_owned(),
        packet_id: S06_003_PACKET_ID.to_owned(),
        goal_id: S06_003_GOAL_ID.to_owned(),
        frozen_base: S06_003_FROZEN_BASE.to_owned(),
        observer,
        observer_sha256,
        source_manifest,
        input_artifacts,
        defects: canonical_defect_specs_v1(),
        aggregation_truth_table: canonical_aggregation_truth_table_v1(),
        legal_terminals: GtocTerminal::ALL.to_vec(),
        budgets: Gtoc6BudgetsV1 {
            attempt_budget: 1,
            repair_budget: 2,
            successor_budget: 1,
            time_budget_seconds: 28_800,
            process_budget: 4,
            token_budget: 200_000,
            defect_budget: 3,
            subclaim_budget: 6,
            residual_budget: 2,
        },
        evidence_ceiling: S06_003_EVIDENCE_CEILING.to_owned(),
        exact_write_surface: S06_003_WRITE_SURFACE
            .iter()
            .map(|path| (*path).to_owned())
            .collect(),
        producer_id: S06_003_PRODUCER_ID.to_owned(),
        evaluator_id: S06_003_EVALUATOR_ID.to_owned(),
        authority_witness_id: S06_003_AUTHORITY_WITNESS_ID.to_owned(),
        prior_work_ledger: vec![
            "S06-001 bounded receipt-DAG verification; authority None".to_owned(),
            "S06-002 bounded GTOC-4 transition coverage; lift residual preserved".to_owned(),
            "S14-005 GTOC-5 construction receipt absent at frozen base".to_owned(),
            "gtoc_gtla_run_receipt.rs partial-repair aggregate semantics".to_owned(),
        ],
        promotion_constructor_available: false,
        authorized_local_result_constructor_available: false,
        authority_effect: AuthorityEffect::None,
    }
}

pub fn canonical_s06_003_receipt_v1() -> Result<Gtoc6DefectTerminalizationReceiptV1, Gtoc6Error> {
    let packet = canonical_s06_003_packet_v1();
    let defects = vec![
        Gtoc6DefectDiagnosticV1 {
            sequence: 0,
            defect_id: "defect:s06-003:gtoc4-predecessor".to_owned(),
            subclaims: vec![
                subclaim_receipt_v1(
                    0,
                    "subclaim:s06-003:gtoc4-verification-bound",
                    DiagnosticEvidenceV1::PredecessorVerification {
                        artifact_path: S06_002_VERIFICATION_PATH.to_owned(),
                        verified: true,
                    },
                    "artifact:s06-002:gtoc4-verification",
                    Vec::new(),
                    GtocTerminal::ExactRepair,
                ),
                subclaim_receipt_v1(
                    1,
                    "subclaim:s06-003:gtoc4-lift-residual-carried",
                    DiagnosticEvidenceV1::ResidualCarryForward {
                        source_residual_id: S06_002_LIFT_RESIDUAL_ID.to_owned(),
                        preserved: true,
                    },
                    "residual:s06-002:lift-license-not-issued",
                    vec![S06_002_LIFT_RESIDUAL_ID.to_owned()],
                    GtocTerminal::StabilizedSurvivor,
                ),
            ],
            residual_ids: vec![S06_002_LIFT_RESIDUAL_ID.to_owned()],
            claimed_terminal: GtocTerminal::StabilizedSurvivor,
        },
        Gtoc6DefectDiagnosticV1 {
            sequence: 1,
            defect_id: "defect:s06-003:gtoc5-authority-path".to_owned(),
            subclaims: vec![subclaim_receipt_v1(
                0,
                "subclaim:s06-003:gtoc5-construction-receipt",
                DiagnosticEvidenceV1::DependencyReceipt {
                    receipt_id: "S14-005:GTOC-5".to_owned(),
                    present: false,
                    verified: false,
                },
                "dependency:S14-005:GTOC-5",
                vec![S06_003_GTOC5_RESIDUAL_ID.to_owned()],
                GtocTerminal::OpenObstruction,
            )],
            residual_ids: vec![S06_003_GTOC5_RESIDUAL_ID.to_owned()],
            claimed_terminal: GtocTerminal::OpenObstruction,
        },
        Gtoc6DefectDiagnosticV1 {
            sequence: 2,
            defect_id: "defect:s06-003:aggregation-kernel".to_owned(),
            subclaims: vec![
                invariant_subclaim_receipt_v1(
                    0,
                    "subclaim:s06-003:defect-id-uniqueness",
                    "invariant:s06-003:defect-id-uniqueness",
                ),
                invariant_subclaim_receipt_v1(
                    1,
                    "subclaim:s06-003:residual-conservation",
                    "invariant:s06-003:residual-conservation",
                ),
                invariant_subclaim_receipt_v1(
                    2,
                    "subclaim:s06-003:terminal-derivation",
                    "invariant:s06-003:terminal-derivation",
                ),
            ],
            residual_ids: Vec::new(),
            claimed_terminal: GtocTerminal::ExactRepair,
        },
    ];
    let residual_ledger = vec![
        Gtoc6ResidualLedgerEntryV1 {
            residual_id: S06_002_LIFT_RESIDUAL_ID.to_owned(),
            defect_id: "defect:s06-003:gtoc4-predecessor".to_owned(),
            subclaim_id: "subclaim:s06-003:gtoc4-lift-residual-carried".to_owned(),
            terminal: GtocTerminal::StabilizedSurvivor,
            survivor_route: SurvivorRouteV1::CarryForward,
        },
        Gtoc6ResidualLedgerEntryV1 {
            residual_id: S06_003_GTOC5_RESIDUAL_ID.to_owned(),
            defect_id: "defect:s06-003:gtoc5-authority-path".to_owned(),
            subclaim_id: "subclaim:s06-003:gtoc5-construction-receipt".to_owned(),
            terminal: GtocTerminal::OpenObstruction,
            survivor_route: SurvivorRouteV1::ProofObligation,
        },
    ];
    Ok(Gtoc6DefectTerminalizationReceiptV1 {
        schema_version: GTOC6_RECEIPT_SCHEMA_VERSION.to_owned(),
        packet_id: packet.packet_id.clone(),
        packet_sha256: gtoc6_packet_sha256_v1(&packet)?,
        producer_id: S06_003_PRODUCER_ID.to_owned(),
        defects,
        residual_ledger,
        claimed_terminal: GtocTerminal::StabilizedSurvivor,
        promotion_requested: false,
        promotion_constructor_called: false,
        authorized_local_result_created: false,
        authority_effect: AuthorityEffect::None,
    })
}

pub fn classify_gtoc6_diagnostic_v1(
    rule: DiagnosticRuleV1,
    evidence: &DiagnosticEvidenceV1,
) -> Result<Gtoc6DiagnosticOutcomeV1, Gtoc6Error> {
    let outcome = match (rule, evidence) {
        (
            DiagnosticRuleV1::PredecessorVerification,
            DiagnosticEvidenceV1::PredecessorVerification { verified, .. },
        ) => Gtoc6DiagnosticOutcomeV1 {
            terminal: if *verified {
                GtocTerminal::ExactRepair
            } else {
                GtocTerminal::Invalid
            },
            survivor_route: None,
        },
        (
            DiagnosticRuleV1::ResidualCarryForward,
            DiagnosticEvidenceV1::ResidualCarryForward { preserved, .. },
        ) => Gtoc6DiagnosticOutcomeV1 {
            terminal: if *preserved {
                GtocTerminal::StabilizedSurvivor
            } else {
                GtocTerminal::Invalid
            },
            survivor_route: preserved.then_some(SurvivorRouteV1::CarryForward),
        },
        (
            DiagnosticRuleV1::DependencyReceipt,
            DiagnosticEvidenceV1::DependencyReceipt {
                present, verified, ..
            },
        ) => match (*present, *verified) {
            (true, true) => Gtoc6DiagnosticOutcomeV1 {
                terminal: GtocTerminal::ExactRepair,
                survivor_route: None,
            },
            (false, false) => Gtoc6DiagnosticOutcomeV1 {
                terminal: GtocTerminal::OpenObstruction,
                survivor_route: Some(SurvivorRouteV1::ProofObligation),
            },
            _ => Gtoc6DiagnosticOutcomeV1 {
                terminal: GtocTerminal::Invalid,
                survivor_route: None,
            },
        },
        (DiagnosticRuleV1::InvariantCheck, DiagnosticEvidenceV1::InvariantCheck { passed, .. }) => {
            Gtoc6DiagnosticOutcomeV1 {
                terminal: if *passed {
                    GtocTerminal::ExactRepair
                } else {
                    GtocTerminal::Invalid
                },
                survivor_route: None,
            }
        }
        (DiagnosticRuleV1::Unavailable, DiagnosticEvidenceV1::RuleUnavailable { rule_id }) => {
            require_text("diagnostic.rule_id", rule_id)?;
            Gtoc6DiagnosticOutcomeV1 {
                terminal: GtocTerminal::OpenObstruction,
                survivor_route: Some(SurvivorRouteV1::OperatorNeeded),
            }
        }
        _ => {
            return Err(Gtoc6Error::DiagnosticEvidenceMismatch(
                "rule/evidence variant".to_owned(),
            ))
        }
    };
    Ok(outcome)
}

pub fn aggregate_gtoc6_terminals_v1(
    terminals: &[GtocTerminal],
) -> Result<GtocTerminal, Gtoc6Error> {
    if terminals.is_empty() {
        return Err(Gtoc6Error::EmptyTerminalSet);
    }
    let mut exact = 0;
    let mut stabilized = 0;
    let mut open = 0;
    let mut lift = 0;
    let mut oracle = 0;
    let mut refused = 0;
    let mut invalid = 0;
    let mut infrastructure = 0;
    for terminal in terminals {
        match terminal {
            GtocTerminal::ExactRepair => exact += 1,
            GtocTerminal::StabilizedSurvivor => stabilized += 1,
            GtocTerminal::OpenObstruction => open += 1,
            GtocTerminal::LiftLicenseNeeded => lift += 1,
            GtocTerminal::OracleNeeded => oracle += 1,
            GtocTerminal::Refused => refused += 1,
            GtocTerminal::Invalid => invalid += 1,
            GtocTerminal::InfrastructureFailure => infrastructure += 1,
        }
    }

    if infrastructure > 0 {
        return Ok(GtocTerminal::InfrastructureFailure);
    }
    if invalid > 0 {
        return Ok(GtocTerminal::Invalid);
    }
    if refused > 0 {
        return Ok(GtocTerminal::Refused);
    }
    if oracle > 0 {
        return Ok(GtocTerminal::OracleNeeded);
    }
    if lift > 0 {
        return Ok(GtocTerminal::LiftLicenseNeeded);
    }
    if open > 0 && exact > 0 {
        Ok(GtocTerminal::StabilizedSurvivor)
    } else if open > 0 {
        Ok(GtocTerminal::OpenObstruction)
    } else if stabilized > 0 {
        Ok(GtocTerminal::StabilizedSurvivor)
    } else {
        Ok(GtocTerminal::ExactRepair)
    }
}

pub fn verify_gtoc6_defect_terminalization_v1(
    packet: &Gtoc6DefectTerminalizationPacketV1,
    receipt: &Gtoc6DefectTerminalizationReceiptV1,
    artifact_bytes: &Gtoc6ArtifactBytesV1,
) -> Result<Gtoc6DefectTerminalizationVerificationV1, Gtoc6Error> {
    if packet != &canonical_s06_003_packet_v1() {
        return Err(Gtoc6Error::PacketDrift);
    }
    if packet.schema_version != GTOC6_PACKET_SCHEMA_VERSION
        || packet.observer_sha256 != gtoc6_observer_sha256_v1(&packet.observer)?
        || packet.producer_id == packet.evaluator_id
        || packet.producer_id == packet.authority_witness_id
        || packet.evaluator_id == packet.authority_witness_id
        || !packet.authority_effect.is_none()
        || !packet.observer.authority_effect.is_none()
        || packet.promotion_constructor_available
        || packet.authorized_local_result_constructor_available
        || packet.observer.promotion_constructor_available
        || packet
            .observer
            .authorized_local_result_constructor_available
    {
        return Err(Gtoc6Error::PacketBoundaryChanged);
    }
    let packet_sha256 = gtoc6_packet_sha256_v1(packet)?;
    if receipt.schema_version != GTOC6_RECEIPT_SCHEMA_VERSION
        || receipt.packet_id != packet.packet_id
        || receipt.packet_sha256 != packet_sha256
        || receipt.producer_id != packet.producer_id
    {
        return Err(Gtoc6Error::ReceiptBindingMismatch);
    }
    if !receipt.authority_effect.is_none()
        || receipt.promotion_requested
        || receipt.promotion_constructor_called
        || receipt.authorized_local_result_created
    {
        return Err(Gtoc6Error::AuthorityExpanded);
    }

    verify_s06_002_artifact_v1(packet, artifact_bytes)?;
    verify_truth_table_v1(&packet.aggregation_truth_table)?;

    if receipt.defects.len() != packet.defects.len() {
        return Err(Gtoc6Error::DefectCountMismatch {
            expected: packet.defects.len(),
            found: receipt.defects.len(),
        });
    }
    if receipt.defects.len() > packet.budgets.defect_budget as usize {
        return Err(Gtoc6Error::DefectCountMismatch {
            expected: packet.budgets.defect_budget as usize,
            found: receipt.defects.len(),
        });
    }
    let mut defect_ids = BTreeSet::new();
    let mut subclaim_ids = BTreeSet::new();
    let mut residual_ids = BTreeSet::new();
    let mut expected_ledger = Vec::new();
    let mut defect_evidence = Vec::new();
    let mut total_subclaims = 0_usize;

    for (spec, defect) in packet.defects.iter().zip(&receipt.defects) {
        if !defect_ids.insert(defect.defect_id.clone()) {
            return Err(Gtoc6Error::DuplicateDefectId(defect.defect_id.clone()));
        }
        if defect.sequence != spec.sequence || defect.defect_id != spec.defect_id {
            return Err(Gtoc6Error::DefectAttributionMismatch(
                spec.defect_id.clone(),
            ));
        }
        if defect.subclaims.len() != spec.subclaims.len() {
            return Err(Gtoc6Error::SubclaimCountMismatch {
                defect_id: defect.defect_id.clone(),
                expected: spec.subclaims.len(),
                found: defect.subclaims.len(),
            });
        }
        total_subclaims += defect.subclaims.len();
        if total_subclaims > packet.budgets.subclaim_budget as usize {
            return Err(Gtoc6Error::SubclaimCountMismatch {
                defect_id: defect.defect_id.clone(),
                expected: packet.budgets.subclaim_budget as usize,
                found: total_subclaims,
            });
        }

        let mut local_terminals = Vec::with_capacity(defect.subclaims.len());
        let mut local_residuals = Vec::new();
        for (subclaim_spec, subclaim) in spec.subclaims.iter().zip(&defect.subclaims) {
            if !subclaim_ids.insert(subclaim.subclaim_id.clone()) {
                return Err(Gtoc6Error::DuplicateSubclaimId(
                    subclaim.subclaim_id.clone(),
                ));
            }
            if subclaim.sequence != subclaim_spec.sequence
                || subclaim.subclaim_id != subclaim_spec.subclaim_id
            {
                return Err(Gtoc6Error::SubclaimAttributionMismatch(
                    subclaim_spec.subclaim_id.clone(),
                ));
            }
            if subclaim.evidence != expected_evidence_v1(&subclaim_spec.subclaim_id)?
                || subclaim.evidence_refs != [subclaim_spec.evidence_ref.clone()]
            {
                return Err(Gtoc6Error::DiagnosticEvidenceMismatch(
                    subclaim.subclaim_id.clone(),
                ));
            }
            let outcome = classify_gtoc6_diagnostic_v1(subclaim_spec.rule, &subclaim.evidence)?;
            if outcome.terminal == GtocTerminal::Invalid {
                return Err(Gtoc6Error::InvalidDiagnostic(subclaim.subclaim_id.clone()));
            }
            if outcome.terminal != subclaim.claimed_terminal {
                return Err(Gtoc6Error::SubclaimTerminalMismatch {
                    subclaim_id: subclaim.subclaim_id.clone(),
                    expected: outcome.terminal,
                    found: subclaim.claimed_terminal,
                });
            }
            let expected_subclaim_residuals = subclaim_spec
                .expected_residual_id
                .iter()
                .cloned()
                .collect::<Vec<_>>();
            if subclaim.residual_ids != expected_subclaim_residuals
                || outcome.survivor_route != subclaim_spec.expected_survivor_route
            {
                return Err(Gtoc6Error::SubclaimResidualMismatch(
                    subclaim.subclaim_id.clone(),
                ));
            }
            if let Some(residual_id) = &subclaim_spec.expected_residual_id {
                if !residual_ids.insert(residual_id.clone()) {
                    return Err(Gtoc6Error::DuplicateResidualId(residual_id.clone()));
                }
                local_residuals.push(residual_id.clone());
                expected_ledger.push(Gtoc6ResidualLedgerEntryV1 {
                    residual_id: residual_id.clone(),
                    defect_id: defect.defect_id.clone(),
                    subclaim_id: subclaim.subclaim_id.clone(),
                    terminal: outcome.terminal,
                    survivor_route: outcome
                        .survivor_route
                        .expect("residual-bearing diagnostics require a survivor route"),
                });
            }
            local_terminals.push(outcome.terminal);
        }

        local_residuals.sort();
        if defect.residual_ids != local_residuals {
            return Err(Gtoc6Error::DefectResidualMismatch(defect.defect_id.clone()));
        }
        let terminal = aggregate_gtoc6_terminals_v1(&local_terminals)?;
        if defect.claimed_terminal != terminal {
            return Err(Gtoc6Error::DefectTerminalMismatch {
                defect_id: defect.defect_id.clone(),
                expected: terminal,
                found: defect.claimed_terminal,
            });
        }
        defect_evidence.push(Gtoc6DefectVerificationEvidenceV1 {
            sequence: defect.sequence,
            defect_id: defect.defect_id.clone(),
            subclaim_terminals: local_terminals,
            residual_ids: local_residuals,
            terminal,
        });
    }

    expected_ledger.sort_by(|left, right| left.residual_id.cmp(&right.residual_id));
    if expected_ledger.len() > packet.budgets.residual_budget as usize {
        return Err(Gtoc6Error::ResidualLedgerMismatch);
    }
    if receipt.residual_ledger != expected_ledger {
        return Err(Gtoc6Error::ResidualLedgerMismatch);
    }
    let defect_terminals = defect_evidence
        .iter()
        .map(|defect| defect.terminal)
        .collect::<Vec<_>>();
    let terminal = aggregate_gtoc6_terminals_v1(&defect_terminals)?;
    if receipt.claimed_terminal != terminal {
        return Err(Gtoc6Error::AggregateTerminalMismatch {
            expected: terminal,
            found: receipt.claimed_terminal,
        });
    }

    let residual_ids = expected_ledger
        .iter()
        .map(|entry| entry.residual_id.clone())
        .collect::<Vec<_>>();
    Ok(Gtoc6DefectTerminalizationVerificationV1 {
        schema_version: GTOC6_VERIFICATION_SCHEMA_VERSION.to_owned(),
        packet_id: packet.packet_id.clone(),
        packet_sha256,
        observer_sha256: packet.observer_sha256.clone(),
        receipt_sha256: gtoc6_receipt_sha256_v1(receipt)?,
        artifact_closure_sha256: sha256_json_v1(&packet.input_artifacts)?,
        diagnostic_matrix_sha256: sha256_json_v1(&receipt.defects)?,
        residual_ledger_sha256: sha256_json_v1(&receipt.residual_ledger)?,
        aggregation_truth_table_sha256: sha256_json_v1(&packet.aggregation_truth_table)?,
        evaluator_id: packet.evaluator_id.clone(),
        authority_witness_id: packet.authority_witness_id.clone(),
        defect_count: receipt.defects.len() as u32,
        subclaim_count: total_subclaims as u32,
        residual_count: residual_ids.len() as u32,
        defect_evidence,
        every_defect_classified_once: true,
        every_subclaim_classified_once: true,
        every_local_terminal_recomputed: true,
        every_residual_conserved: true,
        aggregation_truth_table_replayed: true,
        aggregation_permutation_invariant: true,
        predecessor_receipt_verified: true,
        gtoc5_dependency_receipt_present: false,
        gtoc5_dependency_preserved_as_residual: residual_ids
            .contains(&S06_003_GTOC5_RESIDUAL_ID.to_owned()),
        residual_ids,
        terminal,
        promotion_requested: false,
        promotion_constructor_called: false,
        authorized_local_result_created: false,
        authority_effect: AuthorityEffect::None,
    })
}

pub fn gtoc6_packet_sha256_v1(
    packet: &Gtoc6DefectTerminalizationPacketV1,
) -> Result<String, Gtoc6Error> {
    sha256_json_v1(packet)
}

pub fn gtoc6_receipt_sha256_v1(
    receipt: &Gtoc6DefectTerminalizationReceiptV1,
) -> Result<String, Gtoc6Error> {
    sha256_json_v1(receipt)
}

pub fn gtoc6_verification_sha256_v1(
    verification: &Gtoc6DefectTerminalizationVerificationV1,
) -> Result<String, Gtoc6Error> {
    sha256_json_v1(verification)
}

pub fn gtoc6_observer_sha256_v1(observer: &FrozenGtoc6ObserverV1) -> Result<String, Gtoc6Error> {
    sha256_json_v1(observer)
}

pub fn canonical_gtoc6_json_line_v1<T: Serialize + ?Sized>(
    value: &T,
) -> Result<Vec<u8>, Gtoc6Error> {
    let mut bytes = serde_json::to_vec(value).map_err(json_error)?;
    bytes.push(b'\n');
    Ok(bytes)
}

pub fn parse_gtoc6_packet_canonical_v1(
    bytes: &[u8],
) -> Result<Gtoc6DefectTerminalizationPacketV1, Gtoc6Error> {
    parse_canonical_json_line_v1(bytes, "GTOC-6 packet")
}

pub fn parse_gtoc6_receipt_canonical_v1(
    bytes: &[u8],
) -> Result<Gtoc6DefectTerminalizationReceiptV1, Gtoc6Error> {
    parse_canonical_json_line_v1(bytes, "GTOC-6 receipt")
}

pub fn parse_gtoc6_verification_canonical_v1(
    bytes: &[u8],
) -> Result<Gtoc6DefectTerminalizationVerificationV1, Gtoc6Error> {
    parse_canonical_json_line_v1(bytes, "GTOC-6 verification")
}

fn canonical_defect_specs_v1() -> Vec<Gtoc6DefectSpecV1> {
    vec![
        Gtoc6DefectSpecV1 {
            sequence: 0,
            defect_id: "defect:s06-003:gtoc4-predecessor".to_owned(),
            subclaims: vec![
                subclaim_spec_v1(
                    0,
                    "subclaim:s06-003:gtoc4-verification-bound",
                    DiagnosticRuleV1::PredecessorVerification,
                    "artifact:s06-002:gtoc4-verification",
                    None,
                    None,
                ),
                subclaim_spec_v1(
                    1,
                    "subclaim:s06-003:gtoc4-lift-residual-carried",
                    DiagnosticRuleV1::ResidualCarryForward,
                    "residual:s06-002:lift-license-not-issued",
                    Some(S06_002_LIFT_RESIDUAL_ID),
                    Some(SurvivorRouteV1::CarryForward),
                ),
            ],
        },
        Gtoc6DefectSpecV1 {
            sequence: 1,
            defect_id: "defect:s06-003:gtoc5-authority-path".to_owned(),
            subclaims: vec![subclaim_spec_v1(
                0,
                "subclaim:s06-003:gtoc5-construction-receipt",
                DiagnosticRuleV1::DependencyReceipt,
                "dependency:S14-005:GTOC-5",
                Some(S06_003_GTOC5_RESIDUAL_ID),
                Some(SurvivorRouteV1::ProofObligation),
            )],
        },
        Gtoc6DefectSpecV1 {
            sequence: 2,
            defect_id: "defect:s06-003:aggregation-kernel".to_owned(),
            subclaims: vec![
                subclaim_spec_v1(
                    0,
                    "subclaim:s06-003:defect-id-uniqueness",
                    DiagnosticRuleV1::InvariantCheck,
                    "invariant:s06-003:defect-id-uniqueness",
                    None,
                    None,
                ),
                subclaim_spec_v1(
                    1,
                    "subclaim:s06-003:residual-conservation",
                    DiagnosticRuleV1::InvariantCheck,
                    "invariant:s06-003:residual-conservation",
                    None,
                    None,
                ),
                subclaim_spec_v1(
                    2,
                    "subclaim:s06-003:terminal-derivation",
                    DiagnosticRuleV1::InvariantCheck,
                    "invariant:s06-003:terminal-derivation",
                    None,
                    None,
                ),
            ],
        },
    ]
}

fn canonical_aggregation_truth_table_v1() -> Vec<AggregationTruthRowV1> {
    use GtocTerminal as T;
    vec![
        truth_row_v1("truth:exact-only", vec![T::ExactRepair], T::ExactRepair),
        truth_row_v1(
            "truth:stabilized-only",
            vec![T::StabilizedSurvivor],
            T::StabilizedSurvivor,
        ),
        truth_row_v1(
            "truth:open-only",
            vec![T::OpenObstruction],
            T::OpenObstruction,
        ),
        truth_row_v1(
            "truth:partial-repair-open",
            vec![T::ExactRepair, T::OpenObstruction],
            T::StabilizedSurvivor,
        ),
        truth_row_v1(
            "truth:stabilized-plus-open",
            vec![T::StabilizedSurvivor, T::OpenObstruction],
            T::OpenObstruction,
        ),
        truth_row_v1(
            "truth:partial-repair-mixed-survivors",
            vec![T::ExactRepair, T::StabilizedSurvivor, T::OpenObstruction],
            T::StabilizedSurvivor,
        ),
        truth_row_v1(
            "truth:lift-dominates-trichotomy",
            vec![T::ExactRepair, T::LiftLicenseNeeded],
            T::LiftLicenseNeeded,
        ),
        truth_row_v1(
            "truth:oracle-dominates-lift",
            vec![T::LiftLicenseNeeded, T::OracleNeeded],
            T::OracleNeeded,
        ),
        truth_row_v1(
            "truth:refusal-dominates-oracle",
            vec![T::OracleNeeded, T::Refused],
            T::Refused,
        ),
        truth_row_v1(
            "truth:invalid-dominates-refusal",
            vec![T::Refused, T::Invalid],
            T::Invalid,
        ),
        truth_row_v1(
            "truth:infrastructure-dominates-invalid",
            vec![T::Invalid, T::InfrastructureFailure],
            T::InfrastructureFailure,
        ),
    ]
}

fn verify_truth_table_v1(rows: &[AggregationTruthRowV1]) -> Result<(), Gtoc6Error> {
    let mut row_ids = BTreeSet::new();
    for row in rows {
        require_text("aggregation.row_id", &row.row_id)?;
        if !row_ids.insert(row.row_id.clone()) {
            return Err(Gtoc6Error::AggregationTruthMismatch(row.row_id.clone()));
        }
        if aggregate_gtoc6_terminals_v1(&row.local_terminals)? != row.expected_aggregate {
            return Err(Gtoc6Error::AggregationTruthMismatch(row.row_id.clone()));
        }
        let mut reversed = row.local_terminals.clone();
        reversed.reverse();
        if aggregate_gtoc6_terminals_v1(&reversed)? != row.expected_aggregate {
            return Err(Gtoc6Error::AggregationTruthMismatch(row.row_id.clone()));
        }
    }
    Ok(())
}

fn verify_s06_002_artifact_v1(
    packet: &Gtoc6DefectTerminalizationPacketV1,
    artifact_bytes: &Gtoc6ArtifactBytesV1,
) -> Result<Gtoc4TransitionCoverageVerificationV1, Gtoc6Error> {
    let expected_paths = packet
        .input_artifacts
        .iter()
        .map(|artifact| artifact.path.as_str())
        .collect::<BTreeSet<_>>();
    let found_paths = artifact_bytes
        .keys()
        .map(String::as_str)
        .collect::<BTreeSet<_>>();
    if expected_paths != found_paths {
        if let Some(path) = expected_paths.difference(&found_paths).next() {
            return Err(Gtoc6Error::MissingArtifact((*path).to_owned()));
        }
        return Err(Gtoc6Error::ArtifactSetMismatch);
    }
    for artifact in &packet.input_artifacts {
        let bytes = artifact_bytes
            .get(&artifact.path)
            .ok_or_else(|| Gtoc6Error::MissingArtifact(artifact.path.clone()))?;
        if bytes.len() as u64 != artifact.bytes {
            return Err(Gtoc6Error::ArtifactLengthMismatch(artifact.path.clone()));
        }
        if sha256_bytes_v1(bytes) != artifact.sha256 {
            return Err(Gtoc6Error::ArtifactHashMismatch(artifact.path.clone()));
        }
    }
    let bytes = artifact_bytes
        .get(S06_002_VERIFICATION_PATH)
        .ok_or_else(|| Gtoc6Error::MissingArtifact(S06_002_VERIFICATION_PATH.to_owned()))?;
    let verification = parse_gtoc4_verification_canonical_v1(bytes)
        .map_err(|error| Gtoc6Error::InvalidPredecessor(error.to_string()))?;
    let valid = verification.terminal == GtocTerminal::StabilizedSurvivor
        && verification.predecessor_receipts_verified
        && verification.every_alphabet_operation_covered_once
        && verification.every_operation_law_replayed
        && verification.every_refusal_immutable
        && verification.unknown_classes_refused
        && verification.residual_ids == [S06_002_LIFT_RESIDUAL_ID.to_owned()]
        && !verification.promotion_requested
        && !verification.promotion_constructor_called
        && !verification.authorized_local_result_created
        && verification.authority_effect.is_none();
    if !valid {
        return Err(Gtoc6Error::InvalidPredecessor(
            "S06-002 verification boundary mismatch".to_owned(),
        ));
    }
    Ok(verification)
}

fn expected_evidence_v1(subclaim_id: &str) -> Result<DiagnosticEvidenceV1, Gtoc6Error> {
    let evidence = match subclaim_id {
        "subclaim:s06-003:gtoc4-verification-bound" => {
            DiagnosticEvidenceV1::PredecessorVerification {
                artifact_path: S06_002_VERIFICATION_PATH.to_owned(),
                verified: true,
            }
        }
        "subclaim:s06-003:gtoc4-lift-residual-carried" => {
            DiagnosticEvidenceV1::ResidualCarryForward {
                source_residual_id: S06_002_LIFT_RESIDUAL_ID.to_owned(),
                preserved: true,
            }
        }
        "subclaim:s06-003:gtoc5-construction-receipt" => DiagnosticEvidenceV1::DependencyReceipt {
            receipt_id: "S14-005:GTOC-5".to_owned(),
            present: false,
            verified: false,
        },
        "subclaim:s06-003:defect-id-uniqueness" => DiagnosticEvidenceV1::InvariantCheck {
            invariant_id: "invariant:s06-003:defect-id-uniqueness".to_owned(),
            passed: true,
        },
        "subclaim:s06-003:residual-conservation" => DiagnosticEvidenceV1::InvariantCheck {
            invariant_id: "invariant:s06-003:residual-conservation".to_owned(),
            passed: true,
        },
        "subclaim:s06-003:terminal-derivation" => DiagnosticEvidenceV1::InvariantCheck {
            invariant_id: "invariant:s06-003:terminal-derivation".to_owned(),
            passed: true,
        },
        _ => {
            return Err(Gtoc6Error::DiagnosticEvidenceMismatch(
                subclaim_id.to_owned(),
            ))
        }
    };
    Ok(evidence)
}

fn subclaim_spec_v1(
    sequence: u32,
    subclaim_id: &str,
    rule: DiagnosticRuleV1,
    evidence_ref: &str,
    residual_id: Option<&str>,
    survivor_route: Option<SurvivorRouteV1>,
) -> Gtoc6SubclaimSpecV1 {
    Gtoc6SubclaimSpecV1 {
        sequence,
        subclaim_id: subclaim_id.to_owned(),
        rule,
        evidence_ref: evidence_ref.to_owned(),
        expected_residual_id: residual_id.map(str::to_owned),
        expected_survivor_route: survivor_route,
    }
}

fn subclaim_receipt_v1(
    sequence: u32,
    subclaim_id: &str,
    evidence: DiagnosticEvidenceV1,
    evidence_ref: &str,
    residual_ids: Vec<String>,
    claimed_terminal: GtocTerminal,
) -> Gtoc6SubclaimDiagnosticV1 {
    Gtoc6SubclaimDiagnosticV1 {
        sequence,
        subclaim_id: subclaim_id.to_owned(),
        evidence,
        evidence_refs: vec![evidence_ref.to_owned()],
        residual_ids,
        claimed_terminal,
    }
}

fn invariant_subclaim_receipt_v1(
    sequence: u32,
    subclaim_id: &str,
    invariant_id: &str,
) -> Gtoc6SubclaimDiagnosticV1 {
    subclaim_receipt_v1(
        sequence,
        subclaim_id,
        DiagnosticEvidenceV1::InvariantCheck {
            invariant_id: invariant_id.to_owned(),
            passed: true,
        },
        invariant_id,
        Vec::new(),
        GtocTerminal::ExactRepair,
    )
}

fn truth_row_v1(
    row_id: &str,
    local_terminals: Vec<GtocTerminal>,
    expected_aggregate: GtocTerminal,
) -> AggregationTruthRowV1 {
    AggregationTruthRowV1 {
        row_id: row_id.to_owned(),
        local_terminals,
        expected_aggregate,
    }
}

fn parse_canonical_json_line_v1<T>(bytes: &[u8], label: &str) -> Result<T, Gtoc6Error>
where
    T: DeserializeOwned + Serialize,
{
    if bytes.len() < 2 || bytes.last() != Some(&b'\n') || bytes[..bytes.len() - 1].contains(&b'\n')
    {
        return Err(Gtoc6Error::NonCanonicalJson(label.to_owned()));
    }
    let value = serde_json::from_slice::<T>(&bytes[..bytes.len() - 1]).map_err(decode_error)?;
    if canonical_gtoc6_json_line_v1(&value)? != bytes {
        return Err(Gtoc6Error::NonCanonicalJson(label.to_owned()));
    }
    Ok(value)
}

fn sha256_json_v1<T: Serialize + ?Sized>(value: &T) -> Result<String, Gtoc6Error> {
    let bytes = serde_json::to_vec(value).map_err(json_error)?;
    Ok(sha256_bytes_v1(&bytes))
}

fn sha256_bytes_v1(bytes: &[u8]) -> String {
    format!("{:x}", Sha256::digest(bytes))
}

fn json_error(error: serde_json::Error) -> Gtoc6Error {
    Gtoc6Error::Json(error.to_string())
}

fn decode_error(error: serde_json::Error) -> Gtoc6Error {
    Gtoc6Error::Decode(error.to_string())
}

fn require_text(field: &str, value: &str) -> Result<(), Gtoc6Error> {
    if value.trim().is_empty() {
        return Err(Gtoc6Error::EmptyField(field.to_owned()));
    }
    Ok(())
}
