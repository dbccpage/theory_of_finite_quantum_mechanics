[package]
name = "omega_state"
version = "0.1.0"
edition = "2021"

[dependencies]
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
linear_algebra = { path = "../omega_linear_algebra" }
omega_homological = { path = "../omega_homological" }
omega_types = { path = "../omega_types" }
omega_contracts = { path = "../omega_contracts" }
omega_discrete_deformation_algebra = { path = "../omega_discrete_deformation_algebra" }
omega_lifts = { path = "../omega_lifts" }
sha2 = "0.10"
thiserror = "2"
