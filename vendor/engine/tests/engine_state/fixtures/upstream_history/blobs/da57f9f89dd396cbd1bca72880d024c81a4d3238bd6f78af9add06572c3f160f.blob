#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
#[serde(deny_unknown_fields)]
pub struct ProtocolTraceV1 {
    pub schema_version: String,
    pub task_id: String,
    pub carrier_hash: String,
    pub observer: FrozenObserverContextV1,
    pub initial_residual_ids: BTreeSet<String>,
    pub license_ids: BTreeSet<String>,
    pub receipts: Vec<TransitionReceiptV1>,
}

#[derive(Debug, Clone)]
pub struct ProtocolMachineV1 {
    state: ProtocolStateV1,
    initial_residual_ids: BTreeSet<String>,
    receipts: Vec<TransitionReceiptV1>,
}

impl ProtocolMachineV1 {
    pub fn new(
        task_id: impl Into<String>,
        carrier_hash: impl Into<String>,
        observer: FrozenObserverContextV1,
        residual_ids: BTreeSet<String>,
        license_ids: BTreeSet<String>,
    ) -> Result<Self, ProtocolError> {
        let task_id = task_id.into();
        let carrier_hash = carrier_hash.into();
        require_text("state.task_id", &task_id)?;
        require_hash("state.carrier_hash", &carrier_hash)?;
        observer.validate()?;
        validate_ids("state.residual_ids", &residual_ids)?;
        validate_ids("state.license_ids", &license_ids)?;

        Ok(Self {
            state: ProtocolStateV1 {
                schema_version: PROTOCOL_SCHEMA_VERSION.to_owned(),
                task_id,
                current_stage: GtocGtlaStage::Carrier,
                carrier_hash,
                observer,
                residual_ids: residual_ids.clone(),
                license_ids,
                terminal_proposal: None,
                authority_effect: AuthorityEffect::None,
            },
            initial_residual_ids: residual_ids,
            receipts: Vec::new(),
        })
    }

    pub fn state(&self) -> &ProtocolStateV1 {
        &self.state
    }

    pub fn is_terminalized(&self) -> bool {
        self.state.current_stage == GtocGtlaStage::PriorWorkLedger
            && self.state.terminal_proposal.is_some()
            && self.state.authority_effect.is_none()
    }

    pub fn advance(
        &mut self,
        proposal: TransitionProposalV1,
    ) -> Result<TransitionReceiptV1, ProtocolError> {
        let from_stage = self.state.current_stage;
        let expected = from_stage
            .next()
            .ok_or(ProtocolError::AlreadyTerminalized)?;
        if proposal.to_stage != expected {
            return Err(ProtocolError::SkippedStage {
                from: from_stage,
                expected,
                found: proposal.to_stage,
            });
        }
        if proposal.observer_hash != self.state.observer.observer_hash {
            return Err(ProtocolError::ObserverChanged);
        }
        if proposal.state_domain != self.state.observer.state_domain {
            return Err(ProtocolError::StateDomainChanged);
        }
        validate_ids("proposal.residual_ids", &proposal.residual_ids)?;
        if let Some(lost) = self
            .state
            .residual_ids
            .difference(&proposal.residual_ids)
            .next()
        {
            return Err(ProtocolError::ResidualLost(lost.clone()));
        }
        validate_ids("proposal.license_ids", &proposal.license_ids)?;
        if proposal.license_ids != self.state.license_ids {
            return Err(ProtocolError::LicenseSetChanged);
        }
        if !proposal.authority_effect.is_none() || !self.state.authority_effect.is_none() {
            return Err(ProtocolError::AuthorityExpanded);
        }
        require_nonempty_texts("proposal.evidence_refs", &proposal.evidence_refs)?;
        validate_terminal_transition(&self.state, &proposal)?;

        let receipt = TransitionReceiptV1 {
            sequence: from_stage.ordinal(),
            from_stage,
            to_stage: proposal.to_stage,
            observer_hash: proposal.observer_hash,
            state_domain: proposal.state_domain,
            residual_ids: proposal.residual_ids.clone(),
            license_ids: proposal.license_ids.clone(),
            terminal_proposal: proposal.terminal_proposal,
            authority_effect: proposal.authority_effect.clone(),
            evidence_refs: proposal.evidence_refs,
        };
        self.state.current_stage = proposal.to_stage;
        self.state.residual_ids = proposal.residual_ids;
        self.state.terminal_proposal = proposal.terminal_proposal;
        self.state.authority_effect = proposal.authority_effect;
        self.receipts.push(receipt.clone());
        Ok(receipt)
    }

    pub fn into_trace(self) -> ProtocolTraceV1 {
        ProtocolTraceV1 {
            schema_version: PROTOCOL_SCHEMA_VERSION.to_owned(),
            task_id: self.state.task_id,
            carrier_hash: self.state.carrier_hash,
            observer: self.state.observer,
            initial_residual_ids: self.initial_residual_ids,
            license_ids: self.state.license_ids,
            receipts: self.receipts,
        }
    }
}

fn validate_terminal_transition(
    state: &ProtocolStateV1,
    proposal: &TransitionProposalV1,
) -> Result<(), ProtocolError> {
    match proposal.to_stage {
        GtocGtlaStage::TerminalProposal => {
            let terminal = proposal
                .terminal_proposal
                .ok_or(ProtocolError::MissingTerminal)?;
            let residual_count = proposal.residual_ids.len();
            if (terminal == GtocTerminal::ExactRepair && residual_count != 0)
                || (matches!(
                    terminal,
                    GtocTerminal::StabilizedSurvivor | GtocTerminal::OpenObstruction
                ) && residual_count == 0)
            {
                return Err(ProtocolError::TerminalResidualMismatch {
                    terminal,
                    residual_count,
                });
            }
        }
        GtocGtlaStage::PriorWorkLedger => {
            if state.terminal_proposal.is_none() {
                return Err(ProtocolError::MissingTerminal);
            }
            if proposal.terminal_proposal != state.terminal_proposal {
                return Err(ProtocolError::TerminalChanged);
            }
        }
        _ if proposal.terminal_proposal.is_some() => return Err(ProtocolError::EarlyTerminal),
        _ => {}
    }
    Ok(())
}

#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, Serialize, Deserialize)]
#[serde(rename_all = "snake_case")]
pub enum CompositionFailureKindV1 {
    EdgeDiscontinuity,
    SkippedStage,
    ObserverChanged,
    StateDomainChanged,
    ResidualLost,
    LicenseSetChanged,
    TerminalChanged,
    AuthorityExpanded,
}

#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
#[serde(deny_unknown_fields)]
pub struct CompositionFailureV1 {
    pub left_sequence: u8,
    pub right_sequence: u8,
    pub kind: CompositionFailureKindV1,
}

#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
#[serde(deny_unknown_fields)]
pub struct StructuralCochainReceiptV1 {
    pub realization: CochainRealizationKind,
    pub edge_count: usize,
    pub composition_count: usize,
    pub failures: Vec<CompositionFailureV1>,
}

#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
#[serde(deny_unknown_fields)]
pub struct TraceValidationReceiptV1 {
    pub schema_version: String,
    pub transition_count: usize,
    pub terminal: GtocTerminal,
    pub authority_effect: AuthorityEffect,
    pub cochain: StructuralCochainReceiptV1,
}

pub fn structural_d1_v1(
    left: &TransitionReceiptV1,
    right: &TransitionReceiptV1,
) -> Vec<CompositionFailureV1> {
    let mut failures = Vec::new();
    let mut push = |kind| {
        failures.push(CompositionFailureV1 {
            left_sequence: left.sequence,
            right_sequence: right.sequence,
            kind,
        });
    };
    if left.to_stage != right.from_stage || left.sequence + 1 != right.sequence {
        push(CompositionFailureKindV1::EdgeDiscontinuity);
    }
    if left.to_stage.next() != Some(right.to_stage) {
        push(CompositionFailureKindV1::SkippedStage);
    }
    if left.observer_hash != right.observer_hash {
        push(CompositionFailureKindV1::ObserverChanged);
    }
    if left.state_domain != right.state_domain {
        push(CompositionFailureKindV1::StateDomainChanged);
    }
    if !left.residual_ids.is_subset(&right.residual_ids) {
        push(CompositionFailureKindV1::ResidualLost);
    }
    if left.license_ids != right.license_ids {
        push(CompositionFailureKindV1::LicenseSetChanged);
    }
    if left.terminal_proposal.is_some() && left.terminal_proposal != right.terminal_proposal {
        push(CompositionFailureKindV1::TerminalChanged);
    }
    if !left.authority_effect.is_none() || !right.authority_effect.is_none() {
        push(CompositionFailureKindV1::AuthorityExpanded);
    }
    failures
}

pub fn structural_cochain_receipt_v1(trace: &ProtocolTraceV1) -> StructuralCochainReceiptV1 {
    let failures = trace
        .receipts
        .windows(2)
        .flat_map(|pair| structural_d1_v1(&pair[0], &pair[1]))
        .collect();
    StructuralCochainReceiptV1 {
        realization: CochainRealizationKind::Structural,
        edge_count: trace.receipts.len(),
        composition_count: trace.receipts.len().saturating_sub(1),
        failures,
    }
}

pub fn validate_protocol_trace_v1(
    trace: &ProtocolTraceV1,
) -> Result<TraceValidationReceiptV1, ProtocolError> {
    require_schema(PROTOCOL_SCHEMA_VERSION, &trace.schema_version)?;
    let mut machine = ProtocolMachineV1::new(
        trace.task_id.clone(),
        trace.carrier_hash.clone(),
        trace.observer.clone(),
        trace.initial_residual_ids.clone(),
        trace.license_ids.clone(),
    )?;
    for supplied in &trace.receipts {
        let produced = machine.advance(TransitionProposalV1 {
            to_stage: supplied.to_stage,
            observer_hash: supplied.observer_hash.clone(),
            state_domain: supplied.state_domain.clone(),
            residual_ids: supplied.residual_ids.clone(),
            license_ids: supplied.license_ids.clone(),
            terminal_proposal: supplied.terminal_proposal,
            authority_effect: supplied.authority_effect.clone(),
            evidence_refs: supplied.evidence_refs.clone(),
        })?;
        if &produced != supplied {
            return Err(ProtocolError::ReceiptMismatch(supplied.sequence));
        }
    }
    if !machine.is_terminalized() {
        return Err(ProtocolError::TraceNotTerminalized);
    }
    let terminal = machine
        .state()
        .terminal_proposal
        .ok_or(ProtocolError::TraceNotTerminalized)?;
    let cochain = structural_cochain_receipt_v1(trace);
    if !cochain.failures.is_empty() {
        return Err(ProtocolError::StructuralCompositionFailure(
            cochain.failures.len(),
        ));
    }
    Ok(TraceValidationReceiptV1 {
        schema_version: PROTOCOL_SCHEMA_VERSION.to_owned(),
        transition_count: trace.receipts.len(),
        terminal,
        authority_effect: AuthorityEffect::None,
        cochain,
    })
}

#[derive(Debug, Error, Clone, PartialEq, Eq)]
pub enum ProtocolError {
    #[error("schema version mismatch: expected {expected}, found {found}")]
    SchemaVersion { expected: String, found: String },
    #[error("required field is empty: {0}")]
    EmptyField(&'static str),
    #[error("invalid SHA-256 field: {0}")]
    InvalidHash(&'static str),
    #[error("compiled stage count mismatch: expected {expected}, found {found}")]
    StageCount { expected: usize, found: usize },
    #[error("compiled stage order mismatch: expected {expected:?}, found {found:?}")]
    StageOrder {
        expected: GtocGtlaStage,
        found: GtocGtlaStage,
    },
    #[error(
        "legacy classification {classification:?} disagrees with terminalization {terminalization:?}"
    )]
    LegacyTerminalMismatch {
        classification: GtocTerminal,
        terminalization: GtocTerminal,
    },
    #[error("stage transition skipped: {from:?} expected {expected:?}, found {found:?}")]
    SkippedStage {
        from: GtocGtlaStage,
        expected: GtocGtlaStage,
        found: GtocGtlaStage,
    },
    #[error("frozen observer changed")]
    ObserverChanged,
    #[error("frozen state domain changed")]
    StateDomainChanged,
    #[error("residual disappeared from the append-only ledger: {0}")]
    ResidualLost(String),
    #[error("license set changed after packet freeze")]
    LicenseSetChanged,
    #[error("terminal proposal appeared before stage 11")]
    EarlyTerminal,
    #[error("stage 11 requires one terminal proposal")]
    MissingTerminal,
    #[error("terminal proposal changed after stage 11")]
    TerminalChanged,
    #[error("terminal {terminal:?} is incompatible with {residual_count} residuals")]
    TerminalResidualMismatch {
        terminal: GtocTerminal,
        residual_count: usize,
    },
    #[error("protocol transition attempted to expand authority")]
    AuthorityExpanded,
    #[error("protocol already terminalized")]
    AlreadyTerminalized,
    #[error("receipt {0} does not match deterministic replay")]
    ReceiptMismatch(u8),
    #[error("trace did not reach stage 12 with a terminal proposal")]
    TraceNotTerminalized,
    #[error("structural d1 o d0 validation found {0} composition failures")]
    StructuralCompositionFailure(usize),
}

impl ProtocolError {
    pub fn terminal_route(&self) -> GtocTerminal {
        match self {
            Self::EmptyField(field)
                if field.starts_with("context.") || field.starts_with("observer.") =>
            {
                GtocTerminal::OracleNeeded
            }
            Self::AuthorityExpanded => GtocTerminal::Refused,
            _ => GtocTerminal::Invalid,
        }
    }
}

fn compiled_stage(
    stage: GtocGtlaStage,
    sources: Vec<ProtocolSourceV1>,
    payloads: Vec<String>,
) -> CompiledStageV1 {
    CompiledStageV1 {
        stage,
        sources,
        payloads,
    }
}

const fn legacy(field: LegacyPacketFieldV1) -> ProtocolSourceV1 {
    ProtocolSourceV1::Legacy(field)
}

const fn context_source(field: CompileContextFieldV1) -> ProtocolSourceV1 {
    ProtocolSourceV1::Context(field)
}

fn require_schema(expected: &str, found: &str) -> Result<(), ProtocolError> {
    if expected == found {
        Ok(())
    } else {
        Err(ProtocolError::SchemaVersion {
            expected: expected.to_owned(),
            found: found.to_owned(),
        })
    }
}

fn require_text(field: &'static str, value: &str) -> Result<(), ProtocolError> {
    if value.trim().is_empty() {
        Err(ProtocolError::EmptyField(field))
    } else {
        Ok(())
    }
}

fn require_texts(field: &'static str, values: &[String]) -> Result<(), ProtocolError> {
    for value in values {
        require_text(field, value)?;
    }
    Ok(())
}

fn require_nonempty_texts(field: &'static str, values: &[String]) -> Result<(), ProtocolError> {
    if values.is_empty() {
        return Err(ProtocolError::EmptyField(field));
    }
    require_texts(field, values)
}

fn require_hash(field: &'static str, value: &str) -> Result<(), ProtocolError> {
    if value.len() == 64 && value.bytes().all(|byte| byte.is_ascii_hexdigit()) {
        Ok(())
    } else {
        Err(ProtocolError::InvalidHash(field))
    }
}

fn validate_ids(field: &'static str, ids: &BTreeSet<String>) -> Result<(), ProtocolError> {
    for id in ids {
        require_text(field, id)?;
    }
    Ok(())
}
