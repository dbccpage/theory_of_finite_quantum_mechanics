}

#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
#[serde(deny_unknown_fields)]
pub struct LegacyDdaExecutionV1 {
    pub licensed_transformation: String,
    pub survivor_routing: String,
}

#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
#[serde(deny_unknown_fields)]
pub struct LegacyPacketV1 {
    pub schema_version: String,
    pub carrier: String,
    pub c0: String,
    pub d0: String,
    pub c1: String,
    pub zero_rel: String,
    pub q1: String,
    pub d1: String,
    pub gamma2: Vec<String>,
    pub phi1: Vec<String>,
    pub classification: GtocTerminal,
    pub licensed_lift: LegacyLiftV1,
    pub dda_execution: LegacyDdaExecutionV1,
    pub terminalization: GtocTerminal,
}

impl LegacyPacketV1 {
    fn validate(&self) -> Result<(), ProtocolError> {
        require_schema(LEGACY_PACKET_SCHEMA_VERSION, &self.schema_version)?;
        for (field, value) in [
            ("legacy.carrier", self.carrier.as_str()),
            ("legacy.c0", self.c0.as_str()),
            ("legacy.d0", self.d0.as_str()),
            ("legacy.c1", self.c1.as_str()),
            ("legacy.zero_rel", self.zero_rel.as_str()),
            ("legacy.q1", self.q1.as_str()),
            ("legacy.d1", self.d1.as_str()),
            (
                "legacy.dda_execution.licensed_transformation",
                self.dda_execution.licensed_transformation.as_str(),
            ),
            (
                "legacy.dda_execution.survivor_routing",
                self.dda_execution.survivor_routing.as_str(),
            ),
        ] {
            require_text(field, value)?;
        }
        require_nonempty_texts("legacy.gamma2", &self.gamma2)?;
        require_nonempty_texts("legacy.phi1", &self.phi1)?;
        if let LegacyLiftV1::License(license_id) = &self.licensed_lift {
            require_text("legacy.licensed_lift", license_id)?;
        }
        if self.classification != self.terminalization {
            return Err(ProtocolError::LegacyTerminalMismatch {
                classification: self.classification,
                terminalization: self.terminalization,
            });
        }
        Ok(())
    }
}

#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
#[serde(deny_unknown_fields)]
pub struct LegacyCompileContextV1 {
    pub primitive_difference: String,
    pub realization: CochainRealizationKind,
    pub c2: String,
    pub d1_d0_witness: String,
    pub observer: FrozenObserverContextV1,
    pub witnesses: Vec<String>,
    pub prior_work_ledger: Vec<String>,
}

impl LegacyCompileContextV1 {
    fn validate(&self) -> Result<(), ProtocolError> {
        require_text("context.primitive_difference", &self.primitive_difference)?;
        require_text("context.c2", &self.c2)?;
        require_text("context.d1_d0_witness", &self.d1_d0_witness)?;
        self.observer.validate()?;
        require_nonempty_texts("context.witnesses", &self.witnesses)?;
        require_nonempty_texts("context.prior_work_ledger", &self.prior_work_ledger)
    }
}

#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
#[serde(deny_unknown_fields)]
pub struct CompiledStageV1 {
    pub stage: GtocGtlaStage,
    pub sources: Vec<ProtocolSourceV1>,
    pub payloads: Vec<String>,
}

#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
#[serde(deny_unknown_fields)]
pub struct CompiledProtocolV1 {
    pub schema_version: String,
    pub stages: Vec<CompiledStageV1>,
}

impl CompiledProtocolV1 {
    pub fn validate(&self) -> Result<(), ProtocolError> {
        require_schema(PROTOCOL_SCHEMA_VERSION, &self.schema_version)?;
        if self.stages.len() != GtocGtlaStage::ALL.len() {
            return Err(ProtocolError::StageCount {
                expected: GtocGtlaStage::ALL.len(),
                found: self.stages.len(),
            });
        }
        for (index, expected) in GtocGtlaStage::ALL.iter().copied().enumerate() {
            let stage = &self.stages[index];
            if stage.stage != expected {
                return Err(ProtocolError::StageOrder {
                    expected,
                    found: stage.stage,
                });
            }
            if stage.sources.is_empty() {
                return Err(ProtocolError::EmptyField("compiled_stage.sources"));
            }
            require_nonempty_texts("compiled_stage.payloads", &stage.payloads)?;
        }
        Ok(())
    }

    pub fn stage(&self, stage: GtocGtlaStage) -> &CompiledStageV1 {
        &self.stages[usize::from(stage.ordinal() - 1)]
    }
}

#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, Serialize, Deserialize)]
#[serde(rename_all = "snake_case")]
pub enum LegacyAdapterLimitationV1 {
    PrimitiveDifferenceRequiresContext,
    C2AndCompositionWitnessRequireContext,
    ObserverRequiresContext,
    WitnessesRequireContext,
    PriorWorkLedgerRequiresContext,
    DdaExecutionSplitsAcrossStagesNineAndTen,
    ClassificationAndTerminalizationMustAgreeAtStageEleven,
    StructuralCompilationDoesNotProveMathematicalCochains,
}

#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
#[serde(deny_unknown_fields)]
pub struct StageSourceReceiptV1 {
    pub stage: GtocGtlaStage,
    pub sources: Vec<ProtocolSourceV1>,
}

#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
#[serde(deny_unknown_fields)]
pub struct LegacyCompileReceiptV1 {
    pub source_schema_version: String,
    pub target_schema_version: String,
    pub legacy_field_count: usize,
    pub stage_sources: Vec<StageSourceReceiptV1>,
    pub limitations: Vec<LegacyAdapterLimitationV1>,
    pub authority_effect: AuthorityEffect,
}

#[derive(Debug, Clone, PartialEq, Eq)]
pub struct LegacyCompileOutputV1 {
    pub protocol: CompiledProtocolV1,
    pub receipt: LegacyCompileReceiptV1,
}

pub fn compile_legacy_packet_v1(
    packet: &LegacyPacketV1,
    context: &LegacyCompileContextV1,
) -> Result<LegacyCompileOutputV1, ProtocolError> {
    packet.validate()?;
    context.validate()?;

    let lift_payload = match &packet.licensed_lift {
        LegacyLiftV1::NoneDeclared => "no lift declared".to_owned(),
        LegacyLiftV1::License(license_id) => format!("lift license: {license_id}"),
    };
    let mut residual_payloads = packet
        .gamma2
        .iter()
        .map(|value| format!("Gamma2: {value}"))
        .collect::<Vec<_>>();
    residual_payloads.extend(packet.phi1.iter().map(|value| format!("Phi1: {value}")));

    let stages = vec![
        compiled_stage(
            GtocGtlaStage::Carrier,
            vec![legacy(LegacyPacketFieldV1::Carrier)],
            vec![packet.carrier.clone()],
        ),
        compiled_stage(
            GtocGtlaStage::PrimitiveDifference,
            vec![context_source(CompileContextFieldV1::PrimitiveDifference)],
            vec![context.primitive_difference.clone()],
        ),
        compiled_stage(
            GtocGtlaStage::ZeroRelation,
            vec![legacy(LegacyPacketFieldV1::ZeroRel)],
            vec![packet.zero_rel.clone()],
        ),
        compiled_stage(
            GtocGtlaStage::CochainRealization,
            vec![
                legacy(LegacyPacketFieldV1::C0),
                legacy(LegacyPacketFieldV1::D0),
                legacy(LegacyPacketFieldV1::C1),
                legacy(LegacyPacketFieldV1::D1),
                context_source(CompileContextFieldV1::C2),
                context_source(CompileContextFieldV1::D1D0Witness),
            ],
            vec![
                format!("realization: {:?}", context.realization),
                packet.c0.clone(),
                packet.d0.clone(),
                packet.c1.clone(),
                packet.d1.clone(),
                context.c2.clone(),
                context.d1_d0_witness.clone(),
            ],
        ),
        compiled_stage(
            GtocGtlaStage::Quotient,
            vec![legacy(LegacyPacketFieldV1::Q1)],
            vec![packet.q1.clone()],
        ),
        compiled_stage(
            GtocGtlaStage::ResidualSeparation,
            vec![
                legacy(LegacyPacketFieldV1::Gamma2),
                legacy(LegacyPacketFieldV1::Phi1),
            ],
            residual_payloads,
        ),
        compiled_stage(
            GtocGtlaStage::Observer,
            vec![context_source(CompileContextFieldV1::Observer)],
            vec![
                format!("observer_id: {}", context.observer.observer_id),
                format!("observer_domain: {}", context.observer.observer_domain),
                format!("state_domain: {}", context.observer.state_domain),
                format!("observer_hash: {}", context.observer.observer_hash),
            ],
        ),
        compiled_stage(
            GtocGtlaStage::Witnesses,
            vec![context_source(CompileContextFieldV1::Witnesses)],
            context.witnesses.clone(),
        ),
        compiled_stage(
            GtocGtlaStage::LicensedTransformation,
            vec![
                legacy(LegacyPacketFieldV1::LicensedLift),
                legacy(LegacyPacketFieldV1::DdaExecution),
            ],
            vec![
                lift_payload,
                packet.dda_execution.licensed_transformation.clone(),
            ],
        ),
        compiled_stage(
            GtocGtlaStage::SurvivorRouting,
            vec![legacy(LegacyPacketFieldV1::DdaExecution)],
            vec![packet.dda_execution.survivor_routing.clone()],
        ),
        compiled_stage(
            GtocGtlaStage::TerminalProposal,
            vec![
                legacy(LegacyPacketFieldV1::Classification),
                legacy(LegacyPacketFieldV1::Terminalization),
            ],
            vec![format!("terminal: {:?}", packet.classification)],
        ),
        compiled_stage(
            GtocGtlaStage::PriorWorkLedger,
            vec![context_source(CompileContextFieldV1::PriorWorkLedger)],
            context.prior_work_ledger.clone(),
        ),
    ];
    let protocol = CompiledProtocolV1 {
        schema_version: PROTOCOL_SCHEMA_VERSION.to_owned(),
        stages,
    };
    protocol.validate()?;

    let receipt = LegacyCompileReceiptV1 {
        source_schema_version: LEGACY_PACKET_SCHEMA_VERSION.to_owned(),
        target_schema_version: PROTOCOL_SCHEMA_VERSION.to_owned(),
        legacy_field_count: LegacyPacketFieldV1::ALL.len(),
        stage_sources: protocol
            .stages
            .iter()
            .map(|stage| StageSourceReceiptV1 {
                stage: stage.stage,
                sources: stage.sources.clone(),
            })
            .collect(),
        limitations: vec![
            LegacyAdapterLimitationV1::PrimitiveDifferenceRequiresContext,
            LegacyAdapterLimitationV1::C2AndCompositionWitnessRequireContext,
            LegacyAdapterLimitationV1::ObserverRequiresContext,
            LegacyAdapterLimitationV1::WitnessesRequireContext,
            LegacyAdapterLimitationV1::PriorWorkLedgerRequiresContext,
            LegacyAdapterLimitationV1::DdaExecutionSplitsAcrossStagesNineAndTen,
            LegacyAdapterLimitationV1::ClassificationAndTerminalizationMustAgreeAtStageEleven,
            LegacyAdapterLimitationV1::StructuralCompilationDoesNotProveMathematicalCochains,
        ],
        authority_effect: AuthorityEffect::None,
    };
    Ok(LegacyCompileOutputV1 { protocol, receipt })
}

#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
#[serde(deny_unknown_fields)]
pub struct ProtocolSchemaReceiptV1 {
    pub schema_version: String,
    pub stages: Vec<GtocGtlaStage>,
    pub terminals: Vec<GtocTerminal>,
    pub legacy_schema_version: String,
    pub legacy_fields: Vec<LegacyPacketFieldV1>,
    pub authority_effect: AuthorityEffect,
}

pub fn protocol_schema_receipt_v1() -> ProtocolSchemaReceiptV1 {
    ProtocolSchemaReceiptV1 {
        schema_version: PROTOCOL_SCHEMA_VERSION.to_owned(),
        stages: GtocGtlaStage::ALL.to_vec(),
        terminals: GtocTerminal::ALL.to_vec(),
        legacy_schema_version: LEGACY_PACKET_SCHEMA_VERSION.to_owned(),
        legacy_fields: LegacyPacketFieldV1::ALL.to_vec(),
        authority_effect: AuthorityEffect::None,
    }
}

