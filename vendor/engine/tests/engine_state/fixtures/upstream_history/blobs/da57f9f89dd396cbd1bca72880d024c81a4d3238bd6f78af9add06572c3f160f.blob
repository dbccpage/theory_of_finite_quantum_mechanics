//! Canonical structural GTOC/GTLA execution protocol.
//!
//! This module validates protocol shape, legacy-field compilation, transition
//! ordering, frozen-observer preservation, residual monotonicity, terminal
//! compatibility, and the non-authority ceiling. It does not prove a
//! mathematical cochain realization or promote a result.

use std::collections::BTreeSet;

use omega_types::authority::AuthorityEffect;
use serde::{Deserialize, Serialize};
use thiserror::Error;

pub const PROTOCOL_SCHEMA_VERSION: &str = "omega.gtoc-gtla.protocol.v1";
pub const LEGACY_PACKET_SCHEMA_VERSION: &str = "omega.gtoc-gtla.legacy-packet.v1";

#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, Serialize, Deserialize)]
#[serde(rename_all = "snake_case")]
pub enum GtocGtlaStage {
    Carrier,
    PrimitiveDifference,
    ZeroRelation,
    CochainRealization,
    Quotient,
    ResidualSeparation,
    Observer,
    Witnesses,
    LicensedTransformation,
    SurvivorRouting,
    TerminalProposal,
    PriorWorkLedger,
}

impl GtocGtlaStage {
    pub const ALL: [Self; 12] = [
        Self::Carrier,
        Self::PrimitiveDifference,
        Self::ZeroRelation,
        Self::CochainRealization,
        Self::Quotient,
        Self::ResidualSeparation,
        Self::Observer,
        Self::Witnesses,
        Self::LicensedTransformation,
        Self::SurvivorRouting,
        Self::TerminalProposal,
        Self::PriorWorkLedger,
    ];

    pub const fn ordinal(self) -> u8 {
        match self {
            Self::Carrier => 1,
            Self::PrimitiveDifference => 2,
            Self::ZeroRelation => 3,
            Self::CochainRealization => 4,
            Self::Quotient => 5,
            Self::ResidualSeparation => 6,
            Self::Observer => 7,
            Self::Witnesses => 8,
            Self::LicensedTransformation => 9,
            Self::SurvivorRouting => 10,
            Self::TerminalProposal => 11,
            Self::PriorWorkLedger => 12,
        }
    }

    pub const fn next(self) -> Option<Self> {
        match self {
            Self::Carrier => Some(Self::PrimitiveDifference),
            Self::PrimitiveDifference => Some(Self::ZeroRelation),
            Self::ZeroRelation => Some(Self::CochainRealization),
            Self::CochainRealization => Some(Self::Quotient),
            Self::Quotient => Some(Self::ResidualSeparation),
            Self::ResidualSeparation => Some(Self::Observer),
            Self::Observer => Some(Self::Witnesses),
            Self::Witnesses => Some(Self::LicensedTransformation),
            Self::LicensedTransformation => Some(Self::SurvivorRouting),
            Self::SurvivorRouting => Some(Self::TerminalProposal),
            Self::TerminalProposal => Some(Self::PriorWorkLedger),
            Self::PriorWorkLedger => None,
        }
    }
}

#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, Serialize, Deserialize)]
pub enum GtocTerminal {
    ExactRepair,
    StabilizedSurvivor,
    OpenObstruction,
    OracleNeeded,
    LiftLicenseNeeded,
    Refused,
    Invalid,
    InfrastructureFailure,
}

impl GtocTerminal {
    pub const ALL: [Self; 8] = [
        Self::ExactRepair,
        Self::StabilizedSurvivor,
        Self::OpenObstruction,
        Self::OracleNeeded,
        Self::LiftLicenseNeeded,
        Self::Refused,
        Self::Invalid,
        Self::InfrastructureFailure,
    ];
}

#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, Serialize, Deserialize)]
pub enum CochainRealizationKind {
    Exact,
    Structural,
    Unresolved,
}

#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
#[serde(deny_unknown_fields)]
pub struct FrozenObserverContextV1 {
    pub observer_id: String,
    pub observer_domain: String,
    pub state_domain: String,
    pub observer_hash: String,
    pub visible_artifact_hashes: Vec<String>,
    pub hidden_artifact_classes: Vec<String>,
    pub tool_permissions: Vec<String>,
    pub write_surface: Vec<String>,
    pub evidence_ceiling: String,
}

impl FrozenObserverContextV1 {
    pub fn validate(&self) -> Result<(), ProtocolError> {
        require_text("observer.observer_id", &self.observer_id)?;
        require_text("observer.observer_domain", &self.observer_domain)?;
        require_text("observer.state_domain", &self.state_domain)?;
        require_hash("observer.observer_hash", &self.observer_hash)?;
        require_text("observer.evidence_ceiling", &self.evidence_ceiling)?;
        require_nonempty_texts("observer.tool_permissions", &self.tool_permissions)?;
        require_nonempty_texts("observer.write_surface", &self.write_surface)?;
        for hash in &self.visible_artifact_hashes {
            require_hash("observer.visible_artifact_hashes", hash)?;
        }
        require_texts(
            "observer.hidden_artifact_classes",
            &self.hidden_artifact_classes,
        )
    }
}

