}

impl TransitionProposalV1 {
    pub fn preserving(state: &ProtocolStateV1, to_stage: GtocGtlaStage) -> Self {
        Self {
            to_stage,
            observer_hash: state.observer.observer_hash.clone(),
            state_domain: state.observer.state_domain.clone(),
            residual_ids: state.residual_ids.clone(),
            license_ids: state.license_ids.clone(),
            terminal_proposal: state.terminal_proposal,
            authority_effect: AuthorityEffect::None,
            evidence_refs: vec![format!("evidence:stage-{}", to_stage.ordinal())],
        }
    }
}

