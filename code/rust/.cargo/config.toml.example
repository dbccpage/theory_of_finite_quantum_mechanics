# Copy this file to `code/rust/.cargo/config.toml` (gitignored) and adjust
# the `<ENGINE_CRATES_DIR>` and `<ENGINE_ATLAS_DIR>` placeholders when building with `--features external-omega`.

[patch.crates-io]
constants = { path = "<ENGINE_CRATES_DIR>/constants" }
finite_qm_native = { path = "<ENGINE_ATLAS_DIR>/finite_qm_native" }
linear_algebra = { path = "<ENGINE_CRATES_DIR>/omega_linear_algebra" }
omega_certifiers = { path = "<ENGINE_CRATES_DIR>/omega_certifiers" }
omega_combinatorics = { path = "<ENGINE_CRATES_DIR>/omega_combinatorics" }
omega_contracts = { path = "<ENGINE_CRATES_DIR>/omega_contracts" }
omega_engines = { path = "<ENGINE_CRATES_DIR>/omega_engines" }
omega_functional = { path = "<ENGINE_CRATES_DIR>/omega_functional" }
omega_general_relativity = { path = "<ENGINE_CRATES_DIR>/omega_general_relativity" }
omega_holonomy = { path = "<ENGINE_CRATES_DIR>/omega_holonomy" }
omega_homology = { path = "<ENGINE_CRATES_DIR>/omega_homology" }
omega_kernel = { path = "<ENGINE_CRATES_DIR>/omega_kernel" }
omega_lie_theory = { path = "<ENGINE_CRATES_DIR>/omega_lie_theory" }
omega_measurement = { path = "<ENGINE_CRATES_DIR>/omega_measurement" }
omega_number_theory = { path = "<ENGINE_CRATES_DIR>/omega_number_theory" }
omega_ooutwire_primitives = { path = "<ENGINE_CRATES_DIR>/omega_ooutwire_primitives" }
omega_pipelines = { path = "<ENGINE_CRATES_DIR>/omega_pipelines" }
omega_policy = { path = "<ENGINE_CRATES_DIR>/omega_policy" }
omega_quantum_physics = { path = "<ENGINE_CRATES_DIR>/omega_quantum_physics" }
omega_replay = { path = "<ENGINE_CRATES_DIR>/omega_replay" }
omega_solvers = { path = "<ENGINE_CRATES_DIR>/omega_solvers" }
omega_state = { path = "<ENGINE_CRATES_DIR>/omega_state" }
omega_symbol_game_runtime = { path = "<ENGINE_CRATES_DIR>/omega_symbol_game_runtime" }
omega_types = { path = "<ENGINE_CRATES_DIR>/omega_types" }
omega_wdp = { path = "<ENGINE_CRATES_DIR>/omega_wdp" }
